# Caddyfile（IP 模式）—— 由 tools/dsh-remote/cloud/relay.sh 渲染
#
# 给"没有域名"或者"域名没备案（大陆 80/443 要备案）"的情况用：
# 换一个高端口 + Caddy 自带 CA 签的自签证书。
# 浏览器第一次会警告"证书不受信任" —— 点"继续访问"就行，流量照样是加密的，
# basic auth 的密码不会明文过网。想要没有警告：上域名 + 备案，或把服务器
# 放香港/新加坡（那边不要求备案）。
#
# {{...}} 是占位符，别手改这一份。

{
	admin 127.0.0.1:2019
	# 同上：别去占宿主 :80（见 Caddyfile.domain 里的说明）
	auto_https disable_redirects
	# **IP 模式必须有这一行**：浏览器连 https://<IP>:8443 时**不会发 SNI**
	# （RFC 6066 不允许 SNI 里放 IP 字面量），Caddy 没有 SNI 就选不出证书，
	# 握手直接 Internal Error（curl 报 SSL_ERROR_SYSCALL / openssl 报 alert 80）。
	# 2026-10-07 在真阿里云上实测撞到；加 default_sni 后不带 SNI 的握手才通。
	# 域名模式不需要它（域名本来就会进 SNI）。
	default_sni {{IP}}
}

{{IP}}:{{PORT}} {
	tls internal

	encode zstd gzip

	basic_auth {
		{{USER}} {{HASH}}
	}

{{ALLOW_BLOCK}}
	# ---------------------------------------------------------------- token 重定向
	# 手机收藏的固定地址（https://<入口>/，不带 token）交给家里的 token broker，
	# 由它 302 到 /?token=<当前值>（token 每个进程随机、只在内存里，只有家里知道；
	# 见 docs/adr/0014-*.md）。两条 not 缺一不可：
	#   not query token=*            带 token 的请求要直连 dsh web；
	#   not header Cookie *dsh-auth-* 已经换到 cookie 的浏览器也要直连 dsh web ——
	#     dsh web 用 token 换一个 30 天的签名 cookie，之后 / 不再需要 token。
	#     不排除 cookie 就是死循环：/ → broker → /?token → (set-cookie, 303 ./) → / → …
	@entry {
		path /
		not query token=*
		not header Cookie *dsh-auth-*
	}
	reverse_proxy @entry 127.0.0.1:{{BROKER_PORT}} {
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
	}

	# /go：任何时候都 302 到 /?token=<当前值> —— cookie 过期（默认 30 天）或者家里
	# 换过 token 之后的"重进一次"入口。手机用户只需要再点一下这个地址。
	@go path /go
	reverse_proxy @go 127.0.0.1:{{BROKER_PORT}} {
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
	}

	# 其余请求（会话界面 / SSE / WebSocket / 带 token 或带 cookie 的 /）
	# 一律直连家里的 dsh web —— broker 不参与主链路。
	reverse_proxy 127.0.0.1:{{TUNNEL_PORT}} {
		# 同域名模式：把 Host/Origin 伪装成回环，绕过 dsh web 的浏览器信任围栏，
		# 这样不用重启 harness。安全完全压在 basic auth + TLS 上。
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
		header_up Origin http://127.0.0.1:{{LOCAL_PORT}}
		header_up Referer http://127.0.0.1:{{LOCAL_PORT}}/

		flush_interval -1
		transport http {
			read_timeout 0
		}
	}

	log {
		output file /var/log/caddy/dsh-access.log
		format console
	}
}
