# Caddyfile（域名模式）—— 由 tools/dsh-remote/cloud/relay.sh 渲染
#
# {{...}} 是占位符，别手改这一份；改脚本或改模板。
#
# 手机 → https://{{DOMAIN}} → basic auth → 云上 127.0.0.1:{{TUNNEL_PORT}}
#      →（SSH 反向隧道）→ 家里 127.0.0.1:{{LOCAL_PORT}}

{
	email {{EMAIL}}
	admin 127.0.0.1:2019
	# 不自动做 http→https 跳转：那会让 Caddy 额外去监听宿主 :80，
	# 服务器上 80 被别的服务占着（或者大陆机器没备案根本用不了 80）时
	# 容器会直接起不来（实测：listen tcp :80: bind: address already in use，
	# 然后 restart 循环）。手机收藏的是 https 地址，不需要这个跳转。
	auto_https disable_redirects
}

{{DOMAIN}} {
	encode zstd gzip

	basic_auth {
		{{USER}} {{HASH}}
	}

{{ALLOW_BLOCK}}
	# ---------------------------------------------------------------- token 重定向
	# 手机收藏的固定地址（https://<入口>/，不带 token）交给家里的 token broker
	# （token 每个进程随机、只在内存里，只有家里知道；见 docs/adr/0014-*.md）。
	# broker 那边分两种：没有 dsh-auth-* cookie → 302 到 /?token=<当前值>；
	# 带 cookie → 它拿这条 cookie 探一次 dsh web，有效就把这一条 GET / 的响应
	# 代发回来（会话/SSE/WebSocket 仍然直连，不经过它）。
	# **"cookie 还有效吗"这里判不了**：Caddy 只会看"有没有 Cookie 这个头"，不会验签，
	# 所以**不能**写 `not header Cookie *dsh-auth-*` —— 那样带着过期 cookie 的浏览器
	# 永远拿不到跳转，只看到 dsh web 的 401（2026-10-09 用户手机实测；ADR-0018）。
	# 这里只排除带 token 的请求：那种请求直接打 dsh web，broker 只管补 token。
	@entry {
		path /
		not query token=*
	}
	reverse_proxy @entry 127.0.0.1:{{BROKER_PORT}} {
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
	}

	# /go：任何时候都 302 到 /?token=<当前值> —— cookie 过期（默认 30 天）或者家里
	# 换过 token 之后的"重进一次"入口。手机用户只需要再点一下这个地址。
	@go path /go
	reverse_proxy @go 127.0.0.1:{{BROKER_PORT}} {
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
	}

	# 其余请求（带 token 的 /、会话界面、SSE、WebSocket）
	# 一律直连家里的 dsh web —— broker 不参与主链路。
	reverse_proxy 127.0.0.1:{{TUNNEL_PORT}} {
		# 关键：把 Host/Origin 改成回环地址。
		# dsh web 有一道"浏览器信任围栏"，只认回环/本机 LAN/--trusted-host；
		# 这么写就不用给 harness 加参数、也不用重启它（重启会打断正在跑的会话）。
		# 代价：harness 分不清请求是本地还是远程 —— 所以对外**只有** Caddy 的
		# basic auth + TLS 这一道门，密码必须长且随机。
		header_up Host 127.0.0.1:{{LOCAL_PORT}}
		header_up Origin http://127.0.0.1:{{LOCAL_PORT}}
		header_up Referer http://127.0.0.1:{{LOCAL_PORT}}/

		# 会话界面是流式的：立刻 flush，别攒着
		flush_interval -1
		transport http {
			read_timeout 0
		}
	}

	log {
		output file /var/log/caddy/dsh-access.log
		format console
	}
}
