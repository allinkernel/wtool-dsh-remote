# remote.conf —— 家这一侧（隧道 + 手机地址）的配置（样板）
#
# 位置：~/.config/dsh-remote/remote.conf（默认；用户级，不进任何仓库）
# 日志在 ~/.local/state/dsh-remote/。~/.dsh 是 DSH 自己的目录，我们只往里放
# 一段 profile patch（harness 规定只能放那儿）。
# dsh-remote 的所有子命令都读它。

# --------------------------------------------------------------- 阿里云那台
# 安全组要放你**家里的出口 IP** 访问 22（动态 IP 的话就把变化当成一次维护）
cloud_host=1.2.3.4
cloud_user=root
cloud_ssh_port=22

# 隧道用的私钥（家 → 云）。建议专门配一把，只允许它端口转发：
#   ~/.ssh/authorized_keys 里写成
#   restrict,port-forwarding,permitlisten="127.0.0.1:18080" ssh-ed25519 AAAA... dsh-remote
# ⚠️ 写哪一把必须和云上 authorized_keys 对上：写错的后果不对等 ——
#    前台 `dsh-remote tunnel` 可能"碰巧还能连"（不带 -i 时 ssh 会按默认顺序试别的钥匙），
#    而 systemd 单元里带了 `-i`，会直接 Permission denied 然后每 3 秒重试一次（hazards H16）。
identity=~/.ssh/id_rsa

# 云上只绑 127.0.0.1 的隧道端口（Caddy 反代它）。**别在安全组里开放它**
remote_port=18080

# 家里 harness 的端口（dsh web 听的）
local_port=3080

# 断线重连间隔（秒）——**只给前台 `dsh-remote tunnel` 用**。
# 常驻（`tunnel-install`）不用这个值，它由 systemd 的 RestartSec 决定
# （命令行 `--restart-sec`，默认 3）。
retry_seconds=10
autossh=auto

# 旧的一次性隧道可能挂在 tmux 里，`tunnel-install` 装之前会检测并停掉它
# （两条隧道抢云上同一个端口 → 新的那条会被无限重启，见 docs/hazards.md H14）。
# 会话名一般不用改。
tmux_session=dsh-tunnel

# --------------------------------------------------------------- 手机地址
# 云端 Caddy 装好后填进来（relay.sh 最后会打印）
public_url=
