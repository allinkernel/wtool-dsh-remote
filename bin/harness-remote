#!/bin/sh
# harness-remote —— **云上（阿里云）那半**的管理器：8443 入口 + 反向隧道 + 家里 broker。
#
# 一句话分清两条命令（用户 2026-10-09 点名要的就是这个分工）：
#
#   harness          家里那半：有 dsh web 就立刻开浏览器，没有就起一个（本地管理器，ADR-0024）
#   harness-remote   云上那半：隧道 / broker / 云上两个 -R 口 / 公网入口 / token / dsh-relay
#
# **它是一个薄封装，不写第二套逻辑**：每条子命令都转发给已经存在、已经测过的
# `dsh-remote` 子命令（`tunnel-status --probe` / `force-restart-dsh-remote` /
# `passwd`），只做三件这里才有价值的事：
#   ① 把 `tunnel-status --probe` + `force-restart-dsh-remote --json` 的输出**压成 ≤6 行**；
#   ② 开浏览器 —— 和 `harness` **同一套 opener 探测顺序**（wslview → cmd.exe →
#      explorer.exe → xdg-open；`DSH_HARNESS_OPENER` 可以桩掉，打不开不算失败）；
#   ③ 说清云上地址是哪来的（remote.conf 的 public_url；IP 模式默认 8443）。
#
# 子命令：
#   harness-remote status                 云上那半的一行体检（≤6 行）：隧道/broker/云上两个 -R
#                                         口/公网入口/token/dsh-relay 容器
#   harness-remote open                   打印并打开 https://<host>:<port>/
#   harness-remote reset                  = force-restart-dsh-remote **安全档**（绝不碰 dsh web）
#   harness-remote passwd [选项]          转发给 dsh-remote passwd（--password / --user / --dry-run）
#   harness-remote url                    只打印手机收藏的固定地址
#   harness-remote qr                     打印二维码图片的路径（dsh-remote server 生成的那张）
#   harness-remote --help                 这一页
#
# 环境变量（测试和特殊机器用）：
#   DSH_REMOTE_BIN=<路径>        被转发的 dsh-remote 在哪（默认：本脚本的兄弟 bin/dsh-remote，
#                                再退回 PATH 上的 dsh-remote）
#   DSH_HARNESS_OPENER=<命令名>  开浏览器用什么（**没设 = 按顺序自动探**；quiet/none/空 = 不试）
#
# 家里那半的命令不是这一条：**`harness`**（它是 env.zsh / env.bash 里的函数）。

set -u

SELF=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
PROJ_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)

say() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die() {
    warn "harness-remote：$*"
    exit 1
}

# 被转发的 dsh-remote（薄封装的核心：**只有一份逻辑**，就在那个脚本里）
remote_bin() {
    if [ -n "${DSH_REMOTE_BIN:-}" ]; then
        printf '%s' "$DSH_REMOTE_BIN"
        return 0
    fi
    if [ -x "$SELF_DIR/dsh-remote" ]; then
        printf '%s' "$SELF_DIR/dsh-remote"
        return 0
    fi
    command -v dsh-remote 2>/dev/null || printf '%s' "$SELF_DIR/dsh-remote"
}

# 家里那份配置 / 状态（只读；`dsh-remote` 自己也会读同一份，这里为了少起一个进程）
remote_conf() { printf '%s' "${DSH_REMOTE_CONF_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dsh-remote}/remote.conf"; }
remote_state() { printf '%s' "${DSH_REMOTE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dsh-remote}"; }

conf_get() { # <键名>（remote.conf 是 key=value，只取最后一条）
    _f=$(remote_conf)
    [ -f "$_f" ] || return 0
    sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$_f" 2>/dev/null | tail -n 1
}

extract() { # extract <文件> <正则>：第一个匹配行的**捕获组 1**（拿不到就是空）
    # ⚠️ 正则里**必须有捕获组** —— 没有的话 sed 的 `\1` 会报
    # "invalid reference \1 on `s' command's RHS"（2026-10-09 实测踩到）。
    [ -f "$1" ] || return 0
    grep -E "$2" "$1" 2>/dev/null | head -n 1 | sed -E "s/$2/\1/" | tr -d '\r'
}

# fr_field <json 文件> <步骤键> <字段>：从 `force-restart-dsh-remote --json` 里取
# 那一步的 state/step/detail（一行一条 JSON，`[^"]*` 足够取字符串值）。
fr_field() {
    [ -f "$1" ] || return 0
    grep -F "\"step\":\"$2\"" "$1" 2>/dev/null | head -n 1 |
        sed -n "s/.*\"$3\":\"\([^\"]*\)\".*/\1/p" | tr -d '\r'
}

# fr_mark <ok|warn|fail|空> → ✓/!/✗/·（照 bin/dsh-remote 的 fr_mark：warn 是"要人看一眼"）
fr_mark() {
    case ${1:-} in
    ok) printf '✓' ;;
    warn) printf '!' ;;
    fail) printf '✗' ;;
    *) printf '·' ;;
    esac
}

# ---- 开浏览器：和 env.zsh/env.bash 里 harness 的 `_hr_open` 同一套实现 --------
# 有意的重复（两份 env 是 shell 函数，这是独立脚本，没法互相 source）：
# **顺序 / 命令 / 环境变量 / 失败语义要一起改**（ADR-0024）。
hr_open_pkg() { # 找 npx 缓存里的 `open` 包根（找到打印，找不到打印空）
    local _p
    if [ -n "${DSH_HARNESS_OPEN_ROOT:-}" ]; then
        if [ -f "${DSH_HARNESS_OPEN_ROOT}/node_modules/open/index.js" ]; then
            printf '%s' "${DSH_HARNESS_OPEN_ROOT}"
        fi
        return 0
    fi
    for _p in "${HOME:-$PWD}"/.npm/_npx/*; do
        [ -f "$_p/node_modules/open/index.js" ] || continue
        printf '%s' "$_p"
        return 0
    done
    return 0
}

hr_open() {
    local _url=$1 _o= _rc=1 _mode= _root= _js= _cand= _log=${DSH_HARNESS_OPENER_LOG:-}
    [ -n "${_log}" ] && printf 'opener=%s url=<%s>\n' "${DSH_HARNESS_OPENER-unset}" "${_url}" >>"$_log" 2>/dev/null

    local _want=${DSH_HARNESS_OPENER-unset}
    case ${_want} in
    quiet | none | '')
        printf 'harness-remote: 没开浏览器（DSH_HARNESS_OPENER=%s）—— 自己去开上面那个地址\n' "${_want:-空}"
        return 0
        ;;
    unset) ;;
    *) _o=$_want ;;
    esac

    # ① node + open 包（无 shell）。open 的入口走**文件 URL**，不能用裸路径 import。
    if [ -z "${_o}" ] && command -v node >/dev/null 2>&1; then
        _root=$(hr_open_pkg)
        if [ -n "${_root}" ]; then
            _js=${TMPDIR:-/tmp}/.harness-open.$$.mjs
            if cat >"$_js" 2>/dev/null <<'JSEOF'
const argv = process.argv.slice(2);
const [url, root] = argv;
for (const k of Object.keys(process.env)) {
    if (k === 'no_proxy' || k === 'NO_PROXY') continue;
    if (/^(https?|all)_proxy$/i.test(k)) delete process.env[k];
}
const { pathToFileURL } = await import('node:url');
const mod = await import(pathToFileURL(root + '/node_modules/open/index.js').href);
await mod.default(url, { wait: false });
process.exit(0);
JSEOF
            then
                if node "$_js" "$_url" "$_root" >/dev/null 2>&1; then
                    _rc=0
                    _mode='node + open 包'
                fi
            fi
            rm -f -- "$_js" 2>/dev/null
        fi
    fi

    # ② explorer.exe / wslview / xdg-open（只传 argv，绝不拼字符串）。
    #    ⚠️ 循环里**一旦把某个候选清成空就必须 break** —— 否则后面 `command -v ""`
    #    会报错，还继续拿清空的 `_o` 往下走（2026-10-09 实测：`command -v` 的
    #    退出码被误当成"这个命令在"）。
    if [ "${_rc}" != 0 ] && [ -z "${_o}" ]; then
        for _cand in explorer.exe wslview xdg-open; do
            if command -v "$_cand" >/dev/null 2>&1; then
                _o=$_cand
                break
            fi
        done
    fi
    if [ "${_rc}" != 0 ] && [ -n "${_o}" ]; then
        if command -v "$_o" >/dev/null 2>&1; then
            [ -n "${_mode}" ] || _mode=$_o
            "$_o" "$_url" >/dev/null 2>&1 && _rc=0
        else
            _mode="$_o 不在"
            _rc=1
        fi
    fi

    # ③ 结果（一行；开不了也 rc=0 —— 会话已经起来了，地址也打出来了）
    if [ "${_rc}" = 0 ]; then
        printf 'harness-remote: 已用 %s 打开浏览器\n' "${_mode}"
    else
        printf 'harness-remote: 开不了浏览器（试过 %s）—— 自己去开上面那个地址\n' "${_mode:-没有 opener}"
    fi
    return 0
}

# 公网入口：public_url 有就用它（域名模式自带端口）；否则 cloud_host + 默认端口
# （IP 模式是自签 8443 —— 和 `dsh-remote server` / `tunnel-status` 打印的一致）。
public_entry() {
    _pub=$(conf_get public_url)
    if [ -n "${_pub}" ]; then
        printf '%s' "${_pub%/}"
        return 0
    fi
    _host=$(conf_get cloud_host)
    [ -n "${_host}" ] || return 0
    _port=$(conf_get public_port)
    [ -n "${_port}" ] || _port=8443
    printf 'https://%s:%s/' "${_host}" "${_port}"
}

# fr_short <文字> <上限>：按**字符**截短（中英混排不切碎 UTF-8）。
# 坑：`cut -c` 和 `printf %.Ns` 都按**字节**切 → 半个汉字（2026-10-09 实测）；
# awk 的 substr 在 C.UTF-8 下按字符（也实测过），所以用它，并显式锁 LC_ALL。
fr_short() {
    local _s
    if [ "${#1}" -le "$2" ]; then
        printf '%s' "$1"
        return 0
    fi
    _s=$(printf '%s' "$1" | LC_ALL=C.UTF-8 awk -v n="$2" '{printf "%s", substr($0,1,n)}')
    case $_s in
    '') printf '%s' "$1" ;;
    *) printf '%s…' "$_s" ;;
    esac
}

# fr_next <json 文件>：summary 那行的 "next"（ASCII/中文都可能；一行一条 JSON）
fr_next() {
    [ -f "$1" ] || return 0
    grep -F '"kind":"summary"' "$1" 2>/dev/null | head -n 1 |
        sed -n 's/.*"next":"\([^"]*\)".*/\1/p' | tr -d '\r'
}

# ------------------------------------------------------------------ status
# 数据来源**两处现成的**（都不重写逻辑）：
#   ① dsh-remote tunnel-status --probe   → 单元/进程/云上两个 -R 口/broker/token/公网 HTTP
#   （--probe 要 ssh 上云、8s 超时；探不到就照实写"探不到"，不编）
#   ② dsh-remote force-restart-dsh-remote --json → 隧道/broker/云上隧道口/dsh web/token/公网
#      六步的机器可读版；token 新鲜度（401 过期 / 302 有效）就在里面
# 压成 ≤6 行：`○` = 探测里的坏消息（✗/warn），消息里的关键词在 `（）` 里；`✓`/`●` 同理。
hr_status() {
    local _a _t _j _entry _tun _ports _rmp _bmp _p _tun_state _bro_state _cloud_state _web_state
    local _tok_state _tok_txt _bf _bact _css _http _pub_state _ct _bad _s _wd _hlp
    for _a in "$@"; do
        case $_a in
        -h | --help) usage && return 0 ;;
        *) die "status 不认识的参数：$_a（harness-remote --help）" ;;
        esac
    done
    _bin=$(remote_bin)
    [ -x "$_bin" ] || die "找不到可执行的 dsh-remote（$_bin）—— 先 wtool install tools/dsh-remote"

    _t=$(_mktmp) || die "mktemp 失败"
    _j=$(_mktmp) || die "mktemp 失败"
    "$_bin" tunnel-status --probe >"$_t" 2>&1 || true
    "$_bin" force-restart-dsh-remote --json >"$_j" 2>&1 || true

    _entry=$(public_entry)
    [ -n "${_entry}" ] || _entry='（remote.conf 里没有 public_url / cloud_host）'

    # ① 隧道：单元状态 + 云上两个 -R 口（18080/18081）是不是都绑上了
    _tun=$(extract "$_t" '^[[:space:]]*状态[[:space:]]+is-active=([^[:space:]]+).*')
    [ -n "${_tun}" ] || _tun=$([ -f "$(remote_conf)" ] && printf '未装/未跑' || printf '没有 remote.conf')
    _ports=
    _rmp=$(conf_get remote_port)
    _bmp=$(conf_get broker_remote_port)
    [ -n "${_rmp}" ] || _rmp=18080
    [ -n "${_bmp}" ] || _bmp=18081
    for _p in "$_rmp" "$_bmp"; do
        if grep -qE "127\.0\.0\.1:${_p}([^0-9]|$)" "$_t" 2>/dev/null; then
            _ports="$_ports ${_p}✓"
        else
            _ports="$_ports ${_p}✗"
        fi
    done
    _tun_state=$(fr_mark "$(fr_field "$_j" tunnel-broker state)")
    _bro_state=${_tun_state}
    _cloud_state=$(fr_mark "$(fr_field "$_j" cloud state)")
    _web_state=$(fr_mark "$(fr_field "$_j" web state)")
    say "隧道      $_tun_state is-active=${_tun}｜云上两个 -R 口：$(printf '%s' "$_ports" | sed 's/^ //')"

    # ② broker：单元 + token 新鲜度（force-restart 那一步 token=fail 就是 401 过期）
    _tok_state=$(fr_mark "$(fr_field "$_j" token state)")
    case $_tok_state in
    ✓) _tok_txt='✓ 状态文件里那个本地实测能用' ;;
    ✗) _tok_txt='✗ 过期（401）—— 要新 token 只能在机器上 force-restart-dsh-remote --restart-web --yes' ;;
    *) _tok_txt='· 没测到（没有 remote.conf / 命令没跑起来？）' ;;
    esac
    _bf=$(extract "$_t" '^[[:space:]]*broker[[:space:]]+单元 ([^[:space:]]+)')
    _bact=$(extract "$_t" '^[[:space:]]*状态 is-active=([^[:space:]]+)')
    say "broker    ${_bro_state} ${_bf:+单元 ✓}${_bact:+ is-active=${_bact}}｜token ${_tok_txt}"

    # ③ 云上入口 / dsh-relay 容器（一次 ssh，只读；探不到就写"探不到"）
    _css='✗'
    grep -qE '^[[:space:]]*判据[[:space:]]+dsh web：云上在听' "$_t" 2>/dev/null && _css='✓'
    _http=$(extract "$_t" '^[[:space:]]*公网[[:space:]]+.*→ HTTP ([0-9]*).*')
    case ${_http} in
    '') _pub_state='· 没探到（--probe 没拿到公网 HTTP 码）' ;;
    401) _pub_state='✓ 不带密码 401（Caddy 在挡）' ;;
    *) _pub_state="✗ 不带密码 HTTP ${_http}（预期 401 = Caddy 没挡，去看云上的 Caddyfile）" ;;
    esac
    # 本地 dsh web（这半的"对手"是 harness）：手工实例 = warn（H22/H29），不是坏
    _wd=$(fr_short "$(fr_field "$_j" web detail)" 28)
    say "web       ${_web_state} ${_wd:-没测到}"
    say "入口      ${_entry}｜公网 ${_pub_state}"

    _ct=$(hr_docker_state)
    if [ -n "${_ct}" ]; then
        say "容器      dsh-relay ${_ct}"
    else
        say "容器      dsh-relay 探不到（ssh 上云没通 / 那台没有 docker）—— 判据：sudo docker ps --filter name=dsh-relay"
    fi

    # ⑤ 结论 + 下一步（照 ADR-0020：状态 + 原因 + 判据，一行一条）
    _bad=0
    for _s in "${_tun_state}" "${_bro_state}" "${_cloud_state}" "${_web_state}" "${_tok_state}" "${_pub_state%% *}"; do
        [ "$_s" = ✗ ] && _bad=$((_bad + 1))
    done
    if [ "$_bad" = 0 ]; then
        say "结论      ✓ 云上那半是通的（本地那半用 harness）"
    else
        say "结论      ✗ 有 ${_bad} 处要处理：$(fr_short "$(fr_next "$_j")" 54)"
    fi
    rm -f -- "$_t" "$_j" 2>/dev/null
    return 0
}

hr_docker_state() { # 云上 dsh-relay 容器的 `status|image`（一次只读 ssh；失败=空，**不**乱报）
    local _host _user _sport _id _o _r
    _host=$(conf_get cloud_host)
    [ -n "${_host}" ] || return 0
    _user=$(conf_get cloud_user)
    [ -n "${_user}" ] || _user=root
    _sport=$(conf_get cloud_ssh_port)
    [ -n "${_sport}" ] || _sport=22
    _id=$(conf_get identity)
    case ${_id} in '~/'*) _id="$HOME/${_id#\~/}" ;; esac
    _o="-o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new -p $_sport"
    [ -n "${_id}" ] && _o="$_o -i $_id"
    # shellcheck disable=SC2086
    _r=$(ssh $_o "${_user}@${_host}" \
        "sudo docker ps --filter name=dsh-relay --format '{{.State}}|{{.Image}}' 2>/dev/null || docker ps --filter name=dsh-relay --format '{{.State}}|{{.Image}}' 2>/dev/null" \
        2>/dev/null | head -n 1 | tr -d '\r')
    [ -n "${_r}" ] && printf '%s' "$_r"
    return 0
}

_mktmp() { mktemp 2>/dev/null || printf '%s' "/tmp/harness-remote.$$.$RANDOM"; }

# -------------------------------------------------------------------- open
hr_open_cmd() {
    local _a _u
    for _a in "$@"; do
        case $_a in
        -h | --help) usage && return 0 ;;
        *) die "open 不认识的参数：$_a（harness-remote --help）" ;;
        esac
    done
    _u=$(public_entry)
    [ -n "${_u}" ] || die "remote.conf 里既没有 public_url 也没有 cloud_host —— 先 dsh-remote server 或照 remote.conf.example 抄一份"
    say "URL: ${_u}"
    hr_open "${_u}"
    return 0
}

# --------------------------------------------------------------------- url
hr_url() {
    local _u
    _u=$(public_entry)
    [ -n "${_u}" ] || die "remote.conf 里既没有 public_url 也没有 cloud_host"
    printf '%s\n' "${_u}"
}

# ---------------------------------------------------------------------- qr
hr_qr() {
    local _st _c
    _st=$(remote_state)
    _host=$(conf_get cloud_host)
    for _c in "$_st/phone-qr.png" "$_st/phone-qr.svg" "$_st/qr.png"; do
        [ -f "$_c" ] && {
            printf '%s\n' "$_c"
            return 0
        }
    done
    warn "harness-remote：还没生成过二维码（找过 $_st/phone-qr.png 和 .svg）"
    say "  生成它：dsh-remote server（最后一步会渲染二维码并写进 $_st/）"
    return 1
}

usage() {
    awk 'NR == 1 { next } /^#/ { print; next } { exit }' "$0" | sed 's/^# \{0,1\}//'
}

case ${1:-help} in
status)
    shift
    hr_status "$@"
    ;;
open)
    shift
    hr_open_cmd "$@"
    ;;
reset)
    shift
    for _a in "$@"; do
        case $_a in
        -h | --help) usage; exit 0 ;;
        --restart-web | --yes | -y)
            die "reset 是**安全档**（ADR-0022：绝不碰 dsh web）。要重启 dsh web 得在机器上显式跑：dsh-remote force-restart-dsh-remote $_a …"
            ;;
        *) die "reset 不认识的参数：$_a（harness-remote --help）" ;;
        esac
    done
    _bin=$(remote_bin)
    [ -x "$_bin" ] || die "找不到可执行的 dsh-remote（$_bin）"
    exec "$_bin" force-restart-dsh-remote
    ;;
passwd)
    shift
    for _a in "$@"; do
        case $_a in
        -h | --help) usage; exit 0 ;;
        esac
    done
    _bin=$(remote_bin)
    [ -x "$_bin" ] || die "找不到可执行的 dsh-remote（$_bin）"
    exec "$_bin" passwd "$@"
    ;;
url)
    shift
    case ${1:-} in -h | --help) usage; exit 0 ;; esac
    [ $# -eq 0 ] || die "url 不带参数（harness-remote --help）"
    hr_url
    ;;
qr)
    shift
    case ${1:-} in -h | --help) usage; exit 0 ;; esac
    [ $# -eq 0 ] || die "qr 不带参数（harness-remote --help）"
    hr_qr
    ;;
help | --help | -h) usage ;;
*) die "不认识的子命令：$1（harness-remote --help）" ;;
esac
