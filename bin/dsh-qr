EC_LEVEL_BITS = {"L": 1, "M": 0, "Q": 3, "H": 2}
EC_LEVELS = ("L", "M", "Q", "H")


# ---------------------------------------------------------------- GF(256) / Reed-Solomon
def gf_mul(x: int, y: int) -> int:
    """GF(2^8) 乘法，本原多项式 0x11D（QR 用的那个）。"""
    z = 0
    for i in range(7, -1, -1):
        z = (z << 1) ^ ((z >> 7) * 0x11D)
        z ^= ((y >> i) & 1) * x
    return z & 0xFF


def rs_divisor(degree: int) -> "list[int]":
    """生成多项式 (x-α^0)(x-α^1)…(x-α^(degree-1)) 的系数（最高次省略）。"""
    result = [0] * (degree - 1) + [1]
    root = 1
    for _ in range(degree):
        for j in range(degree):
            result[j] = gf_mul(result[j], root)
            if j + 1 < degree:
                result[j] ^= result[j + 1]
        root = gf_mul(root, 0x02)
    return result


def rs_remainder(data, divisor) -> "list[int]":
    """多项式除法取余 —— 就是纠错码字。"""
    result = [0] * len(divisor)
    for b in data:
        factor = b ^ result.pop(0)
        result.append(0)
        for i, d in enumerate(divisor):
            result[i] ^= gf_mul(d, factor)
    return result


# ---------------------------------------------------------------- 码字
def blocks_for(ver: int, ecc: str):
    """→ [(总码字, 数据码字), …]（每块一条）。"""
    row = RS_BLOCKS[ver][ecc]
    out = []
    for i in range(0, len(row), 3):
        count, total, data = row[i], row[i + 1], row[i + 2]
        out.extend([(total, data)] * count)
    return out


def num_raw_data_modules(ver: int) -> int:
    """这一版能放数据的模块总数（标准里那个公式）。"""
    result = (16 * ver + 128) * ver + 64
    if ver >= 2:
        num_align = ver // 7 + 2
        result -= (25 * num_align - 10) * num_align - 55
        if ver >= 7:
            result -= 36
    return result


def make_data_codewords(text: str, ver: int, ecc: str) -> bytes:
    data = text.encode("utf-8")
    capacity = sum(d for _, d in blocks_for(ver, ecc)) * 8
    bits: "list[int]" = []

    def append(val: int, n: int) -> None:
        for i in range(n - 1, -1, -1):
            bits.append((val >> i) & 1)

    append(0b0100, 4)  # 字节模式
    append(len(data), 16 if ver >= 10 else 8)
    for b in data:
        append(b, 8)
    append(0, min(4, capacity - len(bits)))  # 结束符
    append(0, (-len(bits)) % 8)              # 补齐到整字节
    pad = 0xEC
    while len(bits) < capacity:
        append(pad, 8)
        pad ^= 0xEC ^ 0x11
    return bytes(int("".join(map(str, bits[i:i + 8])), 2) for i in range(0, len(bits), 8))


def fits(text: str, ver: int, ecc: str) -> bool:
    data_len = len(text.encode("utf-8"))
    count_bits = 16 if ver >= 10 else 8
    capacity = sum(d for _, d in blocks_for(ver, ecc)) * 8
    return 4 + count_bits + data_len * 8 <= capacity


def interleave(data_cw: bytes, ver: int, ecc: str) -> bytes:
    blocks = blocks_for(ver, ecc)
    ec_len = blocks[0][0] - blocks[0][1]
    if any(t - d != ec_len for t, d in blocks):
        raise ValueError("RS 表里各块的纠错长度不一致（表抄错了）")
    divisor = rs_divisor(ec_len)
    data_blocks, ec_blocks = [], []
    k = 0
    for _, data_len in blocks:
        chunk = list(data_cw[k:k + data_len])
        k += data_len
        data_blocks.append(chunk)
        ec_blocks.append(rs_remainder(chunk, divisor))
    out: "list[int]" = []
    for i in range(max(len(b) for b in data_blocks)):
        for b in data_blocks:
            if i < len(b):
                out.append(b[i])
    for i in range(ec_len):
        for b in ec_blocks:
            out.append(b[i])
    return bytes(out)


# ---------------------------------------------------------------- 矩阵
class QrCode:
    def __init__(self, text: str, ecc: str = "M", mask: "int | None" = None):
        self.text = text
        self.ecc = ecc
        ver = None
        for v in range(1, 41):
            if fits(text, v, ecc):
                ver = v
                break
        if ver is None:
            raise ValueError("内容太长，一个二维码放不下（%d 字节）" % len(text.encode("utf-8")))
        self.version = ver
        self.size = ver * 4 + 17
        raw = interleave(make_data_codewords(text, ver, ecc), ver, ecc)
        expect = num_raw_data_modules(ver) // 8
        if len(raw) != expect:
            raise ValueError("码字数对不上：算出 %d，标准说 %d（版本 %d）" % (len(raw), expect, ver))
        self.modules = [[False] * self.size for _ in range(self.size)]
        self.is_func = [[False] * self.size for _ in range(self.size)]
        self._draw_function_patterns()
        self._draw_codewords(raw)
        if mask is None:
            best_mask, best_pen = 0, None
            for m in range(8):
                self._apply_mask(m)
                # 罚分要在**完整符号**上算（含格式信息位）：不画格式位就打分，
                # 挑出来的掩码会和独立实现不一致（2026-10-07 对账时抓到的第二处）。
                self._draw_format(m)
                pen = self._penalty()
                self._apply_mask(m)  # 撤销掩码（格式位下一轮会被覆盖）
                if best_pen is None or pen < best_pen:
                    best_mask, best_pen = m, pen
        else:
            best_mask = mask
        self.mask = best_mask
        self._apply_mask(best_mask)
        self._draw_format(best_mask)

    # ---- 画固定图案
    def _set(self, x, y, dark, func=True):
        self.modules[y][x] = dark
        if func:
            self.is_func[y][x] = True

    def _draw_function_patterns(self):
        n = self.size
        for i in range(n):  # 定位（timing）图案
            self._set(6, i, i % 2 == 0)
            self._set(i, 6, i % 2 == 0)
        for cx, cy in ((3, 3), (n - 4, 3), (3, n - 4)):  # 三个回字
            for dy in range(-4, 5):
                for dx in range(-4, 5):
                    dist = max(abs(dx), abs(dy))
                    xx, yy = cx + dx, cy + dy
                    # 角上那圈白边会伸到符号外面一格，只有落在符号里的才画
                    if 0 <= xx < n and 0 <= yy < n:
                        self._set(xx, yy, dist != 2 and dist != 4)
        pos = ALIGN_POS[self.version - 1]  # 对齐图案
        for i in pos:
            for j in pos:
                if (i == 6 and j == 6) or (i == 6 and j == n - 7) or (i == n - 7 and j == 6):
                    continue
                for dy in range(-2, 3):
                    for dx in range(-2, 3):
                        self._set(i + dx, j + dy, max(abs(dx), abs(dy)) != 1)
        for i in range(9):  # 给格式信息留位
            # ⚠️ (8,6) 和 (6,8) 是**定位图案**的格子，格式信息不占它们 ——
            # 不跳过就会把这两个定时模块抹掉（拿独立实现逐模块对账时抓出来的）。
            if i != 6:
                self._set(8, i, False)
                self._set(i, 8, False)
        for i in range(8):
            self._set(8, n - 1 - i, False)
            self._set(n - 1 - i, 8, False)
        self._set(8, n - 8, True)  # 固定黑点
        if self.version >= 7:  # 版本信息
            rem = self.version
            for _ in range(12):
                rem = (rem << 1) ^ ((rem >> 11) * 0x1F25)
            bits = (self.version << 12) | rem
            for i in range(18):
                bit = ((bits >> i) & 1) != 0
                a, b = n - 11 + i % 3, i // 3
                self._set(a, b, bit)
                self._set(b, a, bit)

    def _draw_codewords(self, data: bytes):
        n = self.size
        i = 0
        for right in range(n - 1, 0, -2):
            if right <= 6:
                right -= 1
            for vert in range(n):
                for j in range(2):
                    x = right - j
                    upward = ((right + 1) & 2) == 0
                    y = (n - 1 - vert) if upward else vert
                    if not self.is_func[y][x] and i < len(data) * 8:
                        self.modules[y][x] = ((data[i >> 3] >> (7 - (i & 7))) & 1) != 0
                        i += 1
        if i != len(data) * 8:
            raise ValueError("数据没放完：%d/%d 位（版本 %d）" % (i, len(data) * 8, self.version))

    # ---- 掩码
    @staticmethod
    def _mask_bit(mask: int, x: int, y: int) -> bool:
        if mask == 0:
            return (x + y) % 2 == 0
        if mask == 1:
            return y % 2 == 0
        if mask == 2:
            return x % 3 == 0
        if mask == 3:
            return (x + y) % 3 == 0
        if mask == 4:
            return (x // 3 + y // 2) % 2 == 0
        if mask == 5:
            return x * y % 2 + x * y % 3 == 0
        if mask == 6:
            return (x * y % 2 + x * y % 3) % 2 == 0
        if mask == 7:
            return ((x + y) % 2 + x * y % 3) % 2 == 0
        raise ValueError("掩码只能是 0..7")

    def _apply_mask(self, mask: int):
        for y in range(self.size):
            for x in range(self.size):
                if not self.is_func[y][x] and self._mask_bit(mask, x, y):
                    self.modules[y][x] = not self.modules[y][x]

    # ---- 罚分（标准 §8.8.2 的四条）
    def _penalty(self) -> int:
        n = self.size
        result = 0
        for y in range(n):  # N1 行
            run = 1
            for x in range(1, n):
                if self.modules[y][x] == self.modules[y][x - 1]:
                    run += 1
                else:
                    if run >= 5:
                        result += 3 + (run - 5)
                    run = 1
            if run >= 5:
                result += 3 + (run - 5)
        for x in range(n):  # N1 列
            run = 1
            for y in range(1, n):
                if self.modules[y][x] == self.modules[y - 1][x]:
                    run += 1
                else:
                    if run >= 5:
                        result += 3 + (run - 5)
                    run = 1
            if run >= 5:
                result += 3 + (run - 5)
        for y in range(n - 1):  # N2 2x2
            for x in range(n - 1):
                c = self.modules[y][x]
                if c == self.modules[y][x + 1] == self.modules[y + 1][x] == self.modules[y + 1][x + 1]:
                    result += 3
        for y in range(n):  # N3 像回字的三段
            row = self.modules[y]
            for x in range(n - 10):
                if row[x] and not row[x + 1] and row[x + 2] and row[x + 3] and row[x + 4] and not row[x + 5] and row[x + 6] and not row[x + 7] and not row[x + 8] and not row[x + 9] and not row[x + 10]:
                    result += 40
                if not row[x] and not row[x + 1] and not row[x + 2] and not row[x + 3] and row[x + 4] and not row[x + 5] and row[x + 6] and row[x + 7] and row[x + 8] and not row[x + 9] and row[x + 10]:
                    result += 40
        for x in range(n):
            for y in range(n - 10):
                col = [self.modules[y + k][x] for k in range(11)]
                if col[0] and not col[1] and col[2] and col[3] and col[4] and not col[5] and col[6] and not col[7] and not col[8] and not col[9] and not col[10]:
                    result += 40
                if not col[0] and not col[1] and not col[2] and not col[3] and col[4] and not col[5] and col[6] and col[7] and col[8] and not col[9] and col[10]:
                    result += 40
        dark = sum(1 for y in range(n) for x in range(n) if self.modules[y][x])  # N4 黑白比
        total = n * n
        k = (abs(dark * 20 - total * 10) + total - 1) // total - 1
        result += k * 10
        return result

    def _draw_format(self, mask: int):
        data = (EC_LEVEL_BITS[self.ecc] << 3) | mask
        rem = data
        for _ in range(10):
            rem = (rem << 1) ^ ((rem >> 9) * 0x537)
        bits = ((data << 10) | rem) ^ 0x5412

        def bit(i):
            return ((bits >> i) & 1) != 0

        for i in range(6):
            self._set(8, i, bit(i))
        self._set(8, 7, bit(6))
        self._set(8, 8, bit(7))
        self._set(7, 8, bit(8))
        for i in range(9, 15):
            self._set(14 - i, 8, bit(i))
        for i in range(8):
            self._set(self.size - 1 - i, 8, bit(i))
        for i in range(8, 15):
            self._set(8, self.size - 15 + i, bit(i))
        self._set(8, self.size - 8, True)

    # ---- 给外面用
    def matrix(self, border: int = 2):
        """带静默区的二维布尔表：True = 黑块。"""
        n = self.size + border * 2
        out = [[False] * n for _ in range(n)]
        for y in range(self.size):
            for x in range(self.size):
                out[y + border][x + border] = self.modules[y][x]
        return out


# ---------------------------------------------------------------- 输出
def render_terminal(mat, out=sys.stdout) -> None:
    """半块字符画：上半个 = 前景色，下半个 = 背景色（自带色，别管终端什么配色）。"""
    rows = len(mat)
    if rows % 2:
        mat = mat + [[False] * len(mat[0])]
    lines = []
    for y in range(0, len(mat), 2):
        parts = []
        for x in range(len(mat[0])):
            top, bottom = mat[y][x], mat[y + 1][x]
            fg = 30 if top else 37   # 黑 / 白
            bg = 40 if bottom else 47
            parts.append("\x1b[%d;%dm\u2580" % (fg, bg))
        lines.append("".join(parts) + "\x1b[0m")
    out.write("\n".join(lines) + "\n")


def render_png(mat, path: str, scale: int = 1) -> None:
    """1 位灰度 PNG（0 = 黑 = 码点，1 = 白 = 底）。zlib/struct 都是标准库。

    `scale` 是**每个模块占几个像素**（整数倍）：手机上扫的图不能是 1 模块 1 像素 ——
    21 模块的版本只有 21px，扫码器要放大才认（2026-10-07 用户实测反馈）。
    宽 = 高 = 模块数 × scale。**不做插值/抗锯齿**：每个模块必须是干净的整数方块。
    """
    n = len(mat) * scale

    def chunk(tag: bytes, data: bytes) -> bytes:
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    raw = bytearray()
    for row in mat:
        # 一行模块 → 一行像素位（每个模块重复 scale 次；1 = 白、0 = 黑）
        bits = bytearray()
        for dark in row:
            bits.extend([0 if dark else 1] * scale)
        line = bytearray()
        for i in range(0, n, 8):
            byte = 0
            for j in range(8):
                k = i + j
                byte = (byte << 1) | (bits[k] if k < n else 1)
            line.append(byte)
        for _ in range(scale):  # 同一行像素重复 scale 次（高度方向也一样是整数倍）
            raw.append(0)       # 过滤器：无
            raw.extend(line)
    png = (b"\x89PNG\r\n\x1a\n" +
           chunk(b"IHDR", struct.pack(">IIBBBBB", n, n, 1, 0, 0, 0, 0)) +
           chunk(b"IDAT", zlib.compress(bytes(raw), 9)) +
           chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)


def render_svg(mat, path: str, scale: int = 1) -> None:
    """纯文本 SVG：viewBox 用模块坐标（矢量缩放），width/height 给像素尺寸。

    `scale` 只影响 width/height 两个属性 —— 手机上打开时图片是大的（不会显示成
    21px 的小点），放大也不糊（矢量）。
    """
    n = len(mat)
    rects = []
    for y, row in enumerate(mat):
        x = 0
        while x < n:
            if row[x]:
                run = 1
                while x + run < n and row[x + run]:
                    run += 1
                rects.append('<rect x="%d" y="%d" width="%d" height="1"/>' % (x, y, run))
                x += run
            else:
                x += 1
    svg = ('<?xml version="1.0" encoding="UTF-8"?>\n'
           '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d" '
           'shape-rendering="crispEdges">\n'
           '  <rect width="100%%" height="100%%" fill="#fff"/>\n'
           '  <g fill="#000">%s</g>\n</svg>\n'
           % (n * scale, n * scale, n, n, "".join(rects)))
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(svg)


def main(argv) -> int:
    ap = argparse.ArgumentParser(prog="dsh-qr", description="把一段文本画成二维码（纯 python，无依赖）")
    ap.add_argument("text", nargs="?", help="要编码的内容（`-` 表示从 stdin 读一行）")
    ap.add_argument("--ecc", default="M", choices=list(EC_LEVELS), help="纠错等级（默认 M）")
    ap.add_argument("--border", type=int, default=2, help="静默区宽度（默认 2，标准要求 ≥4 最保险）")
    ap.add_argument("--png", help="另存一份 PNG 到这个路径")
    ap.add_argument("--svg", help="另存一份 SVG 到这个路径")
    ap.add_argument("--no-terminal", action="store_true", help="别往终端画")
    ap.add_argument("--scale", type=int, default=0,
                    help="每个模块占几个像素（默认自动：把短边做到 ≥ --target-px）")
    ap.add_argument("--target-px", type=int, default=1024,
                    help="自动挑 scale 时的目标短边像素（默认 1024；手机上扫足够）")
    ap.add_argument("--mask", type=int, choices=range(8), help="强制某个掩码（默认按标准罚分挑）")
    ap.add_argument("--version", type=int, help="只看这一版够不够放（默认自动挑最小的一版）")
    ap.add_argument("--matrix", action="store_true", help="打印 0/1 矩阵（测试用）")
    args = ap.parse_args(argv)

    text = args.text
    if text is None or text == "-":
        text = sys.stdin.readline().rstrip("\n")
    if not text:
        ap.error("要编码的内容是空的")

    qr = QrCode(text, args.ecc, args.mask)
    border = max(0, args.border)
    mat = qr.matrix(border)
    scale = args.scale
    if scale <= 0:
        scale = max(1, -(-args.target_px // len(mat)))  # ceil(目标 / 模块数)
    if args.png:
        render_png(mat, args.png, scale)
    if args.svg:
        render_svg(mat, args.svg, scale)
    if args.matrix:
        for row in mat:
            sys.stdout.write("".join("1" if v else "0" for v in row) + "\n")
    elif not args.no_terminal:
        if sys.stdout.isatty() and not args.png and not args.svg:
            sys.stderr.write("（扫不出来的话把终端字号调小一点；或者用 --png 存成图片看）\n")
        render_terminal(mat)
    if args.png or args.svg:
        dim = len(mat)
        sys.stderr.write("版本 %d / 纠错 %s / %d×%d 模块（含静默区 %d）→ 图片 %d×%d px（每模块 %d px）\n"
                         % (qr.version, qr.ecc, qr.size, qr.size, border, dim * scale, dim * scale, scale))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
