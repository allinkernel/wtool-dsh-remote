#!/bin/sh
# dsh-remote —— 手机远程看着/接着指挥家里的 DSH 会话。
#
#   dsh-remote status          体检：harness / 隧道 / 推送 / 手机地址
#   dsh-remote serve           在后台起 harness（--no-open），把带 token 的 URL 存起来
#   dsh-remote tunnel          前台保活一条 SSH 反向隧道（调试用；常驻看 tunnel-install）
#   dsh-remote tunnel-install  装成 systemd --user 常驻服务（Restart=always，断线自动重连）
#   dsh-remote tunnel-uninstall 撤掉它（disable --now + 删单元文件）
#   dsh-remote tunnel-status   看单元/进程/云上隧道口/公网的现状（--probe 上云只读检查）
#   dsh-remote token-broker    前台跑"把 / 302 到当前 token"的小服务（常驻用 broker-install）
#   dsh-remote serve-install   把 dsh web 装成 systemd --user 常驻（开机自动开会话；
#                              端口被别人占着时不抢，等它结束再接管）
#   dsh-remote serve-status    看 web 服务 / 端口 / token / 隧道 的现状
#   dsh-remote serve-uninstall 撤掉 web 常驻服务（不动正在跑的会话）
#   dsh-remote broker-install  把 token broker 装成 systemd --user 常驻（手机固定地址靠它）
#   dsh-remote broker-uninstall 撤掉它
#   dsh-remote systemd         旧名字：只生成单元、不 enable（= tunnel-install --no-enable）
#   dsh-remote url             打印手机该收藏的地址
#   dsh-remote notify-test     推一条测试消息到手机
#   dsh-remote notify-enable   打开"会话卡住/跑完就推手机"（写配置目录的 hooks.json + profile patch）
#   dsh-remote notify-disable  关掉它（把 patch 里那一段删掉）
#   dsh-remote passwd          改中继的 basic auth 密码（云上只改那一行 + 重启 + 验旧/新）
#   dsh-remote server          一条命令装好：云上中继 + 家里常驻隧道 + token broker + harness
#                              （问几个问题 → 自检 → 部署 → 打印手机地址 + 二维码）
#   dsh-remote cloud-install   真装到阿里云上（传 cloud/ → 起 caddy 容器 → 记下地址）
#   dsh-remote cloud-setup     只打印"送上去并执行"的命令，不动手
#   dsh-remote migrate         把旧版放在 ~/.dsh 下的配置/日志搬到我们自己的目录
#   dsh-remote check-hooks     **验证钩子桥到底会不会触发**（一次性进程，跑一次模型，几十秒）
#   dsh-remote log             看隧道/推送日志
#
# 配置在 ~/.config/dsh-remote/remote.conf，日志在 ~/.local/state/dsh-remote/
# （样板：tools/dsh-remote/remote.conf.example）。**~/.dsh 是 DSH 自己的目录**，
# 我们只在里面放一样它强制要求的东西：profiles/web/cordis.patch.yml。
# 安全边界、威胁模型、为什么这么设计：见同目录 README.md。

set -u

# 自己是谁：先解掉软链。~/.local/bin/dsh-remote 是软链，不解的话
# PROJ_DIR 会算成 ~/.local（踩过：status 打印"项目 /home/xxx/.local"，然后
# hooks/claude-hooks.json 也找不到）。
SELF=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
PROJ_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)

# 我们的目录 vs harness 的目录 —— 分清楚，别往别人的目录里放东西：
#
#   $CONF_DIR   ~/.config/dsh-remote/          配置（remote.conf / notify.conf / hooks.json）
#   $STATE_DIR  ~/.local/state/dsh-remote/     日志和运行期文件（notify.log / web.log / web-url.txt）
#   $DSH_HOME   ~/.dsh/                        这是 **DSH 自己的**目录。只有一样东西必须
#                                              放在它里面：profiles/web/cordis.patch.yml ——
#                                              DSH 只从那里读 profile patch，改不了。
#
# DSH_REMOTE_HOME 是一个"伞"覆盖（测试用）：设了它就两个目录都在它下面。
# DSH_HOME 只是跟着 DSH 的约定（$DSH_HOME，默认 ~/.dsh），我们不改它。
DSH_HOME=${DSH_HOME:-$HOME/.dsh}
: "${DSH_REMOTE_HOME:=}"
CONF_DIR=${DSH_REMOTE_CONF_DIR:-${DSH_REMOTE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/dsh-remote}}
STATE_DIR=${DSH_REMOTE_STATE_DIR:-${DSH_REMOTE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/dsh-remote}}
CONF=${DSH_REMOTE_CONF:-$CONF_DIR/remote.conf}
NOTIFY=${DSH_NOTIFY_BIN:-$(command -v dsh-notify 2>/dev/null || printf '%s' "$SELF_DIR/dsh-notify")}

say() { printf '%s\n' "$*"; }
warn() { printf '警告：%s\n' "$*" >&2; }
die() {
    printf '%s\n' "$*" >&2
    exit 1
}

conf() {
    [ -f "$CONF" ] || return 1
    _v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" | tail -n 1)
    _v=$(printf '%s' "$_v" | sed -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
    [ -n "$_v" ] || return 1
    printf '%s' "$_v"
}

conf_any() {
    for k in "$@"; do
        if _r=$(conf "$k"); then printf '%s' "$_r"; return 0; fi
    done
    return 1
}

# ------------------------------------------------------------------ 体检
port_listening() {
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"
    else
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"
    fi
}

pid_of() { # 用命令行特征找进程（找不到返回 1）
    pgrep -f "$1" 2>/dev/null | head -n 1
}

cmd_status() {
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    host=$(conf_any cloud_host CLOUD_HOST 2>/dev/null || printf '')
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')

    say "配置      $CONF$([ -f "$CONF" ] || printf '（还没有，先照 remote.conf.example 抄一份）')"
    say "项目      $PROJ_DIR"

    if port_listening "$lp"; then
        say "harness   127.0.0.1:$lp 在跑$(pid_of "dsh.*--port $lp" >/dev/null 2>&1 && printf '' )"
    elif pid_of 'dsh .*web|dsh web' >/dev/null 2>&1; then
        say "harness   有 dsh web 进程，但 127.0.0.1:$lp 没在听（端口对不对？）"
    else
        say "harness   没在跑（dsh-remote serve 起它）"
    fi

    if [ -n "$host" ]; then
        if pid_of 'ssh .*-R .*127\.0\.0\.1' >/dev/null 2>&1; then
            say "隧道      在跑：云上 127.0.0.1:$rp → 家里 127.0.0.1:$lp"
        else
            say "隧道      没在跑（dsh-remote tunnel，或装成 systemd 单元）"
        fi
    else
        say "隧道      remote.conf 里还没写 cloud_host"
    fi

    if [ -n "$pub" ]; then
        say "手机地址   $pub"
    else
        say "手机地址   还没写 public_url（云端 Caddy 装好之后填进来）"
    fi

    if [ -f "$CONF_DIR/notify.conf" ]; then
        prov=$(sed -n 's/^[[:space:]]*provider[[:space:]]*=[[:space:]]*//p' "$CONF_DIR/notify.conf" | tail -n 1)
        say "推送       provider=${prov:-serverchan}（dsh-remote notify-test 试一下）"
    else
        say "推送       还没配（照 notify.conf.example 写 $CONF_DIR/notify.conf）"
    fi

    if [ -f "$CONF_DIR/hooks.json" ]; then
        if grep -q 'dsh-remote notify' "$DSH_HOME/profiles/web/cordis.patch.yml" 2>/dev/null; then
            say "hook 推送  已开启（问问题/跑完会推手机）"
        else
            say "hook 推送  钩子文件在，但 profile 里没挂上（dsh-remote notify-enable）"
        fi
    else
        say "hook 推送  没开（dsh-remote notify-enable）"
    fi
}

# ------------------------------------------------------------------ 起 harness
cmd_serve() {
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    urlfile="$STATE_DIR/web-url.txt"
    logfile="$STATE_DIR/web.log"
    mkdir -p -- "$STATE_DIR"

    if port_listening "$lp"; then
        warn "127.0.0.1:$lp 已经有人在听 —— 大概率 harness 正在跑。"
        warn "别在会话里重启它：正在跑的会话会被打断（历史不会丢，能 resume）。"
        [ -f "$urlfile" ] && say "上次记下来的地址：$(cat "$urlfile")"
        return 1
    fi

    command -v dsh >/dev/null 2>&1 || die "PATH 里没有 dsh"

    say "起 harness：dsh web --no-open --port $lp（日志 $logfile）"
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup dsh web --no-open --port "$lp" >"$logfile" 2>&1 </dev/null &
    else
        nohup dsh web --no-open --port "$lp" >"$logfile" 2>&1 </dev/null &
    fi

    i=0
    while [ "$i" -lt 40 ]; do
        if grep -o "http://127\.0\.0\.1:$lp/[^ ]*token=[^ ]*" "$logfile" 2>/dev/null | head -n 1 >"$urlfile.tmp"; then
            if [ -s "$urlfile.tmp" ]; then
                mv -f "$urlfile.tmp" "$urlfile"
                say "地址（**手机第一次要用这个带 token 的**，登录后浏览器会记住）："
                say "  $(cat "$urlfile")"
                return 0
            fi
        fi
        sleep 0.5
        i=$((i + 1))
    done
    rm -f "$urlfile.tmp"
    warn "20 秒没等到 token URL，自己看日志：$logfile"
    return 1
}

# ------------------------------------------------------------------ 隧道
# 一条反向隧道 = 云上 127.0.0.1:<remote_port> 转发到家里 127.0.0.1:<local_port>。
# ssh 参数只写一份（tunnel_argv），三处共用：前台 tunnel / 渲染进 systemd 单元 /
# tunnel-status 的"配置漂移"对比。保活参数必须留着 —— systemd 只看得到"进程退没退"，
# 网络断了而 ssh 僵着不退时，只有 ssh 自己的 ServerAlive* 能把它踢死（ADR-0013）。
tunnel_conf() {
    host=$(conf_any cloud_host CLOUD_HOST) || die "remote.conf 里没有 cloud_host"
    ssh_user=$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')
    ssh_port=$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')
    remote_port_v=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    local_port_v=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    # token broker 那条反向隧道（云上 18081 → 家里 3081）。设成 off 就不要它。
    broker_remote_port=$(conf_any broker_remote_port BROKER_REMOTE_PORT 2>/dev/null || printf '18081')
    broker_local_port=$(conf_any broker_local_port BROKER_LOCAL_PORT 2>/dev/null || printf '3081')
    identity_key=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $identity_key in '~/'*) identity_key="$HOME/${identity_key#\~/}" ;; esac
    tmux_name=$(conf_any tmux_session TMUX_SESSION 2>/dev/null || printf 'dsh-tunnel')
}

tunnel_argv() { # 用法：tunnel_argv [--batch]（先调 tunnel_conf 设好上面那批全局量）
    _batch=${1:-}
    set -- -N -T
    [ "$_batch" = "--batch" ] && set -- "$@" -o BatchMode=yes
    set -- "$@" \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=3 \
        -o TCPKeepAlive=yes \
        -o StrictHostKeyChecking=accept-new \
        -p "$ssh_port"
    [ -n "$identity_key" ] && set -- "$@" -i "$identity_key"
    set -- "$@" -R "127.0.0.1:${remote_port_v}:127.0.0.1:${local_port_v}"
    case ${broker_local_port:-off} in
    '' | off | OFF | Off | 0) ;; # 不要 broker 那条（云上 18081 被别人占着时用）
    *) set -- "$@" -R "127.0.0.1:${broker_remote_port}:127.0.0.1:${broker_local_port}" ;;
    esac
    set -- "$@" "${ssh_user}@${host}"
    printf '%s\n' "$@"
}

tunnel_args() { # 兼容旧调用点：先读配置，再拼参数
    tunnel_conf
    tunnel_argv
}

cmd_tunnel() {
    retry=$(conf_any retry_seconds RETRY_SECONDS 2>/dev/null || printf '10')
    autossh=
    if [ "$(conf_any autossh AUTOSSH 2>/dev/null || printf auto)" != off ] &&
        command -v autossh >/dev/null 2>&1; then
        autossh=1
    fi

    say "反向隧道：云上 127.0.0.1:$(conf_any remote_port 2>/dev/null || printf 18080) → 家里 127.0.0.1:$(conf_any local_port 2>/dev/null || printf 3080)"
    say "（云上那个端口只绑 127.0.0.1，安全组里**不要**开放它；对外只开放 Caddy 的 443/8443）"

    while :; do
        # shellcheck disable=SC2046
        if [ -n "$autossh" ]; then
            AUTOSSH_GATETIME=0 autossh -M 0 $(tunnel_args)
        else
            ssh $(tunnel_args)
        fi
        code=$?
        say "隧道断了（退出码 $code），${retry}s 后重连。Ctrl-C 退出。"
        sleep "$retry"
    done
}

# ------------------------------------------------- 常驻隧道（systemd --user 单元）
# 为什么不用 autossh：本机 / 云上都没有它（要装包，ADR-0013）。改成两件事分工：
#   * 进程退了（网络断、对端重启、ssh 自己超时退出）→ systemd 的 `Restart=always` 拉起；
#   * 网络断了但 ssh 还僵着不退 → ssh 自己的 `ServerAliveInterval × ServerAliveCountMax`
#     秒内把它踢死，退回上一条。
# 单元固定落在 ~/.config/systemd/user/dsh-tunnel.service（认 $XDG_CONFIG_HOME）。
UNIT_NAME=dsh-tunnel.service
LEGACY_UNIT_NAME=dsh-remote-tunnel.service # 旧版 `dsh-remote systemd` 写的；会抢同一个云上端口
SYSTEMCTL=${DSH_REMOTE_SYSTEMCTL:-systemctl}
TMUX_BIN=${DSH_REMOTE_TMUX:-tmux}

# ---- 内部件：隧道自愈检查（**不在 PATH 上、不是给用户敲的命令**；见 architecture.md §3.1.1）
# 每 5 分钟看一眼云上的反向隧道口在不在听，不在就重启隧道。为什么放家里不放云上：
# 见 docs/adr/0019（云上看不到"家里还有没有别的东西在跑"，也不该由云上按 ssh 进来重启）。
WATCH_UNIT_NAME=dsh-tunnel-watch.service
WATCH_TIMER_NAME=dsh-tunnel-watch.timer
WATCH_SCRIPT_NAME=tunnel-watch.sh

unit_dir() { printf '%s' "${DSH_REMOTE_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"; }
unit_file() { printf '%s/%s' "$(unit_dir)" "$UNIT_NAME"; }
legacy_unit_file() { printf '%s/%s' "$(unit_dir)" "$LEGACY_UNIT_NAME"; }
lib_dir() { printf '%s' "${DSH_REMOTE_LIB_DIR:-$HOME/.local/lib/dsh-remote}"; }
watch_script_file() { printf '%s/%s' "$(lib_dir)" "$WATCH_SCRIPT_NAME"; }
watch_unit_file() { printf '%s/%s' "$(unit_dir)" "$WATCH_UNIT_NAME"; }
watch_timer_file() { printf '%s/%s' "$(unit_dir)" "$WATCH_TIMER_NAME"; }

# systemctl --user 靠 $XDG_RUNTIME_DIR 找用户总线。**非登录 shell 里它可能是空的**
# （WSL / cron / 手工 sh 都会），那时报 "Failed to connect to bus"，而用户管理器其实活着。
# 空的就按 logind 的约定补一个（只在那个目录真存在时才补）。
systemctl_user() {
    if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
        export XDG_RUNTIME_DIR
    fi
    "$SYSTEMCTL" --user "$@"
}

# 探用户管理器在不在。**必须在写单元/停旧隧道之前探**：装不上就别把正在跑的弄没了。
systemd_user_ok() { systemctl_user show-environment >/dev/null 2>&1; }

linger_state() { # yes / no / 未知（老 loginctl 没有 --value，退回去自己剥前缀）
    command -v loginctl >/dev/null 2>&1 || {
        printf '未知（没有 loginctl）'
        return 0
    }
    _l=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || printf '')
    [ -n "$_l" ] || _l=$(loginctl show-user "$(id -un)" -p Linger 2>/dev/null | sed 's/^Linger=//')
    printf '%s' "${_l:-未知}"
}

# systemd 的 ExecStart 是一行；参数里有空格/引号的要引起来，`$`/`%` 会被 systemd 展开，
# 得写成 `$$`/`%%`（只对"含不安全字符"的参数做加工，IP/端口/路径都保持原样好读）。
sd_quote() {
    case $1 in
    *[!A-Za-z0-9_@+=:,./-]*)
        _q=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/$$/g' -e 's/%/%%/g')
        printf '"%s"' "$_q"
        ;;
    *) printf '%s' "$1" ;;
    esac
}

unit_body() { # 用法：unit_body <RestartSec> <StartLimitBurst> <StartLimitIntervalSec>
    _sec=$1
    _burst=$2
    _interval=$3
    tunnel_conf
    _ssh=${DSH_REMOTE_SSH:-$(command -v ssh 2>/dev/null || printf '')}
    [ -n "$_ssh" ] || die "PATH 里没有 ssh（单元里的 ExecStart 必须写绝对路径）"
    _argv=$(tunnel_argv --batch)
    _exec=$(printf '%s\n' "$_argv" | while IFS= read -r _a; do printf ' %s' "$(sd_quote "$_a")"; done)
    cat <<EOF
[Unit]
Description=DSH 反向隧道（手机远程接管家里这台机器）
Documentation=file:$PROJ_DIR/README.md
# 防风暴（2026-10-09 加，ADR-0019）：$_burst 次失败发生在 $_interval 秒内就**停下并标 failed**，
# 不再无限锤对端。起因：对端持续掐连接时，RestartSec 小 + StartLimitIntervalSec=0 会
# 自我维持成风暴（2026-10-08 实测 NRestarts 累计到 1708；hazards H27）。
# 停了之后靠 dsh-tunnel-watch.timer（同目录，内部件）定时看一眼（默认 5 分钟），真断了才重启。
# ⚠️ 这两个键属于 [Unit]；写在 [Service] 里 systemd 只警告 "Unknown key name" 然后忽略
# （2026-10-07 被 systemd-analyze --user verify 抓出来，别搬回去）。
StartLimitIntervalSec=$_interval
StartLimitBurst=$_burst

[Service]
Type=simple
# BatchMode：服务里没有终端，别让它停在那儿等密码/host key 提问
ExecStart=$(sd_quote "$_ssh")$_exec
Restart=always
RestartSec=$_sec
# 日志走 journald：journalctl --user -u $UNIT_NAME
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-tunnel

[Install]
WantedBy=default.target
EOF
}

# ---- 内部件（自愈检查）的三个文件：脚本 + service + timer ------------------
# 脚本由 timer 调；`WATCH_PORT` 只为自测留的覆盖口（拿一个假端口跑一遍，验"不在听 → 重启"）。
# ssh 用 PATH 里的（systemd --user 的 oneshot 有正常 PATH）；systemctl 用渲染时那个值，
# 这样测试能用桩把它接住（**真机上永远不该让测试去 restart 生产隧道**）。
watch_script_body() {
    tunnel_conf
    _port=${remote_port_v:-18080}
    _host_spec=$ssh_user@$host
    _keyopt=
    if [ -n "$identity_key" ]; then
        _keyopt=" -i $identity_key"
    fi
    cat <<EOF
#!/bin/sh
# dsh-remote 内部件（**不在 PATH 上、不是给用户敲的命令**）：
# 定时看一眼云上 127.0.0.1:${_port}（反向隧道口）在不在听；不在就重启隧道并记一行日志（周期见 timer）。
# 由 $WATCH_TIMER_NAME 调。自测用 WATCH_PORT=<假端口> 跑一遍（那时应该 rc=1 并去重启一次）。
# 为什么是"看一眼端口"而不是"看本地进程"：进程活着、端口也可能已经被对端掐掉了
# （ExitOnForwardFailure 只管建立那一刻）—— 端口在不在听才是手机能不能用的判据。
set -u
HOST="${_host_spec}"
PORT="\${WATCH_PORT:-${_port}}"
SSH_PORT="${ssh_port}"
probe() {
    ssh -o BatchMode=yes -o IdentitiesOnly=yes${_keyopt} -p "\$SSH_PORT" -o ConnectTimeout=8 \\
        -o StrictHostKeyChecking=accept-new "\$HOST" \\
        "ss -ltn | grep -c '127.0.0.1:\$PORT'" 2>/dev/null || echo ERR
}
n=\$(probe)
[ "\$n" = "1" ] && exit 0
logger -t dsh-tunnel-watch "云上 127.0.0.1:\$PORT 不在听（probe='\$n'）→ 重启 $UNIT_NAME"
$SYSTEMCTL --user restart $UNIT_NAME || true
sleep 6
n2=\$(probe)
logger -t dsh-tunnel-watch "重启后 probe='\$n2'（1=已恢复）"
[ "\$n2" = "1" ] || exit 1
EOF
}

watch_unit_body() {
    cat <<EOF
[Unit]
Description=DSH 隧道自愈检查（内部件，由 $WATCH_TIMER_NAME 调）
Documentation=file:$PROJ_DIR/architecture.md

[Service]
Type=oneshot
ExecStart=$(watch_script_file)
EOF
}

watch_timer_body() { # 用法：watch_timer_body <秒>
    _every=$1
    # systemd 两种写法都认；整分钟就写 5min（跟人手写的一样好读），否则写 90s
    if [ "$((_every % 60))" = 0 ]; then
        _every_txt="$((_every / 60))min"
        _every_zh="$((_every / 60)) 分钟"
    else
        _every_txt="${_every}s"
        _every_zh="${_every} 秒"
    fi
    cat <<EOF
[Unit]
Description=每 ${_every_zh}检查一次 DSH 反向隧道口
Documentation=file:$PROJ_DIR/architecture.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=$_every_txt
AccuracySec=30s

[Install]
WantedBy=timers.target
EOF
}

tmux_has_session() {
    [ -n "${tmux_name:-}" ] || return 1
    command -v "$TMUX_BIN" >/dev/null 2>&1 || return 1
    "$TMUX_BIN" has-session -t "$tmux_name" >/dev/null 2>&1
}

# 落盘一个单元：内容一样就不动（幂等）；不一样先备份成 <单元>.bak-<时间戳>。
# 用法：unit_write <单元文件> <新内容文件>；返回 0 = 内容没变（没动它），1 = 写了新的。
unit_write() {
    _uf=$1
    _new=$2
    mkdir -p -- "$(dirname -- "$_uf")"
    if [ -f "$_uf" ] && cmp -s -- "$_new" "$_uf"; then
        return 0
    fi
    if [ -f "$_uf" ]; then
        _bak="$_uf.bak-$(date +%Y%m%d-%H%M%S)"
        cp -f -- "$_uf" "$_bak" && say "旧单元备份成 $_bak"
    fi
    mv -f -- "$_new" "$_uf" || die "写 $_uf 失败"
    say "已写 $_uf"
    return 1
}

# daemon-reload → enable --now；**内容变了且原本就在跑**时补一次 restart ——
# `enable --now` 对已经在跑的单元不会重启它（单元文件改了、跑的还是旧参数，实测踩过）。
unit_enable() {
    _name=$1
    _changed=${2:-0}
    _was_active=$(systemctl_user is-active "$_name" 2>/dev/null || true)
    systemctl_user daemon-reload || die "daemon-reload 失败"
    if ! systemctl_user enable --now "$_name"; then
        warn "enable --now 失败，看：systemctl --user status $_name"
        return 1
    fi
    if [ "$_changed" = 1 ] && [ "$_was_active" = active ]; then
        say "单元内容变了：restart 一次让新参数生效"
        systemctl_user restart "$_name" >/dev/null 2>&1 || true
    fi
    return 0
}

cmd_tunnel_install() {
    _sec=5                 # 2026-10-09 起默认 5（原来是 3）：给对端一点喘息，别 3 秒一锤
    _burst=10              # 防风暴：StartLimitBurst / StartLimitIntervalSec（见 hazards H27）
    _interval=300
    _watch=1               # 顺带装内部件（自愈 timer）；--no-watch 关掉
    _watch_sec=300
    _rp=
    _lp=
    _new_user=
    _dry=0
    _no_enable=0
    _keep_tmux=0
    while [ $# -gt 0 ]; do
        case $1 in
        --restart-sec)
            _sec=${2:-}
            shift 2
            ;;
        --start-limit-burst)
            _burst=${2:-}
            shift 2
            ;;
        --start-limit-interval)
            _interval=${2:-}
            shift 2
            ;;
        --watch-sec)
            _watch_sec=${2:-}
            shift 2
            ;;
        --no-watch)
            _watch=0
            shift
            ;;
        --remote-port)
            _rp=${2:-}
            shift 2
            ;;
        --local-port)
            _lp=${2:-}
            shift 2
            ;;
        --ssh-user)
            _new_user=${2:-}
            shift 2
            ;;
        --no-enable)
            _no_enable=1
            shift
            ;;
        --keep-tmux)
            _keep_tmux=1
            shift
            ;;
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "tunnel-install 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    case $_sec in '' | *[!0-9]*) die "--restart-sec 要正整数（秒）：$_sec" ;; esac
    [ "$_sec" -ge 1 ] || die "--restart-sec 至少 1 秒"
    case $_burst in '' | *[!0-9]*) die "--start-limit-burst 要正整数（次）：$_burst" ;; esac
    [ "$_burst" -ge 1 ] || die "--start-limit-burst 至少 1 次"
    case $_interval in '' | *[!0-9]*) die "--start-limit-interval 要正整数（秒）：$_interval" ;; esac
    [ "$_interval" -ge 1 ] || die "--start-limit-interval 至少 1 秒"
    case $_watch_sec in '' | *[!0-9]*) die "--watch-sec 要正整数（秒）：$_watch_sec" ;; esac
    [ "$_watch_sec" -ge 30 ] || die "--watch-sec 至少 30 秒（再密就是拿 ssh 打对端了）"

    tunnel_conf
    [ -n "$_rp" ] && remote_port_v=$_rp
    [ -n "$_lp" ] && local_port_v=$_lp
    [ -n "$_new_user" ] && ssh_user=$_new_user
    case $remote_port_v in '' | *[!0-9]*) die "远程端口要数字：$remote_port_v" ;; esac
    case $local_port_v in '' | *[!0-9]*) die "本地端口要数字：$local_port_v" ;; esac
    _me=$(id -un)

    uf=$(unit_file)
    say "常驻隧道  云上 127.0.0.1:${remote_port_v} → 家里 127.0.0.1:${local_port_v}"
    say "登录      ${ssh_user}@${host}:${ssh_port}$([ -n "$identity_key" ] && printf '（-i %s）' "$identity_key")"
    say "单元      $uf（Restart=always，RestartSec=${_sec}s，${_interval}s 内失败 ${_burst} 次就停下）"
    say ""

    # 0) 先探 systemd --user：必须在停掉旧隧道**之前**探，装不上就别把正在跑的弄没了
    if [ "$_dry" = 0 ] && [ "$_no_enable" = 0 ] && ! systemd_user_ok; then
        warn "systemctl --user 连不上用户管理器（systemd --user 没在跑），单元装了也起不来。"
        warn "常见原因：这台机器上你没有 logind 会话、也没开 linger。"
        warn "  loginctl enable-linger $_me    # 没登录时也跑用户服务（本机 2026-10-07 实测不需要 sudo）"
        warn "  判据：systemctl --user show-environment 退出码 0"
        die "什么都没动（旧隧道还在跑）"
    fi

    # 1) 旧的一次性 tmux 隧道：它已经占着云上**同一个**端口，必须先退场。
    #    两条隧道抢同一个远程端口时，后起的那条 ssh 会立刻退出；配上 Restart=always
    #    就是"每 RestartSec 秒重启一次"的死循环（hazards H14）。
    if tmux_has_session; then
        warn "旧 tmux 会话 $tmux_name 还在：它占着云上 127.0.0.1:${remote_port_v}。"
        warn "两条隧道抢同一个端口时，新的这条会因 ExitOnForwardFailure 秒退 → 被 systemd 无限重启。"
        if [ "$_keep_tmux" = 1 ]; then
            warn "--keep-tmux 给了：不动它 —— **你自己保证别让两条同时占 ${remote_port_v}**"
        elif [ "$_dry" = 1 ]; then
            say "（--dry-run：真跑时会执行 $TMUX_BIN kill-session -t $tmux_name）"
        elif "$TMUX_BIN" kill-session -t "$tmux_name" >/dev/null 2>&1; then
            say "已停掉旧 tmux 会话 $tmux_name（等 1 秒让云上把 ${remote_port_v} 让出来）"
            sleep 1
        else
            warn "kill-session 失败：自己跑 $TMUX_BIN kill-session -t $tmux_name"
        fi
    fi

    # 1b) 旧版单元（老 `dsh-remote systemd` 写的那个名字）同样会抢端口
    lf=$(legacy_unit_file)
    if [ -f "$lf" ]; then
        warn "发现旧版单元 $lf（旧 dsh-remote systemd 生成）—— 它和新单元抢同一个云上端口"
        if [ "$_dry" = 0 ]; then
            systemctl_user disable --now "$LEGACY_UNIT_NAME" >/dev/null 2>&1 || true
            say "已 disable --now $LEGACY_UNIT_NAME（文件留着：rm $lf）"
        fi
    fi

    # 2) 渲染 → 落盘（内容一样就不动文件，幂等；不一样先备份）
    _tmp=$(mktemp) || die "mktemp 失败"
    unit_body "$_sec" "$_burst" "$_interval" >"$_tmp" || {
        rm -f -- "$_tmp"
        die "渲染单元失败"
    }
    if [ "$_dry" = 1 ]; then
        say "== --dry-run：单元内容如下（一个字节都没写）"
        cat -- "$_tmp"
        rm -f -- "$_tmp"
        if [ "$_watch" = 1 ]; then
            say ""
            say "== 内部件（自愈检查）也会写这三个（--no-watch 可关掉；**不是给用户敲的命令**）"
            say "  $(watch_script_file)（0755）"
            say "  $(watch_unit_file)"
            say "  $(watch_timer_file)   # 每 ${_watch_sec}s 跑一次"
            _wtmp=$(mktemp) && watch_script_body >"$_wtmp" && { say ""; cat -- "$_wtmp"; rm -f -- "$_wtmp"; }
        fi
        say ""
        say "真跑时会执行："
        say "  $SYSTEMCTL --user daemon-reload"
        say "  $SYSTEMCTL --user enable --now $UNIT_NAME"
        [ "$_watch" = 1 ] && say "  $SYSTEMCTL --user enable --now $WATCH_TIMER_NAME"
        return 0
    fi
    _changed=1
    if unit_write "$uf" "$_tmp"; then
        say "单元内容没变：$uf"
        _changed=0
    fi
    rm -f -- "$_tmp"

    # 2b) 内部件：自愈检查的脚本 + service + timer（**不在 PATH 上、不是给用户敲的命令**）
    _wtimer_changed=1
    if [ "$_watch" = 1 ]; then
        wsf=$(watch_script_file)
        wuf=$(watch_unit_file)
        wtf=$(watch_timer_file)
        if [ "$_no_enable" = 1 ]; then
            say "内部件      自愈检查：$wsf + $wuf + $wtf（--no-enable：先不 enable）"
        else
            say "内部件      自愈检查：每 ${_watch_sec}s 看一眼隧道口（$WATCH_TIMER_NAME）"
        fi
        _tmp=$(mktemp) || die "mktemp 失败"
        watch_script_body >"$_tmp" || {
            rm -f -- "$_tmp"
            die "渲染自愈脚本失败"
        }
        unit_write "$wsf" "$_tmp" >/dev/null || true
        chmod 0755 -- "$wsf" || die "chmod $wsf 失败"
        _tmp=$(mktemp) || die "mktemp 失败"
        watch_unit_body >"$_tmp" || {
            rm -f -- "$_tmp"
            die "渲染自愈单元失败"
        }
        unit_write "$wuf" "$_tmp" >/dev/null || true
        _tmp=$(mktemp) || die "mktemp 失败"
        watch_timer_body "$_watch_sec" >"$_tmp" || {
            rm -f -- "$_tmp"
            die "渲染自愈 timer 失败"
        }
        if unit_write "$wtf" "$_tmp"; then
            _wtimer_changed=0
        fi
    fi

    if [ "$_no_enable" = 1 ]; then
        say ""
        say "--no-enable：只写了单元，没 daemon-reload / enable / start。自己来："
        say "  systemctl --user daemon-reload && systemctl --user enable --now $UNIT_NAME"
        [ "$_watch" = 1 ] && say "  systemctl --user enable --now $WATCH_TIMER_NAME"
        return 0
    fi

    say ""
    say "== daemon-reload + enable --now $UNIT_NAME"
    _nr_before=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
    unit_enable "$UNIT_NAME" "$_changed" || return 1
    if [ "$_watch" = 1 ]; then
        # 自愈 timer：它只是"每 5 分钟看一眼"，enable 失败不该把隧道那条算失败
        say "== enable --now $WATCH_TIMER_NAME（内部件）"
        unit_enable "$WATCH_TIMER_NAME" "$_wtimer_changed" || warn "自愈 timer 没 enable 上（隧道本身不受影响）"
    fi

    # 3) 起来之后**停 3 秒再看一遍**：Type=simple 的 active 只说明进程被 fork 出来了；
    #    认证失败 / 端口被占的 ssh 会立刻退，光看 is-active 看不出来 —— 要看 NRestarts。
    sleep 3
    _state=$(systemctl_user is-active "$UNIT_NAME" 2>/dev/null || true)
    [ -n "$_state" ] || _state=未知
    _enabled=$(systemctl_user is-enabled "$UNIT_NAME" 2>/dev/null || true)
    [ -n "$_enabled" ] || _enabled=未知
    _pid=$(systemctl_user show -p MainPID --value "$UNIT_NAME" 2>/dev/null || printf '')
    _nr=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
    _lg=$(linger_state)
    _pid_txt=${_pid:-0}
    [ "$_pid_txt" = 0 ] && _pid_txt='<MainPID>'

    say ""
    say "== 判据"
    say "服务      is-active=$_state  is-enabled=$_enabled  MainPID=${_pid:-0}  NRestarts=${_nr:-?}"
    say "日志      journalctl --user -u $UNIT_NAME -n 20 -f"
    say "本机      ss -ltn 里**不该**有 ${remote_port_v}（反向隧道不在本地听）；应该有 ${local_port_v}"
    say "云上      ssh ${ssh_user}@${host} \"ss -ltn | grep ${remote_port_v}\"   # 应看到 127.0.0.1:${remote_port_v}"
    say "公网      curl -sk https://<public_url 的 host:port>/   # 不带密码应 401（basic auth 在挡）"
    say "一键体检  dsh-remote tunnel-status --probe"
    say "断线自测  kill ${_pid_txt} → 过几秒 systemctl --user is-active $UNIT_NAME 应回 active"
    if [ "$_watch" = 1 ]; then
        say "内部件    $WATCH_TIMER_NAME 每 5 分钟看一眼云上那个口（不在听才重启；看它："
        say "          systemctl --user list-timers $WATCH_TIMER_NAME；日志：journalctl -t dsh-tunnel-watch）"
    fi
    say "linger    Linger=$_lg"
    [ "$_lg" = yes ] || say "          登录会话一结束服务就停 → loginctl enable-linger $_me"

    # NRestarts 是**累计**计数器：`systemctl restart` 会把它**清零**，所以只有"涨了"
    # 才说明真在反复重启（拿 != 比会把清零当成异常，2026-10-07 踩过）。
    if [ -n "$_nr" ] && [ -n "$_nr_before" ]; then
        case $_nr in *[!0-9]*) _nr_num=0 ;; *) _nr_num=$_nr ;; esac
        case $_nr_before in *[!0-9]*) _nr_before_num=0 ;; *) _nr_before_num=$_nr_before ;; esac
        if [ "$_nr_num" -gt "$_nr_before_num" ]; then
            warn ""
            warn "⚠️ 这次起来之后它已经在重启了（NRestarts $_nr_before → $_nr）："
            warn "   多半是云上 ${remote_port_v} 被别的隧道占着"
            warn "   （ExitOnForwardFailure=yes 让 ssh 秒退 → Restart=always 无限重试，hazards H14），"
            warn "   或者登录 / 密钥不对（auth 失败也会一次次重试 —— H16）。"
            warn "   ${_interval}s 内失败 ${_burst} 次它会自己停下（H27），之后等自愈 timer 来看。最近几行："
            systemctl_user --no-pager -l status "$UNIT_NAME" 2>&1 | tail -n 12 >&2 || true
        fi
    fi
}

cmd_tunnel_uninstall() {
    _dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "tunnel-uninstall 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    uf=$(unit_file)
    lf=$(legacy_unit_file)
    wsf=$(watch_script_file)
    wuf=$(watch_unit_file)
    wtf=$(watch_timer_file)
    say "撤销单元  $uf"
    [ -f "$lf" ] && say "          $lf（旧版生成的，一起撤）"
    say "内部件    $wuf + $wtf + $wsf（自愈检查，一起撤）"
    if [ "$_dry" = 1 ]; then
        say "（--dry-run：会 disable --now、删单元文件、daemon-reload；一个字节都没动）"
        return 0
    fi
    if systemd_user_ok; then
        systemctl_user disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
        [ -f "$lf" ] && systemctl_user disable --now "$LEGACY_UNIT_NAME" >/dev/null 2>&1
        # 自愈 timer 要先停：它每 5 分钟会 restart 一次隧道，不停就把刚停掉的又拉起来
        [ -f "$wtf" ] && systemctl_user disable --now "$WATCH_TIMER_NAME" >/dev/null 2>&1
        [ -f "$wuf" ] && systemctl_user disable --now "$WATCH_UNIT_NAME" >/dev/null 2>&1
        systemctl_user daemon-reload >/dev/null 2>&1 || true
        say "已 disable --now（服务停了、开机不再自启）"
    else
        warn "systemctl --user 连不上（用户管理器没在跑）：只删文件（服务本来也没跑）"
    fi
    rm -f -- "$uf" && say "已删 $uf"
    if [ -f "$lf" ]; then
        rm -f -- "$lf" && say "已删 $lf"
    fi
    [ -f "$wuf" ] && rm -f -- "$wuf" && say "已删 $wuf"
    [ -f "$wtf" ] && rm -f -- "$wtf" && say "已删 $wtf"
    [ -f "$wsf" ] && rm -f -- "$wsf" && say "已删 $wsf"
    # 目录只在空的时候删（里面可能有别的东西；空目录也说明我们撤干净了）
    rmdir -- "$(dirname -- "$wsf")" 2>/dev/null || true
    say "想临时跑前台隧道：dsh-remote tunnel"
}

cmd_tunnel_status() {
    _probe=0
    _iface=
    while [ $# -gt 0 ]; do
        case $1 in
        --probe)
            _probe=1
            shift
            ;;
        --interface)
            _iface=${2:-}
            shift 2
            ;;
        *) die "tunnel-status 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    _me=$(id -un)
    uf=$(unit_file)
    lf=$(legacy_unit_file)

    say "配置      $CONF$([ -f "$CONF" ] || printf '（还没有，先照 remote.conf.example 抄一份）')"
    say "单元      $uf$([ -f "$uf" ] || printf '（还没有：dsh-remote tunnel-install）')"
    if [ -f "$uf" ]; then
        # is-active / is-enabled 对 activating / disabled 是**非 0** 退出码，但照样打印状态词：
        # 别写成 `|| printf 未知`，那会把 "activating\n未知" 拼在一起（2026-10-07 踩过）。
        _state=$(systemctl_user is-active "$UNIT_NAME" 2>/dev/null || true)
        [ -n "$_state" ] || _state=未知
        _enabled=$(systemctl_user is-enabled "$UNIT_NAME" 2>/dev/null || true)
        [ -n "$_enabled" ] || _enabled=未知
        _pid=$(systemctl_user show -p MainPID --value "$UNIT_NAME" 2>/dev/null || printf '')
        _nr=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
        _sec=$(sed -n 's/^RestartSec=//p' "$uf" | head -n 1)
        say "  状态    is-active=$_state  is-enabled=$_enabled  MainPID=${_pid:-0}  NRestarts=${_nr:-?}"
        say "  参数    Restart=always  RestartSec=${_sec:-?}"
        if conf_any cloud_host CLOUD_HOST >/dev/null 2>&1; then
            tunnel_conf
            _want=$(unit_body "${_sec:-3}" 2>/dev/null | sed -n 's/^ExecStart=//p')
            _have=$(sed -n 's/^ExecStart=//p' "$uf" | head -n 1)
            if [ "$_want" = "$_have" ]; then
                say "  一致性  单元里的 ssh 参数和现在的 remote.conf 一致 ✓"
            else
                say "  一致性  **和现在的 remote.conf 对不上了** —— 改了配置就重跑 dsh-remote tunnel-install"
                say "          单元里：$_have"
                say "          现在渲染：$_want"
            fi
        fi
    fi
    [ -f "$lf" ] && warn "旧版单元还在：$lf（会抢云上端口；dsh-remote tunnel-uninstall 会一起撤）"

    if ! conf_any cloud_host CLOUD_HOST >/dev/null 2>&1; then
        say "隧道      remote.conf 里还没写 cloud_host（照 remote.conf.example 抄一份）"
        return 0
    fi

    tunnel_conf
    say "映射      云上 127.0.0.1:${remote_port_v} → 家里 127.0.0.1:${local_port_v}（${ssh_user}@${host}:${ssh_port}）"
    _p=$(pgrep -af "ssh .*-R 127\.0\.0\.1:${remote_port_v}:" 2>/dev/null | head -n 1)
    if [ -n "$_p" ]; then
        say "进程      $_p"
    else
        say "进程      没有一条占着 ${remote_port_v} 的 ssh -R"
    fi
    if tmux_has_session; then
        warn "tmux      会话 $tmux_name 还在（占着云上 ${remote_port_v}）：$TMUX_BIN kill-session -t $tmux_name"
    else
        say "tmux      没有 $tmux_name 会话"
    fi
    if port_listening "$remote_port_v"; then
        warn "本机      ${remote_port_v} 在本地听着（**反向隧道不该在本地听**：这是别的进程）"
    else
        say "本机      ${remote_port_v} 本地没听 ✓（反向隧道正常就该这样）"
    fi
    if port_listening "$local_port_v"; then
        say "harness   127.0.0.1:${local_port_v} 在跑 ✓"
    else
        say "harness   127.0.0.1:${local_port_v} 没在听（dsh web 没跑？）"
    fi
    say "linger    Linger=$(linger_state)"
    [ "$(linger_state)" = yes ] || say "          no 的话登录会话一结束服务就停：loginctl enable-linger $_me"

    # token broker（手机固定地址靠它把 / 302 到当前 token）
    buf=$(broker_unit_file)
    say "broker    单元 $buf$([ -f "$buf" ] || printf '（没装：dsh-remote broker-install）')"
    if [ -f "$buf" ]; then
        _bs=$(systemctl_user is-active "$BROKER_UNIT_NAME" 2>/dev/null || true)
        [ -n "$_bs" ] || _bs=未知
        _be=$(systemctl_user is-enabled "$BROKER_UNIT_NAME" 2>/dev/null || true)
        [ -n "$_be" ] || _be=未知
        say "          状态 is-active=$_bs  is-enabled=$_be"
    fi
    _tf=$(token_file)
    if [ -s "$_tf" ]; then
        say "          token 文件有（$(wc -c <"$_tf" | tr -d ' ') 字节，$(date -r "$_tf" '+%m-%d %H:%M' 2>/dev/null || printf '?' 修改)）—— harness 正在跑"
    else
        say "          token 文件没有（$_tf）—— 用 env 里的 harness 函数起一次 dsh web 就会有"
    fi
    if port_listening "$broker_local_port"; then
        say "          本机 127.0.0.1:${broker_local_port} 在听 ✓"
    else
        say "          本机 127.0.0.1:${broker_local_port} 没在听（broker 没跑？）"
    fi

    if [ "$_probe" = 1 ]; then
        say ""
        say "== --probe：上云只读看一眼（ss / curl，不改云上任何东西）"
        _opts="-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -p $ssh_port"
        [ -n "$identity_key" ] && _opts="$_opts -i $identity_key"
        # 远端脚本走 stdin（sh -s）：比把一整串塞进 ssh 的参数里少一层引号地狱
        # shellcheck disable=SC2086
        _out=$(ssh $_opts "${ssh_user}@${host}" sh -s <<EOF 2>&1
ss -ltn | grep '127.0.0.1:${remote_port_v}' || echo '（云上 ${remote_port_v} 没有监听）'
printf 'http_code=%s\n' "\$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 http://127.0.0.1:${remote_port_v}/)"
printf 'broker_http_code=%s\n' "\$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 http://127.0.0.1:${broker_remote_port}/)"
EOF
        )
        printf '%s\n' "$_out" | sed 's/^/  /'
        case $_out in
        *http_code=401*) say "  判据    dsh web：云上在听，请求穿到了家里的 dsh web（它自己还要 token，所以回 401 原文）✓" ;;
        *http_code=000*) warn "  判据    dsh web：云上那个端口没通（隧道断了 / 云上没在听）" ;;
        *) say "  判据    dsh web：自己看 http_code（401 = 到家里了；其它码看 hazards H11）" ;;
        esac
        case $_out in
        *broker_http_code=302*) say "  判据    broker：不带 token 的入口 302 到当前 token ✓（手机收藏的固定地址就是它）" ;;
        *broker_http_code=503*) say "  判据    broker：503 —— 家里 harness 还没用 env 里的 harness 函数起过（没 token），或 broker 没装" ;;
        *broker_http_code=*) say "  判据    broker：自己看 broker_http_code（302 = 好；503 = 没 token；000 = 隧道那条没通）" ;;
        esac

        _pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
        if [ -n "$_pub" ]; then
            _cif=
            [ -n "$_iface" ] && _cif="--interface $_iface"
            # shellcheck disable=SC2086
            _code=$(curl -sk $_cif -o /dev/null -w '%{http_code}' --max-time 10 "$_pub" 2>/dev/null || printf '000')
            say "  公网    $_pub → HTTP $_code（不带密码应 401 = Caddy 在挡）"
        fi
    fi
}

# --------------------------------------------- token broker（手机固定地址那半）
# 背景：`dsh web` 的 token 是**每个进程随机、只在内存里**的（没有"固定 token / 关鉴权"
# 的官方开关，2026-10-07 查过 `dsh web --help` 与 dsh-client-connection 源码）。
# 于是：`harness` 函数（env.zsh / env.bash）把启动时打印的 token 写进状态文件，
# 家里这个 broker 把「不带 token 的 / 请求」302 到 `/?token=<当前值>`，
# Caddy 只在这一种请求上把流量给它 —— 手机收藏的固定地址就永远能用（ADR-0014）。
# **broker 只做重定向，不代理任何应用流量**（SSE/WebSocket 一律 Caddy 直连 dsh web）。
BROKER_UNIT_NAME=dsh-token-broker.service
broker_unit_file() { printf '%s/%s' "$(unit_dir)" "$BROKER_UNIT_NAME"; }
token_file() { printf '%s' "${DSH_REMOTE_TOKEN_FILE:-$STATE_DIR/current-token.txt}"; }

broker_unit_body() { # 渲染 broker 单元（ExecStart 是绝对路径的 python3 + 本脚本）
    _py=${DSH_REMOTE_PYTHON:-$(command -v python3 2>/dev/null || printf '')}
    [ -n "$_py" ] || die "PATH 里没有 python3（broker 是 python3 写的，单元里要绝对路径）"
    _bin=$SELF_DIR/dsh-token-broker
    [ -f "$_bin" ] || die "找不到 $_bin（wtool install 过吗？）"
    tunnel_conf # 拿 broker_local_port / local_port_v
    case $broker_local_port in '' | off | OFF | Off | 0) die "broker_local_port=off：那就别装 broker" ;; esac
    cat <<EOF
[Unit]
Description=DSH token broker（把不带 token 的入口 302 到当前 token）
Documentation=file:$PROJ_DIR/README.md
# 0 = 无限重试（同 dsh-tunnel.service；这个键属于 [Unit]）
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=$(sd_quote "$_py") $(sd_quote "$_bin") --port $(sd_quote "$broker_local_port") --web-port $(sd_quote "$local_port_v") --token-file $(sd_quote "$(token_file)")
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-token-broker

[Install]
WantedBy=default.target
EOF
}

# ---------------------------------------------------------------- dsh web 常驻（systemd --user）
#   开机自动开会话；`harness` 会优先复用它（有服务就不再前台起第二个）。
#   端口被占（用户手起的 harness/serve 还在跑）→ dsh-web-run 退出 1，
#   systemd 按 RestartSec=30 重试 —— 等那个会话结束它自然接管，绝不打断人家。
SERVE_UNIT_NAME=dsh-web.service
serve_unit_file() { printf '%s/%s' "$(unit_dir)" "$SERVE_UNIT_NAME"; }
serve_unit_body() {
    _run=$SELF_DIR/dsh-web-run
    [ -f "$_run" ] || die "找不到 $_run（wtool install 过吗？）"
    _sh=$(command -v sh 2>/dev/null || printf '/bin/sh')
    tunnel_conf
    cat <<EOF
[Unit]
Description=DSH web（家里的 dsh 会话；开机自动起，端口被占时等它空出来）
Documentation=file:$PROJ_DIR/README.md
StartLimitIntervalSec=0
After=network-online.target

[Service]
Type=simple
ExecStart=$(sd_quote "$_sh") $(sd_quote "$_run") --port $(sd_quote "$local_port_v")
# ⚠️ 这里**不要**放 ExecStartPost 去 try-restart 隧道：端口被占时本服务会每 30 秒
#    重试一次，而 ExecStartPost 在那种"起来就退出"的尝试里也会跑 → 隧道被反复重启，
#    手机链路每 30 秒断一次（2026-10-07 实测踩到）。重连改在 dsh-web-run 里：
#    **只有真抓到 token（会话确实起来了）** 才 try-restart 隧道。
Restart=always
# 30 秒：端口被手起的会话占着时，不必每 3 秒去敲一次门
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-web

[Install]
WantedBy=default.target
EOF
}

cmd_serve_status() {
    uf=$(serve_unit_file)
    say "web 单元      $uf"
    if [ -f "$uf" ]; then
        say "  已装        是（enabled=$(systemctl_user is-enabled "$SERVE_UNIT_NAME" 2>/dev/null || printf '未知') / active=$(systemctl_user is-active "$SERVE_UNIT_NAME" 2>/dev/null || printf '未知')）"
    else
        say "  已装        否（装：dsh-remote serve-install）"
    fi
    tunnel_conf
    if port_listening "$local_port_v"; then
        say "端口         127.0.0.1:$local_port_v 有人在听"
    else
        say "端口         127.0.0.1:$local_port_v 没人听"
    fi
    if [ -s "$(token_file)" ]; then
        say "token        有（$(token_file)，$(wc -c <"$(token_file)" | tr -d ' ') 字节）"
    else
        say "token        没有（broker 会回 503）"
    fi
    say "隧道         $(systemctl_user is-active dsh-tunnel.service 2>/dev/null || printf '未装/未跑')"
    say "固定地址     $(conf_any public_url PUBLIC_URL 2>/dev/null || printf '（remote.conf 里没写）')"
}

cmd_serve_install() {
    _dry=0
    _no_enable=0
    while [ $# -gt 0 ]; do
        case $1 in
        --dry-run) _dry=1; shift ;;
        --no-enable)
            _no_enable=1
            shift
            ;;
        *) die "serve-install 不认识的参数：$1（--dry-run / --no-enable）" ;;
        esac
    done
    tunnel_conf
    uf=$(serve_unit_file)
    say "dsh web       127.0.0.1:${local_port_v}（开机自动起；端口被占就不抢，等它空出来）"
    say "跑什么        $SELF_DIR/dsh-web-run --port $local_port_v"
    say "单元          $uf（Restart=always，RestartSec=30）"
    say "起来之后      自动 try-restart dsh-tunnel.service（重连阿里云那条）"
    say ""
    if [ "$_dry" = 0 ] && [ "$_no_enable" = 0 ] && ! systemd_user_ok; then
        warn "systemctl --user 连不上用户管理器（systemd --user 没在跑）。"
        warn "  loginctl enable-linger $(id -un)    # 没登录时也跑用户服务（本机实测不需要 sudo）"
        die "什么都没动"
    fi
    _tmp=$(mktemp) || die "mktemp 失败"
    serve_unit_body >"$_tmp" || {
        rm -f -- "$_tmp"
        die "渲染 web 单元失败"
    }
    if [ "$_dry" = 1 ]; then
        say "== --dry-run：单元内容如下（一个字节都没写）"
        cat -- "$_tmp"
        rm -f -- "$_tmp"
        return 0
    fi
    _changed=1
    if unit_write "$uf" "$_tmp"; then
        say "单元内容没变：$uf"
        _changed=0
    fi
    rm -f -- "$_tmp"
    if [ "$_no_enable" = 1 ]; then
        say "--no-enable：只写了单元。自己来：systemctl --user daemon-reload && systemctl --user enable --now $SERVE_UNIT_NAME"
        return 0
    fi
    unit_enable "$SERVE_UNIT_NAME" "$_changed" || return 1
    sleep 2
    _st=$(systemctl_user is-active "$SERVE_UNIT_NAME" 2>/dev/null || true)
    say ""
    say "状态          ${_st:-未知}"
    if port_listening "$local_port_v"; then
        say "注意          127.0.0.1:$local_port_v 现在有人在听（可能是你手起的会话）。"
        say "              服务不会去抢；每 30 秒试一次，等那个会话结束就自动接管。"
        say "              现在正在跑的那个会话**不受影响**（没被重启）。"
    fi
    say "看日志        journalctl --user -u $SERVE_UNIT_NAME -f"
    say "体检          dsh-remote serve-status"
}

cmd_serve_uninstall() {
    uf=$(serve_unit_file)
    say "撤掉 web 常驻服务：$SERVE_UNIT_NAME（正在跑的会话**不动**）"
    if systemd_user_ok; then
        systemctl_user disable --now "$SERVE_UNIT_NAME" >/dev/null 2>&1 || true
    fi
    if [ -f "$uf" ]; then
        _bak="$uf.bak-$(date +%Y%m%d-%H%M%S)"
        mv -f -- "$uf" "$_bak" && say "单元移走：$_bak"
    else
        say "单元本来就不在"
    fi
    if systemd_user_ok; then systemctl_user daemon-reload >/dev/null 2>&1 || true; fi
    say "完事。复查：systemctl --user list-unit-files | grep dsh"
}

cmd_token_broker() { # 前台跑 broker（常驻用 broker-install；这条留着手工调试）
    _port=
    _web=
    _tf=
    while [ $# -gt 0 ]; do
        case $1 in
        --port)
            _port=${2:-}
            shift 2
            ;;
        --web-port)
            _web=${2:-}
            shift 2
            ;;
        --token-file)
            _tf=${2:-}
            shift 2
            ;;
        *) die "token-broker 不认识的参数：$1（--port / --web-port / --token-file）" ;;
        esac
    done
    command -v python3 >/dev/null 2>&1 || die "PATH 里没有 python3"
    tunnel_conf
    [ -n "$_port" ] && broker_local_port=$_port
    [ -n "$_web" ] && local_port_v=$_web
    [ -n "$_tf" ] || _tf=$(token_file)
    say "token broker：http://127.0.0.1:${broker_local_port}/ → 302 /?token=（token 文件 $(token_file)）"
    say "（云上那条反向隧道：127.0.0.1:${broker_remote_port} → 这里；Caddy 只把「不带 token 的 /」给它）"
    exec python3 "$SELF_DIR/dsh-token-broker" \
        --port "$broker_local_port" --web-port "$local_port_v" --token-file "$_tf"
}

cmd_broker_install() {
    _dry=0
    _no_enable=0
    while [ $# -gt 0 ]; do
        case $1 in
        --no-enable)
            _no_enable=1
            shift
            ;;
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "broker-install 不认识的参数：$1（--no-enable / --dry-run）" ;;
        esac
    done
    tunnel_conf
    uf=$(broker_unit_file)
    say "token broker  127.0.0.1:${broker_local_port}（云上 127.0.0.1:${broker_remote_port} → 这里，走同一条 ssh）"
    say "token 文件    $(token_file)（由 env.zsh / env.bash 里的 harness 函数写）"
    say "单元          $uf（Restart=always，RestartSec=3）"
    say ""
    if [ "$_dry" = 0 ] && [ "$_no_enable" = 0 ] && ! systemd_user_ok; then
        warn "systemctl --user 连不上用户管理器（systemd --user 没在跑）。"
        warn "  loginctl enable-linger $(id -un)    # 没登录时也跑用户服务（本机实测不需要 sudo）"
        die "什么都没动"
    fi
    _tmp=$(mktemp) || die "mktemp 失败"
    broker_unit_body >"$_tmp" || {
        rm -f -- "$_tmp"
        die "渲染 broker 单元失败"
    }
    if [ "$_dry" = 1 ]; then
        say "== --dry-run：单元内容如下（一个字节都没写）"
        cat -- "$_tmp"
        rm -f -- "$_tmp"
        say ""
        say "真跑时会执行："
        say "  $SYSTEMCTL --user daemon-reload"
        say "  $SYSTEMCTL --user enable --now $BROKER_UNIT_NAME"
        return 0
    fi
    _changed=1
    if unit_write "$uf" "$_tmp"; then
        say "单元内容没变：$uf"
        _changed=0
    fi
    rm -f -- "$_tmp"
    if [ "$_no_enable" = 1 ]; then
        say ""
        say "--no-enable：只写了单元。自己来："
        say "  systemctl --user daemon-reload && systemctl --user enable --now $BROKER_UNIT_NAME"
        return 0
    fi
    say ""
    say "== daemon-reload + enable --now $BROKER_UNIT_NAME"
    unit_enable "$BROKER_UNIT_NAME" "$_changed" || return 1

    sleep 2
    _state=$(systemctl_user is-active "$BROKER_UNIT_NAME" 2>/dev/null || true)
    [ -n "$_state" ] || _state=未知
    _enabled=$(systemctl_user is-enabled "$BROKER_UNIT_NAME" 2>/dev/null || true)
    [ -n "$_enabled" ] || _enabled=未知
    _code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:${broker_local_port}/" 2>/dev/null || printf '000')
    say ""
    say "== 判据"
    say "服务      is-active=$_state  is-enabled=$_enabled"
    say "本机      curl -s -D - http://127.0.0.1:${broker_local_port}/   # 有 token → 302；没 token → 503"
    say "现在      HTTP $_code$([ "$_code" = 503 ] && printf '（还没有 token：先在家里跑一次 harness）')"
    say "日志      journalctl --user -u $BROKER_UNIT_NAME -n 20 -f"
    say "云上      ssh ${ssh_user}@${host} \"curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:${broker_remote_port}/\"   # 应 302/503"
    say "体检      dsh-remote tunnel-status --probe"
}

cmd_broker_uninstall() {
    _dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "broker-uninstall 不认识的参数：$1（--dry-run）" ;;
        esac
    done
    uf=$(broker_unit_file)
    say "撤销单元  $uf"
    if [ "$_dry" = 1 ]; then
        say "（--dry-run：会 disable --now、删单元文件、daemon-reload；一个字节都没动）"
        return 0
    fi
    if systemd_user_ok; then
        systemctl_user disable --now "$BROKER_UNIT_NAME" >/dev/null 2>&1 || true
        systemctl_user daemon-reload >/dev/null 2>&1 || true
        say "已 disable --now（服务停了、开机不再自启）"
    else
        warn "systemctl --user 连不上（用户管理器没在跑）：只删文件"
    fi
    rm -f -- "$uf" && say "已删 $uf"
    say "token 文件 $(token_file) 留着（harness 函数还在写它）"
}

# ------------------------------------------------- 改密码（家里一条命令）
# 为什么要有它：以前 relay-password.txt 里写的是"三步教程"，用户照做会撞两次墙
# （relay.sh 先要 root、加 sudo 又说没有 docker compose），而且命令是**折行**的 ——
# 只复制前半行就掉参数、被报"没有 compose"，指错方向（hazards H23）。
# 这条命令：云上算哈希 → **只替换 Caddyfile 里 basic_auth 那一行**（不整份重渲染：
# 重渲染会重新随机/改一堆无关东西，还会让容器 recreate）→ `docker restart` →
# **从家里验旧密码被拒、新密码能过** → 同步云上 relay-password.txt（600）。
relay_dir_conf() { conf_any relay_dir RELAY_DIR 2>/dev/null || printf '/home/mindul/dsh-relay'; }

cloud_ssh() { # cloud_ssh <远端命令…>（BatchMode；用 conf 里的身份/端口）
    _opts="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -p $ssh_port"
    [ -n "$identity_key" ] && _opts="$_opts -i $identity_key"
    # shellcheck disable=SC2086
    ssh $_opts "${ssh_user}@${host}" "$@"
}

cloud_docker_cmd() { # 探出这台云上该用 `docker` 还是 `sudo docker`（H18）
    if cloud_ssh 'docker info >/dev/null 2>&1' 2>/dev/null; then
        printf 'docker'
    elif cloud_ssh 'sudo -n docker info >/dev/null 2>&1' 2>/dev/null; then
        printf 'sudo docker'
    else
        printf ''
    fi
}

cmd_passwd() {
    _user=
    _password=
    _dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --user)
            _user=${2:-}
            shift 2
            ;;
        --password)
            _password=${2:-}
            shift 2
            ;;
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "passwd 不认识的参数：$1（--user / --password / --dry-run）" ;;
        esac
    done
    host=$(conf_any cloud_host CLOUD_HOST) || die "remote.conf 里没有 cloud_host"
    ssh_user=$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')
    ssh_port=$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')
    identity_key=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $identity_key in '~/'*) identity_key="$HOME/${identity_key#\~/}" ;; esac
    public_url=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
    _user=${_user:-$(conf_any web_user WEB_USER 2>/dev/null || printf 'dsh')}
    _dir=$(relay_dir_conf)
    case $_user in '' | *[!A-Za-z0-9_.-]*) die "用户名只能是字母数字和 _ . -：$_user" ;; esac

    if [ -z "$_password" ]; then
        printf '新密码（回车 = 自动生成 20 位随机）: ' >&2
        IFS= read -r _password || _password=
        [ -n "$_password" ] || _password=$(derive_password)
    fi
    case $_password in
    *"'"*) die "密码里别用单引号（要塞进远程命令行，单引号最容易出事）" ;;
    esac
    case $_password in
    *[!A-Za-z0-9_.@%+=:-]*) die "密码里别用引号/空格这类字符（要塞进远程命令行）" ;;
    esac

    say "云上        ${ssh_user}@${host}:${ssh_port}（目录 $_dir）"
    say "用户名      $_user"
    say "入口        ${public_url:-https://${host}:8443/}"
    say ""

    if [ "$_dry" = 1 ]; then
        say "== --dry-run：会做这些（一个字节都不改）"
        say "  ① 云上算哈希： <docker> run --rm caddy:2.11.4 caddy hash-password --plaintext '<新密码>'"
        say "  ② 备份 $_dir/Caddyfile → Caddyfile.bak-<时间戳>，**只把 basic_auth 里 $_user 那行的哈希换掉**"
        say "  ③ <docker> restart dsh-relay，等它回 401（最多 20 秒）"
        say "  ④ 更新 $_dir/relay-password.txt 的 PASSWORD= 行（600）"
        say "  ⑤ 从家里验：旧密码应 401、新密码应 200/302"
        return 0
    fi

    _dk=$(cloud_docker_cmd)
    [ -n "$_dk" ] || die "云上 docker 用不了（docker info 和 sudo -n docker info 都不行）"
    say "== ① 云上算密码哈希（$_dk run --rm caddy:2.11.4）"
    _hash=$(cloud_ssh "$_dk run --rm caddy:2.11.4 caddy hash-password --plaintext '$_password'" 2>/dev/null | tr -d '\r' | tail -n 1)
    case $_hash in
    '$2a$'* | '$2b$'* | '$2y$'*) ;;
    *) die "没算出哈希（拿到的是：$_hash）—— 云上 caddy:2.11.4 镜像在吗？" ;;
    esac
    say "   ok（哈希已拿到，${#_hash} 字符）"

    _old=$(cloud_ssh "sed -n 's/^PASSWORD=//p' '$_dir/relay-password.txt' 2>/dev/null | tail -n 1" 2>/dev/null | tr -d '\r')
    _hostport=${public_url#https://}
    _hostport=${_hostport%%/*}
    [ -n "$_hostport" ] || _hostport="${host}:8443"
    _port=${_hostport##*:}

    say "== ② 只改 $_dir/Caddyfile 里 $_user 那行的哈希（先备份）"
    # 远端脚本走 stdin：哈希/密码/用户名都是本地变量，避免在命令行里再拼一层引号
    cloud_ssh sh -s <<EOF || return 1
set -eu
cd '$_dir'
[ -f Caddyfile ] || { echo "  ✗ 没有 $_dir/Caddyfile" >&2; exit 1; }
cp -f Caddyfile "Caddyfile.bak-\$(date +%Y%m%d-%H%M%S)"
awk -v u='$_user' -v h='$_hash' '
  BEGIN { done = 0 }
  {
    if (!done && \$1 == u && \$2 ~ /^\\\$2[aby]\\\$/) { sub(/\\\$2[aby]\\\$[^ \\t]*/, h); done = 1 }
    print
  }
  END { if (!done) { print "  ✗ Caddyfile 里没有用户 " u " 的 bcrypt 哈希行" > "/dev/stderr"; exit 3 } }
' Caddyfile > Caddyfile.new
mv -f Caddyfile.new Caddyfile
echo "   ok（旧 Caddyfile 备份在旁边）"
echo "== ③ 重启 dsh-relay"
$_dk restart dsh-relay >/dev/null
i=0
while [ "\$i" -lt 40 ]; do
  c=\$(curl -sk -o /dev/null -w '%{http_code}' --max-time 3 -H 'Host: $_hostport' "https://127.0.0.1:$_port/" 2>/dev/null || true)
  [ "\$c" = 401 ] && break
  sleep 0.5
  i=\$((i+1))
done
echo "   ok（容器回来了，HTTP \$c）"
echo "== ④ 更新 relay-password.txt（只换 PASSWORD= 那一行）"
if [ -f relay-password.txt ]; then
  awk -v p='$_password' 'BEGIN{d=0} /^PASSWORD=/{print "PASSWORD=" p; d=1; next} {print} END{if(!d) print "PASSWORD=" p}' \\
    relay-password.txt > relay-password.txt.new
  mv -f relay-password.txt.new relay-password.txt
else
  printf 'URL=%s\\nUSER=%s\\nPASSWORD=%s\\n' '${public_url:-https://$_hostport/}' '$_user' '$_password' > relay-password.txt
fi
chmod 600 relay-password.txt
echo "   ok（600）"
EOF

    say "== ⑤ 从家里验（真接口）"
    _iface=${DSH_REMOTE_IFACE:-}
    _cif=
    [ -n "$_iface" ] && _cif="--interface $_iface"
    _url=${public_url:-https://${host}:8443/}
    # shellcheck disable=SC2086
    _new=$(curl -sk $_cif -o /dev/null -w '%{http_code}' --max-time 12 -u "$_user:$_password" "$_url" 2>/dev/null || printf '000')
    case $_new in
    200 | 302 | 303) say "   新密码：HTTP $_new ✓（401 = 没生效；000 = 网络/安全组）" ;;
    *) warn "   新密码：HTTP $_new（预期 200/302）—— 用 dsh-remote tunnel-status --probe 看看中继" ;;
    esac
    if [ -n "$_old" ] && [ "$_old" != "$_password" ]; then
        # shellcheck disable=SC2086
        _oldc=$(curl -sk $_cif -o /dev/null -w '%{http_code}' --max-time 12 -u "$_user:$_old" "$_url" 2>/dev/null || printf '000')
        case $_oldc in
        401) say "   旧密码：401 ✓（已经被换掉了）" ;;
        *) warn "   旧密码：HTTP $_oldc（预期 401 —— 没换掉？）" ;;
        esac
    fi
    say ""
    say "手机怎么用："
    say "  打开 $_url ，basic auth 用户名 $_user / 新密码（上面那个）"
    say "  已经登过的浏览器可能记着旧密码 → 清掉这个站点的密码，或者换无痕窗口"
    say "  固定地址不用换：token 由家里的 broker 补（ADR-0014）"
}

cmd_systemd() { # 旧名字：保留，等价 tunnel-install --no-enable（以前就是"只生成不 enable"）
    say "（旧名字）dsh-remote systemd = dsh-remote tunnel-install --no-enable"
    say "  注意：单元名从 dsh-remote-tunnel.service 换成了 $UNIT_NAME（配置在 $CONF）"
    cmd_tunnel_install --no-enable "$@"
}

# ------------------------------------------------------------------ 推送
cmd_notify_test() { "$NOTIFY" --test; say "已尝试推送，看手机。失败细节：$STATE_DIR/notify.log"; }

cmd_url() {
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
    [ -n "$pub" ] || die "remote.conf 里还没有 public_url（云端 Caddy 装好之后填）"
    say "$pub"
}

# 把 profile 的 patch 文件里我们那一段换掉/删掉。
# 用标记注释围起来，这样 disable 一定是精确删除，不会误伤别人写的行。
patch_file() { printf '%s' "$DSH_HOME/profiles/web/cordis.patch.yml"; }

patch_block() {
    cat <<EOF
# >>> dsh-remote notify（这一段由 dsh-remote notify-enable 生成，notify-disable 删；别手改）
# 必须写成 - insert: 的形式。profile 的 patch 层是"按 id 覆盖已有的行 + insert 列表"，
# 光写 - id: xxx 会被当成"覆盖一个叫 xxx 的已有行"，于是 boot 时警告
#   patch: entry "hooks-claude-code" not found
# 然后什么也不发生（这个坑踩过一次，别改回去）。
- insert:
    - id: hooks-claude-code
      name: '@deepseek-ai/dsh-hooks-claude-code'
      config:
        configPath: $CONF_DIR/hooks.json
        defaultTimeoutMs: 20000
# <<< dsh-remote notify
EOF
}

patch_strip() { # 从 stdin 读，输出去掉我们那一段
    awk '
        /^# >>> dsh-remote notify/ { skip = 1; next }
        /^# <<< dsh-remote notify/ { skip = 0; next }
        !skip { print }
    '
}

cmd_notify_enable() {
    mkdir -p -- "$CONF_DIR" "$DSH_HOME/profiles/web"

    hook_src="$PROJ_DIR/hooks/claude-hooks.json"
    [ -f "$hook_src" ] || die "找不到 $hook_src"
    sed "s|__DSH_NOTIFY__|$NOTIFY|g" "$hook_src" >"$CONF_DIR/hooks.json"
    say "已写 $CONF_DIR/hooks.json（命令指向 $NOTIFY）"

    pf=$(patch_file)
    if [ ! -f "$pf" ]; then
        printf '# 你的 profile patch 层（dsh-remote 会往里加一段 hooks 桥）\n[]\n' >"$pf"
        say "已建 $pf"
    fi
    if ! grep -q '^# >>> dsh-remote notify' "$pf"; then
        cp -f -- "$pf" "$pf.bak-dsh-remote" 2>/dev/null || true
        # 空层（注释 + 一行 []）要把 [] 换成真正的列表：YAML 里两个顶层值会
        # 打架，直接追加是不行的。注释留着 —— 那可能是人自己写的说明。
        if grep -qx '\[\]' "$pf"; then
            patch_block >"$pf.block"
            awk -v blockfile="$pf.block" '
                /^\[\]$/ && !done { while ((getline line < blockfile) > 0) print line; done = 1; next }
                { print }
            ' "$pf" >"$pf.tmp"
            rm -f -- "$pf.block"
            # 理论上不会走到，但 [] 没了就退回"直接追加"，别静默丢掉钩子
            if ! grep -q 'hooks-claude-code' "$pf.tmp"; then
                { cat -- "$pf"; patch_block; } >"$pf.tmp"
            fi
        else
            { cat -- "$pf"; patch_block; } >"$pf.tmp"
        fi
        mv -f -- "$pf.tmp" "$pf"
        say "已把 hooks 桥写进 $pf（备份 $pf.bak-dsh-remote）"
    else
        say "$pf 里已经有这一段，跳过"
    fi

    say ""
    say "web profile 的 patchReload 是 live，正常情况下**不用重启**就生效。"
    say "验证：dsh --profile web --dump-config | grep -A3 hooks-claude-code"
    say "重启才生效的话：先 dsh-remote serve（会记下带 token 的新地址）。"
}

cmd_notify_disable() {
    pf=$(patch_file)
    [ -f "$pf" ] || die "没有 $pf"
    patch_strip <"$pf" >"$pf.tmp"
    # 删干净之后如果只剩注释，得补回一个 []：profile 的 patch 层是
    # "空文件或只有注释会让 boot 失败"，必须显式写 []。
    if ! sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$pf.tmp" | grep -q .; then
        printf '[]\n' >>"$pf.tmp"
    fi
    mv -f -- "$pf.tmp" "$pf"
    say "已从 $pf 里删掉 hooks 桥那一段（$CONF_DIR/hooks.json 留着，想再开就 notify-enable）"
}

# ------------------------------------------------------------------ 云端
cmd_cloud_setup() {
    host=$(conf_any cloud_host CLOUD_HOST 2>/dev/null || printf '<你的阿里云公网 IP>')
    user=$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    say "在阿里云那台机器上装 Caddy（在**你这台机器**上执行）："
    say ""
    say "  # 1) 把云上要用的东西传过去（就一个脚本 + 两个 Caddyfile 模板）"
    say "  scp -r $PROJ_DIR/cloud ${user}@${host}:/opt/dsh-relay"
    say ""
    say "  # 2) 登录上去跑它（中继器起成 caddy 容器；宿主上只需 docker）"
    say "  ssh ${user}@${host}"
    say "  cd /opt/dsh-relay && sudo sh relay.sh --tunnel-port $rp"
    say ""
    say "  有域名（且已备案）：加 --domain dsh.example.com    → 443 + Let's Encrypt 证书"
    say "  没域名/IP 没备案：  加 --ip <公网IP> --port 8443  → 自签证书，浏览器会提示一次"
    say "  想再收紧一层：      加 --allow-ip <你家出口IP>/32"
    say ""
    say "  脚本最后会打印：手机该收藏的 https 地址 + 随机生成的用户名/密码。"
    say "  把那个地址写进 $CONF 的 public_url，推送里就会带上它。"
    [ -n "$pub" ] && say ""
    [ -n "$pub" ] && say "现在记的是：$pub"
    say ""
    say "安全组只开放：22（你家的出口 IP）、443（有域名时）或 8443。**绝不要开 $rp 和 $lp**。"
}

# ------------------------------------------------- 云端：真装（一条命令）
# dsh-remote cloud-install --domain dsh.example.com
# dsh-remote cloud-install --ip 47.98.1.2
# 做的事：把 cloud/ 传到云上 /opt/dsh-relay → 跑 relay.sh（把 Caddy 起成
# docker 容器、渲染 Caddyfile、自检）→ 把它打印的地址写回 remote.conf 的 public_url。
cmd_cloud_install() {
    ci_domain=
    ci_ip=
    ci_email=
    ci_port=
    ci_user=
    ci_ssh_user=
    ci_allow=
    ci_dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --domain)
            ci_domain=${2:-}
            shift 2
            ;;
        --ip)
            ci_ip=${2:-}
            shift 2
            ;;
        --email)
            ci_email=${2:-}
            shift 2
            ;;
        --port)
            ci_port=${2:-}
            shift 2
            ;;
        --user)
            ci_user=${2:-}
            shift 2
            ;;
        --allow-ip)
            ci_allow="${ci_allow} ${2:-}"
            shift 2
            ;;
        --ssh-user)
            ci_ssh_user=${2:-}
            shift 2
            ;;
        --dry-run)
            ci_dry=1
            shift
            ;;
        *) die "cloud-install 不认识的参数：$1（--help）" ;;
        esac
    done

    host=$(conf_any cloud_host CLOUD_HOST) || die "remote.conf 里没有 cloud_host（先照 remote.conf.example 抄一份）"
    ssh_user=${ci_ssh_user:-$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')}
    sport=$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    key=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $key in '~/'*) key="$HOME/${key#\~/}" ;; esac

    # 没给 --domain / --ip 时，cloud_host 本身就是公网 IP 的话直接当 --ip 用
    if [ -z "$ci_domain" ] && [ -z "$ci_ip" ]; then
        case $host in
        *[!0-9.]* | '') die "要么 --domain dsh.example.com，要么 --ip <公网IP>" ;;
        *) ci_ip=$host ;;
        esac
    fi

    # 远端脚本的参数拼成一个字符串（它会原样传进 ssh 的那条命令里）
    rargs="--tunnel-port $rp --local-port $lp"
    [ -n "$ci_domain" ] && rargs="$rargs --domain $ci_domain"
    [ -n "$ci_ip" ] && rargs="$rargs --ip $ci_ip"
    [ -n "$ci_email" ] && rargs="$rargs --email $ci_email"
    [ -n "$ci_port" ] && rargs="$rargs --port $ci_port"
    [ -n "$ci_user" ] && rargs="$rargs --user $ci_user"
    for a in $ci_allow; do rargs="$rargs --allow-ip $a"; done

    remote_dir=/opt/dsh-relay
    remote_cmd="cd $remote_dir && if [ \"\$(id -u)\" = 0 ]; then sh relay.sh $rargs; else sudo sh relay.sh $rargs; fi"

    ssh_opts="-p $sport -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
    [ -n "$key" ] && ssh_opts="$ssh_opts -i $key"
    scp_opts="-P $sport -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
    [ -n "$key" ] && scp_opts="$scp_opts -i $key"

    say "云上那台：$ssh_user@$host:$sport"
    say "云上要执行的：cd $remote_dir && sudo sh relay.sh $rargs（Caddy 跑在容器里）"

    if [ "$ci_dry" = 1 ]; then
        say ""
        say "（--dry-run：只打印，不动手。真跑就去掉 --dry-run）"
        say "  scp -r $scp_opts \"$PROJ_DIR/cloud\" $ssh_user@$host:$remote_dir"
        say "  ssh -t $ssh_opts $ssh_user@$host '$remote_cmd'"
        return 0
    fi

    say ""
    say "== 1/3 传 cloud/ 上去（$remote_dir）"
    # shellcheck disable=SC2086
    if ! scp -r $scp_opts "$PROJ_DIR/cloud" "$ssh_user@$host:$remote_dir"; then
        die "scp 失败（云上 ssh 通不通？密钥对不对？$ssh_user@$host:$sport）"
    fi

    say ""
    say "== 2/3 在云上装（Caddy + basic auth + HTTPS；要 sudo 密码的话会提示）"
    out="$STATE_DIR/cloud-install.log"
    mkdir -p -- "$STATE_DIR"
    # shellcheck disable=SC2086
    if ! ssh -t $ssh_opts "$ssh_user@$host" "$remote_cmd" 2>&1 | tee "$out"; then
        warn "云上那步没成功（完整输出在 $out）"
        return 1
    fi

    say ""
    say "== 3/3 把地址记进 $CONF"
    url=$(grep -o 'https://[^ 　]*' "$out" | head -n 1)
    if [ -n "$url" ]; then
        if grep -q '^[[:space:]]*public_url[[:space:]]*=' "$CONF" 2>/dev/null; then
            sed -i "s|^[[:space:]]*public_url[[:space:]]*=.*|public_url=$url|" "$CONF"
        else
            printf 'public_url=%s\n' "$url" >>"$CONF"
        fi
        say "public_url=$url"
    else
        warn "没从输出里认出地址，自己把 relay.sh 打印的那行填进 $CONF 的 public_url"
    fi

    say ""
    say "接下来（回家这台上跑）："
    say "  dsh-remote tunnel     # 起反向隧道（或 dsh-remote systemd 装成常驻）"
    say "  dsh-remote status     # 体检"
    say "手机上打开 $url （basic auth 的用户名/密码就是上面打印的那两组）"
}

# ------------------------------------------------- 从旧的 ~/.dsh 搬过来
cmd_migrate() {
    moved=0
    mkdir -p -- "$CONF_DIR" "$STATE_DIR"
    for f in remote.conf notify.conf hooks.json; do
        if [ -f "$DSH_HOME/$f" ] && [ ! -f "$CONF_DIR/$f" ]; then
            mv -f -- "$DSH_HOME/$f" "$CONF_DIR/$f"
            say "搬走 $DSH_HOME/$f → $CONF_DIR/$f"
            moved=1
        fi
    done
    for f in notify.log web.log web-url.txt; do
        if [ -f "$DSH_HOME/$f" ] && [ ! -f "$STATE_DIR/$f" ]; then
            mv -f -- "$DSH_HOME/$f" "$STATE_DIR/$f"
            say "搬走 $DSH_HOME/$f → $STATE_DIR/$f"
            moved=1
        fi
    done
    rm -f -- "$DSH_HOME/remote.conf.example" "$DSH_HOME/notify.conf.example" 2>/dev/null || true
    if [ "$moved" = 1 ]; then
        say "配置搬到 $CONF_DIR，日志搬到 $STATE_DIR 了。"
        say "记得重跑一次 dsh-remote notify-enable，把 profile patch 里的 hooks.json 路径更新到新位置。"
    else
        say "没有要搬的（$DSH_HOME 下已经没有我们的文件）"
    fi
}


# ------------------------------------------------ 验证钩子桥（不动正在跑的那个实例）
# 背景：profile patch 里挂了 hooks-claude-code，dump-config 里也看得到那一行，
# **但这不等于插件真的加载了**（实测：configPath 指到不存在的文件都不报错；
# 正在跑的实例十几轮没触发过任何钩子）。这条命令用一次性进程做对照实验：
# 起个本地接收端 → 渲染一份临时 patch → 跑一次 headless 任务 → 看有没有收到。
cmd_check_hooks() {
    command -v dsh >/dev/null 2>&1 || die "PATH 里没有 dsh"
    command -v python3 >/dev/null 2>&1 || die "要 python3（起本地接收端）"
    [ -f "$CONF_DIR/hooks.json" ] || die "$CONF_DIR/hooks.json 不存在（先跑 dsh-remote notify-enable）"

    tmp=$(mktemp -d)
    sink="$tmp/sink.txt"
    : >"$sink"
    port=$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')
    python3 "$PROJ_DIR/tests/http_sink.py" "$port" "$sink" >/dev/null 2>&1 &
    sink_pid=$!
    sleep 1

    cat >"$tmp/notify.conf" <<EOF
provider=generic
URL=http://127.0.0.1:$port/hook
on_stop=1
EOF
    cat >"$tmp/patch.yml" <<EOF
- insert:
    - id: hooks-claude-code
      name: '@deepseek-ai/dsh-hooks-claude-code'
      config:
        configPath: $CONF_DIR/hooks.json
EOF

    say "跑一次一次性 harness（dsh --profile headless --patch …）—— 会真的调一次模型，几十秒"
    DSH_NOTIFY_CONF="$tmp/notify.conf" DSH_NOTIFY_LOG="$tmp/notify.log" \
        timeout 300 dsh --profile headless --patch "$tmp/patch.yml" "只回答一个字：好" \
        >"$tmp/out" 2>"$tmp/err" || warn "headless 退出码非 0（细节：$tmp/err）"
    sleep 1
    kill "$sink_pid" 2>/dev/null || true

    if [ -s "$sink" ]; then
        say "✅ 钩子桥**真的会触发**（收到：$(head -c 100 "$sink")）"
        rm -rf "$tmp"
        return 0
    fi
    say "❌ 钩子桥**没有触发** —— 插件没被加载（不是"加载了但事件不匹配"）"
    say "   佐证：把 configPath 指向不存在的文件，harness 也不报错、静默跳过。"
    say "   原因大概率是 profile 的 dependencies 为空 + 本机没有 pnpm，插入的那一行解析不到包。"
    say "   两条路："
    say "     A) npm i -g pnpm && dsh plugin --profile web add @deepseek-ai/dsh-hooks-claude-code"
    say "        然后重启 dsh web（**会打断正在跑的会话**），再跑一次 dsh-remote check-hooks"
    say "     B) 先不靠钩子：dsh-remote notify-test 说明推送通道是好的，需要提醒时手动 dsh-notify"
    say "   诊断文件留在 $tmp（out / err / notify.log / notify.conf）"
    return 1
}

# ------------------------------------------------- 一条命令装好（server）
# `dsh-remote server`：问清"云上哪台、用什么账号" → 自检（ssh / sudo / docker / 安全组）
# → 云上部署（复用 cloud/relay.sh 的用户空间模式）→ 家里装 token broker + 常驻隧道
# → 起 harness（自动捕获 token）→ 打印固定地址 + 二维码。
# 每一步都能单独重跑（幂等）；参数给全 + --yes 就完全不用交互（测试也走这条路）。
derive_password() { # 20 位随机，只用字母数字（要塞进远程命令行，别带引号风险）
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -base64 48 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-20
    else
        LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 20
    fi
}

server_ask() { # server_ask <提示> <默认值>：--yes 或 stdin 不是终端时直接取默认值
    _q=$1
    _d=${2:-}
    if [ "${srv_yes:-0}" = 1 ] || [ ! -t 0 ]; then
        printf '%s' "$_d"
        return 0
    fi
    if [ -n "$_d" ]; then
        printf '%s [%s]: ' "$_q" "$_d" >&2
    else
        printf '%s: ' "$_q" >&2
    fi
    IFS= read -r _a || _a=
    [ -n "$_a" ] || _a=$_d
    printf '%s' "$_a"
}

server_tutorial() {
    _tu=${ssh_user:-<云上用户名>}
    _th=${host:-<云上公网 IP>}
    _tp=${port:-8443}
    cat <<EOF

== 先在阿里云那台配好三件事（一次就够；配完把这条命令重跑一遍）

① 免密登录（家里 → 云上）
   家里这把钥匙：~/.ssh/id_ed25519.pub（没有就 ssh-keygen -t ed25519 生成一把）
     ssh-copy-id -i ~/.ssh/id_ed25519.pub ${_tu}@${_th}
   验收：ssh -o BatchMode=yes -o IdentitiesOnly=yes -i ~/.ssh/id_ed25519 ${_tu}@${_th} true && echo ok
   ⚠️ "能 ssh 上去"不算数：要**不问密码**，而且钥匙得是写进配置的那把 ——
      不带 -i 的前台 ssh 会偷偷换别的钥匙试，systemd 单元里带 -i 就直接 Permission denied
      （2026-10-07 实测踩过，见 docs/hazards.md H16）

② 免密 sudo（中继是一个 docker 容器；只放开 docker 这一条就够）
   在云上执行：
     echo "\$(whoami) ALL=(ALL) NOPASSWD: /usr/bin/docker" | sudo tee /etc/sudoers.d/90-dsh-remote
     sudo chmod 440 /etc/sudoers.d/90-dsh-remote
   验收：ssh ${_tu}@${_th} 'sudo -n docker info >/dev/null && echo ok'
   （那台已经免密 sudo 了的话，这步跳过）

③ 安全组（控制台里点，工具碰不了）：放行 ${_tp}/tcp
   来源最好填你家出口 IP；先 0.0.0.0/0 也能用（入口有 TLS + basic auth 挡着，但越窄越好）
   验收：装完之后在家里 curl -k https://${_th}:${_tp}/ → 401（一直超时 = 没放行）

⚠️ 不许碰云上的 nginx / 80 / 443；我们只用 ${_tp} 这一个口子。
EOF
}

server_qr() { # server_qr <url>
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 "$1" 2>/dev/null || warn "qrencode 画不出来（不影响用）"
        return 0
    fi
    if command -v python3 >/dev/null 2>&1 && [ -f "$SELF_DIR/dsh-qr" ]; then
        say "（没装 qrencode，用自带的 dsh-qr 画；这张码也能扫）"
        # 手机上扫的那张图：静默区 4 模块、每模块整数倍、短边 ≥1024px（dsh-qr 自动挑）
        python3 "$SELF_DIR/dsh-qr" --ecc M --border 4 \
            --png "$STATE_DIR/phone-qr.png" --svg "$STATE_DIR/phone-qr.svg" "$1" ||
            warn "二维码画不出来（不影响用：地址在上面）"
        say "  二维码图片：$STATE_DIR/phone-qr.png（SVG 同名 .svg）—— 打不开就自己打开图片"
    else
        warn "没有 qrencode 也没有 python3/dsh-qr：二维码画不出来，手输地址吧"
    fi
}

conf_set() { # conf_set <键> <值>：文件里有就替换，没有就追加（顺手建目录）
    _k=$1
    _v=$2
    mkdir -p -- "$(dirname -- "$CONF")"
    if [ -f "$CONF" ] && grep -q "^[[:space:]]*$_k[[:space:]]*=" "$CONF"; then
        sed -i "s|^[[:space:]]*$_k[[:space:]]*=.*|$_k=$_v|" "$CONF"
    else
        printf '%s=%s\n' "$_k" "$_v" >>"$CONF"
    fi
}

cmd_server() {
    srv_host=
    srv_ssh_user=
    srv_ssh_port=
    srv_port=
    srv_web_user=
    srv_password=
    srv_dir=
    srv_docker=
    srv_yes=0
    srv_dry=0
    srv_skip_deploy=0
    srv_skip_local=0
    srv_no_harness=0
    srv_tunnel_port=
    srv_broker_port=
    srv_local_port=
    srv_broker_local=
    while [ $# -gt 0 ]; do
        case $1 in
        --host) srv_host=${2:-}; shift 2 ;;
        --ssh-user) srv_ssh_user=${2:-}; shift 2 ;;
        --ssh-port) srv_ssh_port=${2:-}; shift 2 ;;
        --port) srv_port=${2:-}; shift 2 ;;
        --web-user) srv_web_user=${2:-}; shift 2 ;;
        --password) srv_password=${2:-}; shift 2 ;;
        --dir) srv_dir=${2:-}; shift 2 ;;
        --docker-cmd) srv_docker=${2:-}; shift 2 ;;
        --tunnel-port) srv_tunnel_port=${2:-}; shift 2 ;;
        --broker-port) srv_broker_port=${2:-}; shift 2 ;;
        --local-port) srv_local_port=${2:-}; shift 2 ;;
        --broker-local-port) srv_broker_local=${2:-}; shift 2 ;;
        --yes) srv_yes=1; shift ;;
        --dry-run) srv_dry=1; shift ;;
        --skip-deploy) srv_skip_deploy=1; shift ;;
        --skip-local) srv_skip_local=1; shift ;;
        --no-harness) srv_no_harness=1; shift ;;
        *) die "server 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done

    # 1) 收集输入（命令行给过就不问；--yes 一律用默认值）
    say "== 收集信息（不想被问就在命令行给全，或者加 --yes）"
    host=${srv_host:-$(conf_any cloud_host CLOUD_HOST 2>/dev/null || printf '')}
    host=$(server_ask "阿里云那台的公网 IP / 域名" "$host")
    [ -n "$host" ] || {
        server_tutorial
        die "没有 host"
    }
    ssh_user=${srv_ssh_user:-$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf '%s' "$(id -un)")}
    ssh_user=$(server_ask "云上登录用户（免密 ssh 的那个）" "$ssh_user")
    ssh_port=${srv_ssh_port:-$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')}
    ssh_port=$(server_ask "云上 ssh 端口" "$ssh_port")
    port=${srv_port:-8443}
    port=$(server_ask "对外端口（手机访问的）" "$port")
    web_user=${srv_web_user:-$(conf_any web_user WEB_USER 2>/dev/null || printf 'dsh')}
    web_user=$(server_ask "手机登录用的用户名" "$web_user")
    password=${srv_password:-}
    if [ -z "$password" ]; then
        if [ "$srv_yes" = 1 ] || [ ! -t 0 ]; then
            password=$(derive_password)
        else
            printf '手机登录用的密码（回车 = 自动生成 20 位随机）: ' >&2
            IFS= read -r password || password=
            [ -n "$password" ] || password=$(derive_password)
        fi
    fi
    case $password in
    *[!A-Za-z0-9_.@%+=:-]*) die "密码里别用引号/空格这类字符（要塞进远程命令行）：$password" ;;
    esac
    remote_dir=${srv_dir:-/home/mindul/dsh-relay}
    tunnel_port=${srv_tunnel_port:-$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')}
    local_port=${srv_local_port:-$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')}
    broker_port=${srv_broker_port:-$(conf_any broker_remote_port BROKER_REMOTE_PORT 2>/dev/null || printf '18081')}
    broker_local=${srv_broker_local:-$(conf_any broker_local_port BROKER_LOCAL_PORT 2>/dev/null || printf '3081')}
    identity=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $identity in '~/'*) identity="$HOME/${identity#\~/}" ;; esac

    say ""
    say "云上        ${ssh_user}@${host}:${ssh_port}（目录 $remote_dir）"
    say "对外        https://${host}:${port}/   用户名 ${web_user}（密码下面打）"
    say "家里        dsh web 127.0.0.1:${local_port}；token broker 127.0.0.1:${broker_local}"
    say "隧道        云上 ${tunnel_port} → 家里 ${local_port}；云上 ${broker_port} → 家里 ${broker_local}"

    # 2) 自检（每条都带"怎么修"）
    say ""
    say "== 自检"
    _ssh_opts="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -p $ssh_port"
    [ -n "$identity" ] && _ssh_opts="$_ssh_opts -i $identity"
    _ssh_opts_ci="-o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -p $ssh_port"
    srv_ssh() { # srv_ssh <远端命令…>
        # shellcheck disable=SC2086
        ssh $_ssh_opts "$ssh_user@$host" "$@"
    }
    if srv_ssh true 2>/dev/null; then
        _who=$(srv_ssh 'id -un' 2>/dev/null)
        if [ "$_who" = "$ssh_user" ]; then
            say "  ssh     免密登录 ✓（远端 id -un = $_who）"
        else
            warn "  ssh     登进去了，但远端用户是 $_who（≠ $ssh_user）—— 配置里身份对不上，先弄对"
            server_tutorial
            die "自检没过"
        fi
    else
        warn "  ssh     免密登录 ✗（家里 → ${ssh_user}@${host}:${ssh_port}）"
        server_tutorial
        die "自检没过（上面三条照做，再重跑）"
    fi
    # 免密 sudo 和「直接能用 docker」是两件事：那台阿里云上 mindul 免密 sudo 有、
    # 但**不在 docker 组**，所以每条 docker 都要 `sudo docker`（2026-10-07 实测，
    # 第一版把两者混为一谈，真机上直接判成"docker daemon 没反应" —— 见 hazards H18）。
    if ! srv_ssh 'command -v docker >/dev/null 2>&1' 2>/dev/null; then
        warn "  docker  云上没有 docker —— 装它属于改系统，工具不代劳。"
        warn "          阿里云 Ubuntu：sudo apt update && sudo apt install -y docker.io（自己来）"
        server_tutorial
        die "自检没过"
    fi
    if srv_ssh 'docker info >/dev/null 2>&1' 2>/dev/null; then
        say "  docker  daemon 在跑，当前用户直接能用 ✓（命令：docker）"
        srv_docker=${srv_docker:-docker}
    elif srv_ssh 'sudo -n docker info >/dev/null 2>&1' 2>/dev/null; then
        say "  docker  daemon 在跑；这个用户不在 docker 组 → 用「sudo docker」✓"
        srv_docker=${srv_docker:-sudo docker}
    else
        warn "  docker  daemon 没反应（docker info 和 sudo -n docker info 都不行）"
        warn "          云上 systemctl status docker 看看；sudo 没放开就照下面配"
        server_tutorial
        die "自检没过"
    fi
    _occ=$(srv_ssh "ss -ltn 2>/dev/null | awk '{print \$4}' | grep -c '[:.]${port}\$'" 2>/dev/null || printf '0')
    _own=$(srv_ssh "$srv_docker ps --filter name=dsh-relay --format '{{.Names}}' 2>/dev/null" 2>/dev/null || printf '')
    if [ "${_occ:-0}" -gt 0 ] && [ -z "$_own" ]; then
        warn "  端口    ${port} 已经被别的东西占着（不是我们的 dsh-relay）"
        warn "          换一个：--port 8444（记得安全组也放行同一个）"
        die "自检没过"
    fi
    if [ -n "$_own" ]; then
        say "  端口    ${port} 上是我们的 dsh-relay（已经装过 → 这次只重配置）✓"
    else
        say "  端口    ${port} 现在空着 ✓"
    fi
    _code=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 6 "https://${host}:${port}/" 2>/dev/null || printf '000')
    case $_code in
    401 | 200 | 403) say "  安全组  从家里能连上 https://${host}:${port}/（HTTP $_code）✓" ;;
    *) warn "  安全组  从家里连不上（HTTP $_code）—— 控制台里放行 ${port}/tcp（见上面的教程③）"
       warn "          装完再验也一样：curl -k https://${host}:${port}/ 要 401" ;;
    esac

    if [ "$srv_dry" = 1 ]; then
        say ""
        say "== --dry-run：只打印要做的事，一个字节都不写"
        say "  ① scp -r ${identity:+-i $identity }cloud/ ${ssh_user}@${host}:${remote_dir}"
        say "  ② ssh … \"cd ${remote_dir} && sh cloud/relay.sh --ip ${host} --port ${port} \\"
        say "        --tunnel-port ${tunnel_port} --broker-port ${broker_port} --local-port ${local_port} \\"
        say "        --user ${web_user} --password '<生成/给的那个>' --no-compose --dir ${remote_dir} --docker-cmd '${srv_docker}'\""
        say "  ③ 写 $CONF：cloud_host / cloud_user / cloud_ssh_port / remote_port / local_port / broker_* / public_url"
        say "  ④ dsh-remote broker-install（单元 $(broker_unit_file)）"
        say "  ⑤ dsh-remote tunnel-install（单元 $(unit_file)）"
        say "  ⑥ 起 harness（127.0.0.1:${local_port}，token 自动捕获）→ 打印 https://${host}:${port}/ + 二维码"
        return 0
    fi

    # 3) 云上部署（复用 relay.sh 的用户空间模式；幂等）
    if [ "$srv_skip_deploy" = 1 ]; then
        say ""
        say "== 云上部署：--skip-deploy，跳过"
    else
        say ""
        say "== 云上部署（scp cloud/ → relay.sh --no-compose；可重复跑）"
        _scp_opts="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR -P $ssh_port"
        [ -n "$identity" ] && _scp_opts="$_scp_opts -i $identity"
        # shellcheck disable=SC2086
        if ! scp -r $_scp_opts "$PROJ_DIR/cloud" "$ssh_user@$host:$remote_dir"; then
            die "scp 失败（目录 $remote_dir 建得出来吗？$ssh_user@$host:$ssh_port 通吗？）"
        fi
        _out="$STATE_DIR/server-install.log"
        mkdir -p -- "$STATE_DIR"
        _rcmd="cd $remote_dir && sh cloud/relay.sh --ip $host --port $port --tunnel-port $tunnel_port --broker-port $broker_port --local-port $local_port --user $web_user --password '$password' --no-compose --dir $remote_dir --docker-cmd '$srv_docker'"
        # ⚠️ 别写 `srv_ssh … | tee` 再判 $?：管道里拿到的是 **tee** 的退出码，
        # 云上失败会被吞掉（2026-10-07 真机跑时踩到，relay.sh rc=2 却报成功）。
        say "（云上在跑，输出等它跑完一起打）"
        srv_ssh "$_rcmd" >"$_out" 2>&1
        _rc=$?
        cat -- "$_out" || true
        if [ "$_rc" -ne 0 ]; then
            warn "云上那步没成功（rc=$_rc；完整输出在 $_out）"
            return 1
        fi
        say "（完整输出：$_out）"
    fi

    if [ "$srv_skip_deploy" = 1 ]; then
        :
    else
        _chk=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8 "https://${host}:${port}/" 2>/dev/null || printf '000')
        case $_chk in
        401) say "入口判据   https://${host}:${port}/ → 401（basic auth 在挡）✓" ;;
        302) say "入口判据   https://${host}:${port}/ → 302（broker 在补 token）✓" ;;
        000) warn "入口判据   从家里连不上 https://${host}:${port}/ —— 多半是安全组没放行 ${port}/tcp" ;;
        *) warn "入口判据   返回 $_chk（预期 401）—— 云上 docker logs dsh-relay 看看" ;;
        esac
    fi

    # 4) 把这几样写进 remote.conf（下次不用再填）
    conf_set cloud_host "$host"
    conf_set cloud_user "$ssh_user"
    conf_set cloud_ssh_port "$ssh_port"
    conf_set remote_port "$tunnel_port"
    conf_set local_port "$local_port"
    conf_set broker_remote_port "$broker_port"
    conf_set broker_local_port "$broker_local"
    conf_set public_url "https://${host}:${port}"
    say "已写 $CONF（cloud_host / public_url / broker_* …）"

    # 5) 家里：broker + 常驻隧道（两个 systemd --user 单元）
    if [ "$srv_skip_local" = 1 ]; then
        say ""
        say "== 家里：--skip-local，跳过 broker-install / tunnel-install"
    else
        say ""
        say "== 家里 1/2：token broker"
        cmd_broker_install || return 1
        say ""
        say "== 家里 2/2：常驻隧道（含 broker 那条 -R）"
        cmd_tunnel_install --remote-port "$tunnel_port" --local-port "$local_port" || return 1
    fi

    _url="https://${host}:${port}"

    # 6) 起 harness（前台；token 由 env 里的 harness 函数捕获给 broker）
    say ""
    if [ "$srv_no_harness" = 1 ]; then
        say "== harness：--no-harness，不启动。自己起："
        say "   harness --no-open          # 用的是 dsh-remote 装的 env 里的那个函数"
        say "   （那个函数会把 token 写进 $(token_file)，broker 就是靠它补 token 的）"
    elif port_listening "$local_port"; then
        say "== harness：127.0.0.1:${local_port} 上已经有实例在跑 —— **不动它**（重启会打断正在跑的会话）"
        if [ -s "$(token_file)" ]; then
            say "   token 已经捕获过 ✓ → 手机那条固定地址现在就能用"
        else
            warn "   但当前这个实例不是用 env 里的 harness 函数起的 → broker 手里还没有 token，"
            warn "   手机打开固定地址会看到 503「还没有当前 token」。"
            warn "   等这个实例用完、你重新用 harness 起一次（或者 dsh-remote serve）就会自动好。"
        fi
    else
        say "== 起 harness（前台；token 会被自动捕获；Ctrl-C 退出）"
        say "   地址：http://127.0.0.1:${local_port}/"
        say ""
        say "================================================================"
        say "手机怎么用（三步）："
        say "  1) 浏览器打开（或扫下面的二维码）：$_url"
        say "  2) 自签证书警告 → 继续访问（有域名+真证书的话没这一步）"
        say "  3) 弹出 basic auth：用户名 ${web_user}，密码 ${password}"
        say "     进去之后 dsh web 自己的 token 由家里的 broker 自动补上 —— 以后不用再抄地址"
        say "================================================================"
        server_qr "$_url"
        say ""
        _hs=$(command -v bash >/dev/null 2>&1 && printf 'bash' || printf 'sh')
        exec "$_hs" -c ". '$PROJ_DIR/env.$_hs'; harness --no-open --port $local_port"
    fi

    # 7) 收尾：打印用法（跑到这儿说明 harness 没被这个进程接管）
    say ""
    say "================================================================"
    say "手机怎么用（三步）："
    say "  1) 浏览器打开（或扫下面的二维码）：$_url"
    say "  2) 自签证书警告 → 继续访问（有域名+真证书的话没这一步）"
    say "  3) 弹出 basic auth：用户名 ${web_user}，密码 ${password}"
    say "     （这三样也写在云上 ${remote_dir}/relay-password.txt，600）"
    say "================================================================"
    server_qr "$_url"
    say ""
    say "改密码 / 停 / 看日志："
    say "  改密码：云上 cd ${remote_dir} && sh cloud/relay.sh --ip ${host} --port ${port} --password '<新密码>' --no-compose --dir ${remote_dir} --docker-cmd '${srv_docker}'"
    say "  停中继：ssh ${ssh_user}@${host} '${srv_docker} rm -f dsh-relay'"
    say "  看日志：ssh ${ssh_user}@${host} '${srv_docker} logs --tail 50 dsh-relay'"
    say "  家里体检：dsh-remote tunnel-status --probe"
    say "  撤家里：dsh-remote tunnel-uninstall && dsh-remote broker-uninstall"
    say "  别忘了安全组只放 ${port}/tcp：${tunnel_port} / ${broker_port} / 云上 ssh 之外都别开"
}

cmd_log() {
    for f in "$STATE_DIR/notify.log" "$STATE_DIR/web.log"; do
        [ -f "$f" ] || continue
        say "=== $f"
        tail -n 20 -- "$f"
    done
}

usage() {
    # 打到头部注释块结束为止：跳过 shebang，从第 2 行起连着以 # 开头的都打，
    # 碰到第一条正文（空行也算）就停。**别改回写死的行号** —— 已经越界过一次：
    # 注释块到第 21 行，范围却写到 25，于是多打了 `set -u` 和两行无关注释（H10）。
    # （也别用 `sed -n '2,/^[^#]/p'`：空行不匹配 `^[^#]`，会多打一行。）
    awk 'NR == 1 { next } /^#/ { print; next } { exit }' "$0" | sed 's/^# \{0,1\}//'
}

case ${1:-help} in
status) cmd_status ;;
serve) cmd_serve ;;
tunnel) cmd_tunnel ;;
tunnel-install)
    shift
    cmd_tunnel_install "$@"
    ;;
tunnel-uninstall)
    shift
    cmd_tunnel_uninstall "$@"
    ;;
tunnel-status)
    shift
    cmd_tunnel_status "$@"
    ;;
passwd)
    shift
    cmd_passwd "$@"
    ;;
token-broker)
    shift
    cmd_token_broker "$@"
    ;;
broker-install)
    shift
    cmd_broker_install "$@"
    ;;
broker-uninstall)
    shift
    cmd_broker_uninstall "$@"
    ;;
serve-install)
    shift
    cmd_serve_install "$@"
    ;;
serve-uninstall) cmd_serve_uninstall ;;
serve-status) cmd_serve_status ;;

systemd)
    shift
    cmd_systemd "$@"
    ;;
url) cmd_url ;;
notify-test) cmd_notify_test ;;
notify-enable) cmd_notify_enable ;;
notify-disable) cmd_notify_disable ;;
server)
    shift
    cmd_server "$@"
    ;;
cloud-install)
    shift
    cmd_cloud_install "$@"
    ;;
cloud-setup) cmd_cloud_setup ;;
migrate) cmd_migrate ;;
check-hooks) cmd_check_hooks ;;
log) cmd_log ;;
help | --help | -h) usage ;;
*) die "不认识的命令：$1（dsh-remote help）" ;;
esac
