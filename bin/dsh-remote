#!/bin/sh
# dsh-remote —— 手机远程看着/接着指挥家里的 DSH 会话。
#
#   dsh-remote status          体检：harness / 隧道 / 推送 / 手机地址
#   dsh-remote serve           在后台起 harness（--no-open），把带 token 的 URL 存起来
#   dsh-remote tunnel          前台保活一条 SSH 反向隧道（调试用；常驻看 tunnel-install）
#   dsh-remote tunnel-install  装成 systemd --user 常驻服务（Restart=always，断线自动重连）
#   dsh-remote tunnel-uninstall 撤掉它（disable --now + 删单元文件）
#   dsh-remote tunnel-status   看单元/进程/云上隧道口/公网的现状（--probe 上云只读检查）
#   dsh-remote systemd         旧名字：只生成单元、不 enable（= tunnel-install --no-enable）
#   dsh-remote url             打印手机该收藏的地址
#   dsh-remote notify-test     推一条测试消息到手机
#   dsh-remote notify-enable   打开"会话卡住/跑完就推手机"（写配置目录的 hooks.json + profile patch）
#   dsh-remote notify-disable  关掉它（把 patch 里那一段删掉）
#   dsh-remote cloud-install   真装到阿里云上（传 cloud/ → 起 caddy 容器 → 记下地址）
#   dsh-remote cloud-setup     只打印"送上去并执行"的命令，不动手
#   dsh-remote migrate         把旧版放在 ~/.dsh 下的配置/日志搬到我们自己的目录
#   dsh-remote check-hooks     **验证钩子桥到底会不会触发**（一次性进程，跑一次模型，几十秒）
#   dsh-remote log             看隧道/推送日志
#
# 配置在 ~/.config/dsh-remote/remote.conf，日志在 ~/.local/state/dsh-remote/
# （样板：tools/dsh-remote/remote.conf.example）。**~/.dsh 是 DSH 自己的目录**，
# 我们只在里面放一样它强制要求的东西：profiles/web/cordis.patch.yml。
# 安全边界、威胁模型、为什么这么设计：见同目录 README.md。

set -u

# 自己是谁：先解掉软链。~/.local/bin/dsh-remote 是软链，不解的话
# PROJ_DIR 会算成 ~/.local（踩过：status 打印"项目 /home/xxx/.local"，然后
# hooks/claude-hooks.json 也找不到）。
SELF=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
PROJ_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)

# 我们的目录 vs harness 的目录 —— 分清楚，别往别人的目录里放东西：
#
#   $CONF_DIR   ~/.config/dsh-remote/          配置（remote.conf / notify.conf / hooks.json）
#   $STATE_DIR  ~/.local/state/dsh-remote/     日志和运行期文件（notify.log / web.log / web-url.txt）
#   $DSH_HOME   ~/.dsh/                        这是 **DSH 自己的**目录。只有一样东西必须
#                                              放在它里面：profiles/web/cordis.patch.yml ——
#                                              DSH 只从那里读 profile patch，改不了。
#
# DSH_REMOTE_HOME 是一个"伞"覆盖（测试用）：设了它就两个目录都在它下面。
# DSH_HOME 只是跟着 DSH 的约定（$DSH_HOME，默认 ~/.dsh），我们不改它。
DSH_HOME=${DSH_HOME:-$HOME/.dsh}
: "${DSH_REMOTE_HOME:=}"
CONF_DIR=${DSH_REMOTE_CONF_DIR:-${DSH_REMOTE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/dsh-remote}}
STATE_DIR=${DSH_REMOTE_STATE_DIR:-${DSH_REMOTE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/dsh-remote}}
CONF=${DSH_REMOTE_CONF:-$CONF_DIR/remote.conf}
NOTIFY=${DSH_NOTIFY_BIN:-$(command -v dsh-notify 2>/dev/null || printf '%s' "$SELF_DIR/dsh-notify")}

say() { printf '%s\n' "$*"; }
warn() { printf '警告：%s\n' "$*" >&2; }
die() {
    printf '%s\n' "$*" >&2
    exit 1
}

conf() {
    [ -f "$CONF" ] || return 1
    _v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" | tail -n 1)
    _v=$(printf '%s' "$_v" | sed -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
    [ -n "$_v" ] || return 1
    printf '%s' "$_v"
}

conf_any() {
    for k in "$@"; do
        if _r=$(conf "$k"); then printf '%s' "$_r"; return 0; fi
    done
    return 1
}

# ------------------------------------------------------------------ 体检
port_listening() {
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"
    else
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -q "[:.]$1\$"
    fi
}

pid_of() { # 用命令行特征找进程（找不到返回 1）
    pgrep -f "$1" 2>/dev/null | head -n 1
}

cmd_status() {
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    host=$(conf_any cloud_host CLOUD_HOST 2>/dev/null || printf '')
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')

    say "配置      $CONF$([ -f "$CONF" ] || printf '（还没有，先照 remote.conf.example 抄一份）')"
    say "项目      $PROJ_DIR"

    if port_listening "$lp"; then
        say "harness   127.0.0.1:$lp 在跑$(pid_of "dsh.*--port $lp" >/dev/null 2>&1 && printf '' )"
    elif pid_of 'dsh .*web|dsh web' >/dev/null 2>&1; then
        say "harness   有 dsh web 进程，但 127.0.0.1:$lp 没在听（端口对不对？）"
    else
        say "harness   没在跑（dsh-remote serve 起它）"
    fi

    if [ -n "$host" ]; then
        if pid_of 'ssh .*-R .*127\.0\.0\.1' >/dev/null 2>&1; then
            say "隧道      在跑：云上 127.0.0.1:$rp → 家里 127.0.0.1:$lp"
        else
            say "隧道      没在跑（dsh-remote tunnel，或装成 systemd 单元）"
        fi
    else
        say "隧道      remote.conf 里还没写 cloud_host"
    fi

    if [ -n "$pub" ]; then
        say "手机地址   $pub"
    else
        say "手机地址   还没写 public_url（云端 Caddy 装好之后填进来）"
    fi

    if [ -f "$CONF_DIR/notify.conf" ]; then
        prov=$(sed -n 's/^[[:space:]]*provider[[:space:]]*=[[:space:]]*//p' "$CONF_DIR/notify.conf" | tail -n 1)
        say "推送       provider=${prov:-serverchan}（dsh-remote notify-test 试一下）"
    else
        say "推送       还没配（照 notify.conf.example 写 $CONF_DIR/notify.conf）"
    fi

    if [ -f "$CONF_DIR/hooks.json" ]; then
        if grep -q 'dsh-remote notify' "$DSH_HOME/profiles/web/cordis.patch.yml" 2>/dev/null; then
            say "hook 推送  已开启（问问题/跑完会推手机）"
        else
            say "hook 推送  钩子文件在，但 profile 里没挂上（dsh-remote notify-enable）"
        fi
    else
        say "hook 推送  没开（dsh-remote notify-enable）"
    fi
}

# ------------------------------------------------------------------ 起 harness
cmd_serve() {
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    urlfile="$STATE_DIR/web-url.txt"
    logfile="$STATE_DIR/web.log"
    mkdir -p -- "$STATE_DIR"

    if port_listening "$lp"; then
        warn "127.0.0.1:$lp 已经有人在听 —— 大概率 harness 正在跑。"
        warn "别在会话里重启它：正在跑的会话会被打断（历史不会丢，能 resume）。"
        [ -f "$urlfile" ] && say "上次记下来的地址：$(cat "$urlfile")"
        return 1
    fi

    command -v dsh >/dev/null 2>&1 || die "PATH 里没有 dsh"

    say "起 harness：dsh web --no-open --port $lp（日志 $logfile）"
    if command -v setsid >/dev/null 2>&1; then
        setsid nohup dsh web --no-open --port "$lp" >"$logfile" 2>&1 </dev/null &
    else
        nohup dsh web --no-open --port "$lp" >"$logfile" 2>&1 </dev/null &
    fi

    i=0
    while [ "$i" -lt 40 ]; do
        if grep -o "http://127\.0\.0\.1:$lp/[^ ]*token=[^ ]*" "$logfile" 2>/dev/null | head -n 1 >"$urlfile.tmp"; then
            if [ -s "$urlfile.tmp" ]; then
                mv -f "$urlfile.tmp" "$urlfile"
                say "地址（**手机第一次要用这个带 token 的**，登录后浏览器会记住）："
                say "  $(cat "$urlfile")"
                return 0
            fi
        fi
        sleep 0.5
        i=$((i + 1))
    done
    rm -f "$urlfile.tmp"
    warn "20 秒没等到 token URL，自己看日志：$logfile"
    return 1
}

# ------------------------------------------------------------------ 隧道
# 一条反向隧道 = 云上 127.0.0.1:<remote_port> 转发到家里 127.0.0.1:<local_port>。
# ssh 参数只写一份（tunnel_argv），三处共用：前台 tunnel / 渲染进 systemd 单元 /
# tunnel-status 的"配置漂移"对比。保活参数必须留着 —— systemd 只看得到"进程退没退"，
# 网络断了而 ssh 僵着不退时，只有 ssh 自己的 ServerAlive* 能把它踢死（ADR-0013）。
tunnel_conf() {
    host=$(conf_any cloud_host CLOUD_HOST) || die "remote.conf 里没有 cloud_host"
    ssh_user=$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')
    ssh_port=$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')
    remote_port_v=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    local_port_v=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    identity_key=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $identity_key in '~/'*) identity_key="$HOME/${identity_key#\~/}" ;; esac
    tmux_name=$(conf_any tmux_session TMUX_SESSION 2>/dev/null || printf 'dsh-tunnel')
}

tunnel_argv() { # 用法：tunnel_argv [--batch]（先调 tunnel_conf 设好上面那批全局量）
    _batch=${1:-}
    set -- -N -T
    [ "$_batch" = "--batch" ] && set -- "$@" -o BatchMode=yes
    set -- "$@" \
        -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=15 \
        -o ServerAliveCountMax=3 \
        -o TCPKeepAlive=yes \
        -o StrictHostKeyChecking=accept-new \
        -p "$ssh_port"
    [ -n "$identity_key" ] && set -- "$@" -i "$identity_key"
    set -- "$@" -R "127.0.0.1:${remote_port_v}:127.0.0.1:${local_port_v}" "${ssh_user}@${host}"
    printf '%s\n' "$@"
}

tunnel_args() { # 兼容旧调用点：先读配置，再拼参数
    tunnel_conf
    tunnel_argv
}

cmd_tunnel() {
    retry=$(conf_any retry_seconds RETRY_SECONDS 2>/dev/null || printf '10')
    autossh=
    if [ "$(conf_any autossh AUTOSSH 2>/dev/null || printf auto)" != off ] &&
        command -v autossh >/dev/null 2>&1; then
        autossh=1
    fi

    say "反向隧道：云上 127.0.0.1:$(conf_any remote_port 2>/dev/null || printf 18080) → 家里 127.0.0.1:$(conf_any local_port 2>/dev/null || printf 3080)"
    say "（云上那个端口只绑 127.0.0.1，安全组里**不要**开放它；对外只开放 Caddy 的 443/8443）"

    while :; do
        # shellcheck disable=SC2046
        if [ -n "$autossh" ]; then
            AUTOSSH_GATETIME=0 autossh -M 0 $(tunnel_args)
        else
            ssh $(tunnel_args)
        fi
        code=$?
        say "隧道断了（退出码 $code），${retry}s 后重连。Ctrl-C 退出。"
        sleep "$retry"
    done
}

# ------------------------------------------------- 常驻隧道（systemd --user 单元）
# 为什么不用 autossh：本机 / 云上都没有它（要装包，ADR-0013）。改成两件事分工：
#   * 进程退了（网络断、对端重启、ssh 自己超时退出）→ systemd 的 `Restart=always` 拉起；
#   * 网络断了但 ssh 还僵着不退 → ssh 自己的 `ServerAliveInterval × ServerAliveCountMax`
#     秒内把它踢死，退回上一条。
# 单元固定落在 ~/.config/systemd/user/dsh-tunnel.service（认 $XDG_CONFIG_HOME）。
UNIT_NAME=dsh-tunnel.service
LEGACY_UNIT_NAME=dsh-remote-tunnel.service # 旧版 `dsh-remote systemd` 写的；会抢同一个云上端口
SYSTEMCTL=${DSH_REMOTE_SYSTEMCTL:-systemctl}
TMUX_BIN=${DSH_REMOTE_TMUX:-tmux}

unit_dir() { printf '%s' "${DSH_REMOTE_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"; }
unit_file() { printf '%s/%s' "$(unit_dir)" "$UNIT_NAME"; }
legacy_unit_file() { printf '%s/%s' "$(unit_dir)" "$LEGACY_UNIT_NAME"; }

# systemctl --user 靠 $XDG_RUNTIME_DIR 找用户总线。**非登录 shell 里它可能是空的**
# （WSL / cron / 手工 sh 都会），那时报 "Failed to connect to bus"，而用户管理器其实活着。
# 空的就按 logind 的约定补一个（只在那个目录真存在时才补）。
systemctl_user() {
    if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
        export XDG_RUNTIME_DIR
    fi
    "$SYSTEMCTL" --user "$@"
}

# 探用户管理器在不在。**必须在写单元/停旧隧道之前探**：装不上就别把正在跑的弄没了。
systemd_user_ok() { systemctl_user show-environment >/dev/null 2>&1; }

linger_state() { # yes / no / 未知（老 loginctl 没有 --value，退回去自己剥前缀）
    command -v loginctl >/dev/null 2>&1 || {
        printf '未知（没有 loginctl）'
        return 0
    }
    _l=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || printf '')
    [ -n "$_l" ] || _l=$(loginctl show-user "$(id -un)" -p Linger 2>/dev/null | sed 's/^Linger=//')
    printf '%s' "${_l:-未知}"
}

# systemd 的 ExecStart 是一行；参数里有空格/引号的要引起来，`$`/`%` 会被 systemd 展开，
# 得写成 `$$`/`%%`（只对"含不安全字符"的参数做加工，IP/端口/路径都保持原样好读）。
sd_quote() {
    case $1 in
    *[!A-Za-z0-9_@+=:,./-]*)
        _q=$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/$$/g' -e 's/%/%%/g')
        printf '"%s"' "$_q"
        ;;
    *) printf '%s' "$1" ;;
    esac
}

unit_body() { # 用法：unit_body <RestartSec>；ExecStart 用 tunnel_conf 设好的全局量渲染
    _sec=$1
    tunnel_conf
    _ssh=${DSH_REMOTE_SSH:-$(command -v ssh 2>/dev/null || printf '')}
    [ -n "$_ssh" ] || die "PATH 里没有 ssh（单元里的 ExecStart 必须写绝对路径）"
    _argv=$(tunnel_argv --batch)
    _exec=$(printf '%s\n' "$_argv" | while IFS= read -r _a; do printf ' %s' "$(sd_quote "$_a")"; done)
    cat <<EOF
[Unit]
Description=DSH 反向隧道（手机远程接管家里这台机器）
Documentation=file:$PROJ_DIR/README.md
# 断了就无限重试：0 = 关掉"短时间失败太多次就判 failed"（默认 10s 内 5 次）。
# ⚠️ 这个键属于 [Unit]；写在 [Service] 里 systemd 只警告 "Unknown key name" 然后忽略
# （2026-10-07 被 systemd-analyze --user verify 抓出来，别搬回去）。
StartLimitIntervalSec=0

[Service]
Type=simple
# BatchMode：服务里没有终端，别让它停在那儿等密码/host key 提问
ExecStart=$(sd_quote "$_ssh")$_exec
Restart=always
RestartSec=$_sec
# 日志走 journald：journalctl --user -u $UNIT_NAME
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-tunnel

[Install]
WantedBy=default.target
EOF
}

tmux_has_session() {
    [ -n "${tmux_name:-}" ] || return 1
    command -v "$TMUX_BIN" >/dev/null 2>&1 || return 1
    "$TMUX_BIN" has-session -t "$tmux_name" >/dev/null 2>&1
}

cmd_tunnel_install() {
    _sec=3
    _rp=
    _lp=
    _new_user=
    _dry=0
    _no_enable=0
    _keep_tmux=0
    while [ $# -gt 0 ]; do
        case $1 in
        --restart-sec)
            _sec=${2:-}
            shift 2
            ;;
        --remote-port)
            _rp=${2:-}
            shift 2
            ;;
        --local-port)
            _lp=${2:-}
            shift 2
            ;;
        --ssh-user)
            _new_user=${2:-}
            shift 2
            ;;
        --no-enable)
            _no_enable=1
            shift
            ;;
        --keep-tmux)
            _keep_tmux=1
            shift
            ;;
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "tunnel-install 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    case $_sec in '' | *[!0-9]*) die "--restart-sec 要正整数（秒）：$_sec" ;; esac
    [ "$_sec" -ge 1 ] || die "--restart-sec 至少 1 秒"

    tunnel_conf
    [ -n "$_rp" ] && remote_port_v=$_rp
    [ -n "$_lp" ] && local_port_v=$_lp
    [ -n "$_new_user" ] && ssh_user=$_new_user
    case $remote_port_v in '' | *[!0-9]*) die "远程端口要数字：$remote_port_v" ;; esac
    case $local_port_v in '' | *[!0-9]*) die "本地端口要数字：$local_port_v" ;; esac
    _me=$(id -un)

    uf=$(unit_file)
    say "常驻隧道  云上 127.0.0.1:${remote_port_v} → 家里 127.0.0.1:${local_port_v}"
    say "登录      ${ssh_user}@${host}:${ssh_port}$([ -n "$identity_key" ] && printf '（-i %s）' "$identity_key")"
    say "单元      $uf（Restart=always，RestartSec=${_sec}s）"
    say ""

    # 0) 先探 systemd --user：必须在停掉旧隧道**之前**探，装不上就别把正在跑的弄没了
    if [ "$_dry" = 0 ] && [ "$_no_enable" = 0 ] && ! systemd_user_ok; then
        warn "systemctl --user 连不上用户管理器（systemd --user 没在跑），单元装了也起不来。"
        warn "常见原因：这台机器上你没有 logind 会话、也没开 linger。"
        warn "  loginctl enable-linger $_me    # 没登录时也跑用户服务（本机 2026-10-07 实测不需要 sudo）"
        warn "  判据：systemctl --user show-environment 退出码 0"
        die "什么都没动（旧隧道还在跑）"
    fi

    # 1) 旧的一次性 tmux 隧道：它已经占着云上**同一个**端口，必须先退场。
    #    两条隧道抢同一个远程端口时，后起的那条 ssh 会立刻退出；配上 Restart=always
    #    就是"每 RestartSec 秒重启一次"的死循环（hazards H14）。
    if tmux_has_session; then
        warn "旧 tmux 会话 $tmux_name 还在：它占着云上 127.0.0.1:${remote_port_v}。"
        warn "两条隧道抢同一个端口时，新的这条会因 ExitOnForwardFailure 秒退 → 被 systemd 无限重启。"
        if [ "$_keep_tmux" = 1 ]; then
            warn "--keep-tmux 给了：不动它 —— **你自己保证别让两条同时占 ${remote_port_v}**"
        elif [ "$_dry" = 1 ]; then
            say "（--dry-run：真跑时会执行 $TMUX_BIN kill-session -t $tmux_name）"
        elif "$TMUX_BIN" kill-session -t "$tmux_name" >/dev/null 2>&1; then
            say "已停掉旧 tmux 会话 $tmux_name（等 1 秒让云上把 ${remote_port_v} 让出来）"
            sleep 1
        else
            warn "kill-session 失败：自己跑 $TMUX_BIN kill-session -t $tmux_name"
        fi
    fi

    # 1b) 旧版单元（老 `dsh-remote systemd` 写的那个名字）同样会抢端口
    lf=$(legacy_unit_file)
    if [ -f "$lf" ]; then
        warn "发现旧版单元 $lf（旧 dsh-remote systemd 生成）—— 它和新单元抢同一个云上端口"
        if [ "$_dry" = 0 ]; then
            systemctl_user disable --now "$LEGACY_UNIT_NAME" >/dev/null 2>&1 || true
            say "已 disable --now $LEGACY_UNIT_NAME（文件留着：rm $lf）"
        fi
    fi

    # 2) 渲染 → 落盘（内容一样就不动文件，幂等；不一样先备份）
    _tmp=$(mktemp) || die "mktemp 失败"
    unit_body "$_sec" >"$_tmp" || {
        rm -f -- "$_tmp"
        die "渲染单元失败"
    }
    if [ "$_dry" = 1 ]; then
        say "== --dry-run：单元内容如下（一个字节都没写）"
        cat -- "$_tmp"
        rm -f -- "$_tmp"
        say ""
        say "真跑时会执行："
        say "  $SYSTEMCTL --user daemon-reload"
        say "  $SYSTEMCTL --user enable --now $UNIT_NAME"
        return 0
    fi
    mkdir -p -- "$(unit_dir)"
    if [ -f "$uf" ] && cmp -s -- "$_tmp" "$uf"; then
        say "单元内容没变：$uf"
        _changed=0
        rm -f -- "$_tmp"
    else
        _changed=1
        if [ -f "$uf" ]; then
            _bak="$uf.bak-$(date +%Y%m%d-%H%M%S)"
            cp -f -- "$uf" "$_bak" && say "旧单元备份成 $_bak"
        fi
        mv -f -- "$_tmp" "$uf" || die "写 $uf 失败"
        say "已写 $uf"
    fi

    if [ "$_no_enable" = 1 ]; then
        say ""
        say "--no-enable：只写了单元，没 daemon-reload / enable / start。自己来："
        say "  systemctl --user daemon-reload && systemctl --user enable --now $UNIT_NAME"
        return 0
    fi

    say ""
    say "== daemon-reload + enable --now $UNIT_NAME"
    # enable --now 对**已经在跑**的单元不会重启它 —— 所以内容变了要自己补一次 restart，
    # 否则单元文件改了、真正跑的 ssh 还是旧参数（漂移）。
    _was_active=$(systemctl_user is-active "$UNIT_NAME" 2>/dev/null || true)
    _nr_before=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
    systemctl_user daemon-reload || die "daemon-reload 失败"
    if ! systemctl_user enable --now "$UNIT_NAME"; then
        warn "enable --now 失败，看：systemctl --user status $UNIT_NAME"
        return 1
    fi
    if [ "$_changed" = 1 ] && [ "$_was_active" = active ]; then
        say "单元内容变了：restart 一次让新参数生效"
        systemctl_user restart "$UNIT_NAME" >/dev/null 2>&1 || true
    fi

    # 3) 起来之后**停 3 秒再看一遍**：Type=simple 的 active 只说明进程被 fork 出来了；
    #    认证失败 / 端口被占的 ssh 会立刻退，光看 is-active 看不出来 —— 要看 NRestarts。
    sleep 3
    _state=$(systemctl_user is-active "$UNIT_NAME" 2>/dev/null || true)
    [ -n "$_state" ] || _state=未知
    _enabled=$(systemctl_user is-enabled "$UNIT_NAME" 2>/dev/null || true)
    [ -n "$_enabled" ] || _enabled=未知
    _pid=$(systemctl_user show -p MainPID --value "$UNIT_NAME" 2>/dev/null || printf '')
    _nr=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
    _lg=$(linger_state)
    _pid_txt=${_pid:-0}
    [ "$_pid_txt" = 0 ] && _pid_txt='<MainPID>'

    say ""
    say "== 判据"
    say "服务      is-active=$_state  is-enabled=$_enabled  MainPID=${_pid:-0}  NRestarts=${_nr:-?}"
    say "日志      journalctl --user -u $UNIT_NAME -n 20 -f"
    say "本机      ss -ltn 里**不该**有 ${remote_port_v}（反向隧道不在本地听）；应该有 ${local_port_v}"
    say "云上      ssh ${ssh_user}@${host} \"ss -ltn | grep ${remote_port_v}\"   # 应看到 127.0.0.1:${remote_port_v}"
    say "公网      curl -sk https://<public_url 的 host:port>/   # 不带密码应 401（basic auth 在挡）"
    say "一键体检  dsh-remote tunnel-status --probe"
    say "断线自测  kill ${_pid_txt} → 过几秒 systemctl --user is-active $UNIT_NAME 应回 active"
    say "linger    Linger=$_lg"
    [ "$_lg" = yes ] || say "          登录会话一结束服务就停 → loginctl enable-linger $_me"

    # NRestarts 是**累计**计数器（过去失败过也留着），所以只比"这次装的前后有没有涨"
    if [ -n "$_nr" ] && [ -n "$_nr_before" ] && [ "$_nr" != "$_nr_before" ]; then
        warn ""
        warn "⚠️ 这次起来之后它已经在重启了（NRestarts $_nr_before → $_nr）："
        warn "   多半是云上 ${remote_port_v} 被别的隧道占着"
        warn "   （ExitOnForwardFailure=yes 让 ssh 秒退 → Restart=always 无限重试，hazards H14），"
        warn "   或者登录 / 密钥不对（auth 失败也是 3 秒一次地重试，不会自己停下 —— H16）。最近几行："
        systemctl_user --no-pager -l status "$UNIT_NAME" 2>&1 | tail -n 12 >&2 || true
    fi
}

cmd_tunnel_uninstall() {
    _dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --dry-run)
            _dry=1
            shift
            ;;
        *) die "tunnel-uninstall 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    uf=$(unit_file)
    lf=$(legacy_unit_file)
    say "撤销单元  $uf"
    [ -f "$lf" ] && say "          $lf（旧版生成的，一起撤）"
    if [ "$_dry" = 1 ]; then
        say "（--dry-run：会 disable --now、删单元文件、daemon-reload；一个字节都没动）"
        return 0
    fi
    if systemd_user_ok; then
        systemctl_user disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
        [ -f "$lf" ] && systemctl_user disable --now "$LEGACY_UNIT_NAME" >/dev/null 2>&1
        systemctl_user daemon-reload >/dev/null 2>&1 || true
        say "已 disable --now（服务停了、开机不再自启）"
    else
        warn "systemctl --user 连不上（用户管理器没在跑）：只删文件（服务本来也没跑）"
    fi
    rm -f -- "$uf" && say "已删 $uf"
    if [ -f "$lf" ]; then
        rm -f -- "$lf" && say "已删 $lf"
    fi
    say "想临时跑前台隧道：dsh-remote tunnel"
}

cmd_tunnel_status() {
    _probe=0
    _iface=
    while [ $# -gt 0 ]; do
        case $1 in
        --probe)
            _probe=1
            shift
            ;;
        --interface)
            _iface=${2:-}
            shift 2
            ;;
        *) die "tunnel-status 不认识的参数：$1（dsh-remote help）" ;;
        esac
    done
    _me=$(id -un)
    uf=$(unit_file)
    lf=$(legacy_unit_file)

    say "配置      $CONF$([ -f "$CONF" ] || printf '（还没有，先照 remote.conf.example 抄一份）')"
    say "单元      $uf$([ -f "$uf" ] || printf '（还没有：dsh-remote tunnel-install）')"
    if [ -f "$uf" ]; then
        # is-active / is-enabled 对 activating / disabled 是**非 0** 退出码，但照样打印状态词：
        # 别写成 `|| printf 未知`，那会把 "activating\n未知" 拼在一起（2026-10-07 踩过）。
        _state=$(systemctl_user is-active "$UNIT_NAME" 2>/dev/null || true)
        [ -n "$_state" ] || _state=未知
        _enabled=$(systemctl_user is-enabled "$UNIT_NAME" 2>/dev/null || true)
        [ -n "$_enabled" ] || _enabled=未知
        _pid=$(systemctl_user show -p MainPID --value "$UNIT_NAME" 2>/dev/null || printf '')
        _nr=$(systemctl_user show -p NRestarts --value "$UNIT_NAME" 2>/dev/null || printf '')
        _sec=$(sed -n 's/^RestartSec=//p' "$uf" | head -n 1)
        say "  状态    is-active=$_state  is-enabled=$_enabled  MainPID=${_pid:-0}  NRestarts=${_nr:-?}"
        say "  参数    Restart=always  RestartSec=${_sec:-?}"
        if conf_any cloud_host CLOUD_HOST >/dev/null 2>&1; then
            tunnel_conf
            _want=$(unit_body "${_sec:-3}" 2>/dev/null | sed -n 's/^ExecStart=//p')
            _have=$(sed -n 's/^ExecStart=//p' "$uf" | head -n 1)
            if [ "$_want" = "$_have" ]; then
                say "  一致性  单元里的 ssh 参数和现在的 remote.conf 一致 ✓"
            else
                say "  一致性  **和现在的 remote.conf 对不上了** —— 改了配置就重跑 dsh-remote tunnel-install"
                say "          单元里：$_have"
                say "          现在渲染：$_want"
            fi
        fi
    fi
    [ -f "$lf" ] && warn "旧版单元还在：$lf（会抢云上端口；dsh-remote tunnel-uninstall 会一起撤）"

    if ! conf_any cloud_host CLOUD_HOST >/dev/null 2>&1; then
        say "隧道      remote.conf 里还没写 cloud_host（照 remote.conf.example 抄一份）"
        return 0
    fi

    tunnel_conf
    say "映射      云上 127.0.0.1:${remote_port_v} → 家里 127.0.0.1:${local_port_v}（${ssh_user}@${host}:${ssh_port}）"
    _p=$(pgrep -af "ssh .*-R 127\.0\.0\.1:${remote_port_v}:" 2>/dev/null | head -n 1)
    if [ -n "$_p" ]; then
        say "进程      $_p"
    else
        say "进程      没有一条占着 ${remote_port_v} 的 ssh -R"
    fi
    if tmux_has_session; then
        warn "tmux      会话 $tmux_name 还在（占着云上 ${remote_port_v}）：$TMUX_BIN kill-session -t $tmux_name"
    else
        say "tmux      没有 $tmux_name 会话"
    fi
    if port_listening "$remote_port_v"; then
        warn "本机      ${remote_port_v} 在本地听着（**反向隧道不该在本地听**：这是别的进程）"
    else
        say "本机      ${remote_port_v} 本地没听 ✓（反向隧道正常就该这样）"
    fi
    if port_listening "$local_port_v"; then
        say "harness   127.0.0.1:${local_port_v} 在跑 ✓"
    else
        say "harness   127.0.0.1:${local_port_v} 没在听（dsh web 没跑？）"
    fi
    say "linger    Linger=$(linger_state)"
    [ "$(linger_state)" = yes ] || say "          no 的话登录会话一结束服务就停：loginctl enable-linger $_me"

    if [ "$_probe" = 1 ]; then
        say ""
        say "== --probe：上云只读看一眼（ss / curl，不改云上任何东西）"
        _opts="-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -p $ssh_port"
        [ -n "$identity_key" ] && _opts="$_opts -i $identity_key"
        # shellcheck disable=SC2086
        _out=$(ssh $_opts "${ssh_user}@${host}" \
            "ss -ltn | grep '127.0.0.1:${remote_port_v}' || echo '（云上 ${remote_port_v} 没有监听）'; curl -s -o /dev/null -w 'http_code=%{http_code}\n' --max-time 8 http://127.0.0.1:${remote_port_v}/" 2>&1)
        printf '%s\n' "$_out" | sed 's/^/  /'
        case $_out in
        *http_code=401*) say "  判据    云上在听，且请求穿到了家里的 dsh web（它自己还要 token，所以回 401 原文）✓" ;;
        *http_code=000*) warn "  判据    云上端口没通（隧道断了 / 云上没在听）" ;;
        *) say "  判据    自己看上面的 http_code（401 = 到家里了；其它码看 hazards H11）" ;;
        esac

        _pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
        if [ -n "$_pub" ]; then
            _cif=
            [ -n "$_iface" ] && _cif="--interface $_iface"
            # shellcheck disable=SC2086
            _code=$(curl -sk $_cif -o /dev/null -w '%{http_code}' --max-time 10 "$_pub" 2>/dev/null || printf '000')
            say "  公网    $_pub → HTTP $_code（不带密码应 401 = Caddy 在挡）"
        fi
    fi
}

cmd_systemd() { # 旧名字：保留，等价 tunnel-install --no-enable（以前就是"只生成不 enable"）
    say "（旧名字）dsh-remote systemd = dsh-remote tunnel-install --no-enable"
    say "  注意：单元名从 dsh-remote-tunnel.service 换成了 $UNIT_NAME（配置在 $CONF）"
    cmd_tunnel_install --no-enable "$@"
}

# ------------------------------------------------------------------ 推送
cmd_notify_test() { "$NOTIFY" --test; say "已尝试推送，看手机。失败细节：$STATE_DIR/notify.log"; }

cmd_url() {
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
    [ -n "$pub" ] || die "remote.conf 里还没有 public_url（云端 Caddy 装好之后填）"
    say "$pub"
}

# 把 profile 的 patch 文件里我们那一段换掉/删掉。
# 用标记注释围起来，这样 disable 一定是精确删除，不会误伤别人写的行。
patch_file() { printf '%s' "$DSH_HOME/profiles/web/cordis.patch.yml"; }

patch_block() {
    cat <<EOF
# >>> dsh-remote notify（这一段由 dsh-remote notify-enable 生成，notify-disable 删；别手改）
# 必须写成 - insert: 的形式。profile 的 patch 层是"按 id 覆盖已有的行 + insert 列表"，
# 光写 - id: xxx 会被当成"覆盖一个叫 xxx 的已有行"，于是 boot 时警告
#   patch: entry "hooks-claude-code" not found
# 然后什么也不发生（这个坑踩过一次，别改回去）。
- insert:
    - id: hooks-claude-code
      name: '@deepseek-ai/dsh-hooks-claude-code'
      config:
        configPath: $CONF_DIR/hooks.json
        defaultTimeoutMs: 20000
# <<< dsh-remote notify
EOF
}

patch_strip() { # 从 stdin 读，输出去掉我们那一段
    awk '
        /^# >>> dsh-remote notify/ { skip = 1; next }
        /^# <<< dsh-remote notify/ { skip = 0; next }
        !skip { print }
    '
}

cmd_notify_enable() {
    mkdir -p -- "$CONF_DIR" "$DSH_HOME/profiles/web"

    hook_src="$PROJ_DIR/hooks/claude-hooks.json"
    [ -f "$hook_src" ] || die "找不到 $hook_src"
    sed "s|__DSH_NOTIFY__|$NOTIFY|g" "$hook_src" >"$CONF_DIR/hooks.json"
    say "已写 $CONF_DIR/hooks.json（命令指向 $NOTIFY）"

    pf=$(patch_file)
    if [ ! -f "$pf" ]; then
        printf '# 你的 profile patch 层（dsh-remote 会往里加一段 hooks 桥）\n[]\n' >"$pf"
        say "已建 $pf"
    fi
    if ! grep -q '^# >>> dsh-remote notify' "$pf"; then
        cp -f -- "$pf" "$pf.bak-dsh-remote" 2>/dev/null || true
        # 空层（注释 + 一行 []）要把 [] 换成真正的列表：YAML 里两个顶层值会
        # 打架，直接追加是不行的。注释留着 —— 那可能是人自己写的说明。
        if grep -qx '\[\]' "$pf"; then
            patch_block >"$pf.block"
            awk -v blockfile="$pf.block" '
                /^\[\]$/ && !done { while ((getline line < blockfile) > 0) print line; done = 1; next }
                { print }
            ' "$pf" >"$pf.tmp"
            rm -f -- "$pf.block"
            # 理论上不会走到，但 [] 没了就退回"直接追加"，别静默丢掉钩子
            if ! grep -q 'hooks-claude-code' "$pf.tmp"; then
                { cat -- "$pf"; patch_block; } >"$pf.tmp"
            fi
        else
            { cat -- "$pf"; patch_block; } >"$pf.tmp"
        fi
        mv -f -- "$pf.tmp" "$pf"
        say "已把 hooks 桥写进 $pf（备份 $pf.bak-dsh-remote）"
    else
        say "$pf 里已经有这一段，跳过"
    fi

    say ""
    say "web profile 的 patchReload 是 live，正常情况下**不用重启**就生效。"
    say "验证：dsh --profile web --dump-config | grep -A3 hooks-claude-code"
    say "重启才生效的话：先 dsh-remote serve（会记下带 token 的新地址）。"
}

cmd_notify_disable() {
    pf=$(patch_file)
    [ -f "$pf" ] || die "没有 $pf"
    patch_strip <"$pf" >"$pf.tmp"
    # 删干净之后如果只剩注释，得补回一个 []：profile 的 patch 层是
    # "空文件或只有注释会让 boot 失败"，必须显式写 []。
    if ! sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$pf.tmp" | grep -q .; then
        printf '[]\n' >>"$pf.tmp"
    fi
    mv -f -- "$pf.tmp" "$pf"
    say "已从 $pf 里删掉 hooks 桥那一段（$CONF_DIR/hooks.json 留着，想再开就 notify-enable）"
}

# ------------------------------------------------------------------ 云端
cmd_cloud_setup() {
    host=$(conf_any cloud_host CLOUD_HOST 2>/dev/null || printf '<你的阿里云公网 IP>')
    user=$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')
    pub=$(conf_any public_url PUBLIC_URL 2>/dev/null || printf '')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    say "在阿里云那台机器上装 Caddy（在**你这台机器**上执行）："
    say ""
    say "  # 1) 把云上要用的东西传过去（就一个脚本 + 两个 Caddyfile 模板）"
    say "  scp -r $PROJ_DIR/cloud ${user}@${host}:/opt/dsh-relay"
    say ""
    say "  # 2) 登录上去跑它（中继器起成 caddy 容器；宿主上只需 docker）"
    say "  ssh ${user}@${host}"
    say "  cd /opt/dsh-relay && sudo sh relay.sh --tunnel-port $rp"
    say ""
    say "  有域名（且已备案）：加 --domain dsh.example.com    → 443 + Let's Encrypt 证书"
    say "  没域名/IP 没备案：  加 --ip <公网IP> --port 8443  → 自签证书，浏览器会提示一次"
    say "  想再收紧一层：      加 --allow-ip <你家出口IP>/32"
    say ""
    say "  脚本最后会打印：手机该收藏的 https 地址 + 随机生成的用户名/密码。"
    say "  把那个地址写进 $CONF 的 public_url，推送里就会带上它。"
    [ -n "$pub" ] && say ""
    [ -n "$pub" ] && say "现在记的是：$pub"
    say ""
    say "安全组只开放：22（你家的出口 IP）、443（有域名时）或 8443。**绝不要开 $rp 和 $lp**。"
}

# ------------------------------------------------- 云端：真装（一条命令）
# dsh-remote cloud-install --domain dsh.example.com
# dsh-remote cloud-install --ip 47.98.1.2
# 做的事：把 cloud/ 传到云上 /opt/dsh-relay → 跑 relay.sh（把 Caddy 起成
# docker 容器、渲染 Caddyfile、自检）→ 把它打印的地址写回 remote.conf 的 public_url。
cmd_cloud_install() {
    ci_domain=
    ci_ip=
    ci_email=
    ci_port=
    ci_user=
    ci_ssh_user=
    ci_allow=
    ci_dry=0
    while [ $# -gt 0 ]; do
        case $1 in
        --domain)
            ci_domain=${2:-}
            shift 2
            ;;
        --ip)
            ci_ip=${2:-}
            shift 2
            ;;
        --email)
            ci_email=${2:-}
            shift 2
            ;;
        --port)
            ci_port=${2:-}
            shift 2
            ;;
        --user)
            ci_user=${2:-}
            shift 2
            ;;
        --allow-ip)
            ci_allow="${ci_allow} ${2:-}"
            shift 2
            ;;
        --ssh-user)
            ci_ssh_user=${2:-}
            shift 2
            ;;
        --dry-run)
            ci_dry=1
            shift
            ;;
        *) die "cloud-install 不认识的参数：$1（--help）" ;;
        esac
    done

    host=$(conf_any cloud_host CLOUD_HOST) || die "remote.conf 里没有 cloud_host（先照 remote.conf.example 抄一份）"
    ssh_user=${ci_ssh_user:-$(conf_any cloud_user CLOUD_USER 2>/dev/null || printf 'root')}
    sport=$(conf_any cloud_ssh_port CLOUD_SSH_PORT 2>/dev/null || printf '22')
    rp=$(conf_any remote_port REMOTE_PORT 2>/dev/null || printf '18080')
    lp=$(conf_any local_port LOCAL_PORT 2>/dev/null || printf '3080')
    key=$(conf_any identity IDENTITY 2>/dev/null || printf '')
    case $key in '~/'*) key="$HOME/${key#\~/}" ;; esac

    # 没给 --domain / --ip 时，cloud_host 本身就是公网 IP 的话直接当 --ip 用
    if [ -z "$ci_domain" ] && [ -z "$ci_ip" ]; then
        case $host in
        *[!0-9.]* | '') die "要么 --domain dsh.example.com，要么 --ip <公网IP>" ;;
        *) ci_ip=$host ;;
        esac
    fi

    # 远端脚本的参数拼成一个字符串（它会原样传进 ssh 的那条命令里）
    rargs="--tunnel-port $rp --local-port $lp"
    [ -n "$ci_domain" ] && rargs="$rargs --domain $ci_domain"
    [ -n "$ci_ip" ] && rargs="$rargs --ip $ci_ip"
    [ -n "$ci_email" ] && rargs="$rargs --email $ci_email"
    [ -n "$ci_port" ] && rargs="$rargs --port $ci_port"
    [ -n "$ci_user" ] && rargs="$rargs --user $ci_user"
    for a in $ci_allow; do rargs="$rargs --allow-ip $a"; done

    remote_dir=/opt/dsh-relay
    remote_cmd="cd $remote_dir && if [ \"\$(id -u)\" = 0 ]; then sh relay.sh $rargs; else sudo sh relay.sh $rargs; fi"

    ssh_opts="-p $sport -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
    [ -n "$key" ] && ssh_opts="$ssh_opts -i $key"
    scp_opts="-P $sport -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR"
    [ -n "$key" ] && scp_opts="$scp_opts -i $key"

    say "云上那台：$ssh_user@$host:$sport"
    say "云上要执行的：cd $remote_dir && sudo sh relay.sh $rargs（Caddy 跑在容器里）"

    if [ "$ci_dry" = 1 ]; then
        say ""
        say "（--dry-run：只打印，不动手。真跑就去掉 --dry-run）"
        say "  scp -r $scp_opts \"$PROJ_DIR/cloud\" $ssh_user@$host:$remote_dir"
        say "  ssh -t $ssh_opts $ssh_user@$host '$remote_cmd'"
        return 0
    fi

    say ""
    say "== 1/3 传 cloud/ 上去（$remote_dir）"
    # shellcheck disable=SC2086
    if ! scp -r $scp_opts "$PROJ_DIR/cloud" "$ssh_user@$host:$remote_dir"; then
        die "scp 失败（云上 ssh 通不通？密钥对不对？$ssh_user@$host:$sport）"
    fi

    say ""
    say "== 2/3 在云上装（Caddy + basic auth + HTTPS；要 sudo 密码的话会提示）"
    out="$STATE_DIR/cloud-install.log"
    mkdir -p -- "$STATE_DIR"
    # shellcheck disable=SC2086
    if ! ssh -t $ssh_opts "$ssh_user@$host" "$remote_cmd" 2>&1 | tee "$out"; then
        warn "云上那步没成功（完整输出在 $out）"
        return 1
    fi

    say ""
    say "== 3/3 把地址记进 $CONF"
    url=$(grep -o 'https://[^ 　]*' "$out" | head -n 1)
    if [ -n "$url" ]; then
        if grep -q '^[[:space:]]*public_url[[:space:]]*=' "$CONF" 2>/dev/null; then
            sed -i "s|^[[:space:]]*public_url[[:space:]]*=.*|public_url=$url|" "$CONF"
        else
            printf 'public_url=%s\n' "$url" >>"$CONF"
        fi
        say "public_url=$url"
    else
        warn "没从输出里认出地址，自己把 relay.sh 打印的那行填进 $CONF 的 public_url"
    fi

    say ""
    say "接下来（回家这台上跑）："
    say "  dsh-remote tunnel     # 起反向隧道（或 dsh-remote systemd 装成常驻）"
    say "  dsh-remote status     # 体检"
    say "手机上打开 $url （basic auth 的用户名/密码就是上面打印的那两组）"
}

# ------------------------------------------------- 从旧的 ~/.dsh 搬过来
cmd_migrate() {
    moved=0
    mkdir -p -- "$CONF_DIR" "$STATE_DIR"
    for f in remote.conf notify.conf hooks.json; do
        if [ -f "$DSH_HOME/$f" ] && [ ! -f "$CONF_DIR/$f" ]; then
            mv -f -- "$DSH_HOME/$f" "$CONF_DIR/$f"
            say "搬走 $DSH_HOME/$f → $CONF_DIR/$f"
            moved=1
        fi
    done
    for f in notify.log web.log web-url.txt; do
        if [ -f "$DSH_HOME/$f" ] && [ ! -f "$STATE_DIR/$f" ]; then
            mv -f -- "$DSH_HOME/$f" "$STATE_DIR/$f"
            say "搬走 $DSH_HOME/$f → $STATE_DIR/$f"
            moved=1
        fi
    done
    rm -f -- "$DSH_HOME/remote.conf.example" "$DSH_HOME/notify.conf.example" 2>/dev/null || true
    if [ "$moved" = 1 ]; then
        say "配置搬到 $CONF_DIR，日志搬到 $STATE_DIR 了。"
        say "记得重跑一次 dsh-remote notify-enable，把 profile patch 里的 hooks.json 路径更新到新位置。"
    else
        say "没有要搬的（$DSH_HOME 下已经没有我们的文件）"
    fi
}


# ------------------------------------------------ 验证钩子桥（不动正在跑的那个实例）
# 背景：profile patch 里挂了 hooks-claude-code，dump-config 里也看得到那一行，
# **但这不等于插件真的加载了**（实测：configPath 指到不存在的文件都不报错；
# 正在跑的实例十几轮没触发过任何钩子）。这条命令用一次性进程做对照实验：
# 起个本地接收端 → 渲染一份临时 patch → 跑一次 headless 任务 → 看有没有收到。
cmd_check_hooks() {
    command -v dsh >/dev/null 2>&1 || die "PATH 里没有 dsh"
    command -v python3 >/dev/null 2>&1 || die "要 python3（起本地接收端）"
    [ -f "$CONF_DIR/hooks.json" ] || die "$CONF_DIR/hooks.json 不存在（先跑 dsh-remote notify-enable）"

    tmp=$(mktemp -d)
    sink="$tmp/sink.txt"
    : >"$sink"
    port=$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')
    python3 "$PROJ_DIR/tests/http_sink.py" "$port" "$sink" >/dev/null 2>&1 &
    sink_pid=$!
    sleep 1

    cat >"$tmp/notify.conf" <<EOF
provider=generic
URL=http://127.0.0.1:$port/hook
on_stop=1
EOF
    cat >"$tmp/patch.yml" <<EOF
- insert:
    - id: hooks-claude-code
      name: '@deepseek-ai/dsh-hooks-claude-code'
      config:
        configPath: $CONF_DIR/hooks.json
EOF

    say "跑一次一次性 harness（dsh --profile headless --patch …）—— 会真的调一次模型，几十秒"
    DSH_NOTIFY_CONF="$tmp/notify.conf" DSH_NOTIFY_LOG="$tmp/notify.log" \
        timeout 300 dsh --profile headless --patch "$tmp/patch.yml" "只回答一个字：好" \
        >"$tmp/out" 2>"$tmp/err" || warn "headless 退出码非 0（细节：$tmp/err）"
    sleep 1
    kill "$sink_pid" 2>/dev/null || true

    if [ -s "$sink" ]; then
        say "✅ 钩子桥**真的会触发**（收到：$(head -c 100 "$sink")）"
        rm -rf "$tmp"
        return 0
    fi
    say "❌ 钩子桥**没有触发** —— 插件没被加载（不是"加载了但事件不匹配"）"
    say "   佐证：把 configPath 指向不存在的文件，harness 也不报错、静默跳过。"
    say "   原因大概率是 profile 的 dependencies 为空 + 本机没有 pnpm，插入的那一行解析不到包。"
    say "   两条路："
    say "     A) npm i -g pnpm && dsh plugin --profile web add @deepseek-ai/dsh-hooks-claude-code"
    say "        然后重启 dsh web（**会打断正在跑的会话**），再跑一次 dsh-remote check-hooks"
    say "     B) 先不靠钩子：dsh-remote notify-test 说明推送通道是好的，需要提醒时手动 dsh-notify"
    say "   诊断文件留在 $tmp（out / err / notify.log / notify.conf）"
    return 1
}

cmd_log() {
    for f in "$STATE_DIR/notify.log" "$STATE_DIR/web.log"; do
        [ -f "$f" ] || continue
        say "=== $f"
        tail -n 20 -- "$f"
    done
}

usage() {
    # 打到头部注释块结束为止：跳过 shebang，从第 2 行起连着以 # 开头的都打，
    # 碰到第一条正文（空行也算）就停。**别改回写死的行号** —— 已经越界过一次：
    # 注释块到第 21 行，范围却写到 25，于是多打了 `set -u` 和两行无关注释（H10）。
    # （也别用 `sed -n '2,/^[^#]/p'`：空行不匹配 `^[^#]`，会多打一行。）
    awk 'NR == 1 { next } /^#/ { print; next } { exit }' "$0" | sed 's/^# \{0,1\}//'
}

case ${1:-help} in
status) cmd_status ;;
serve) cmd_serve ;;
tunnel) cmd_tunnel ;;
tunnel-install)
    shift
    cmd_tunnel_install "$@"
    ;;
tunnel-uninstall)
    shift
    cmd_tunnel_uninstall "$@"
    ;;
tunnel-status)
    shift
    cmd_tunnel_status "$@"
    ;;
systemd)
    shift
    cmd_systemd "$@"
    ;;
url) cmd_url ;;
notify-test) cmd_notify_test ;;
notify-enable) cmd_notify_enable ;;
notify-disable) cmd_notify_disable ;;
cloud-install)
    shift
    cmd_cloud_install "$@"
    ;;
cloud-setup) cmd_cloud_setup ;;
migrate) cmd_migrate ;;
check-hooks) cmd_check_hooks ;;
log) cmd_log ;;
help | --help | -h) usage ;;
*) die "不认识的命令：$1（dsh-remote help）" ;;
esac
